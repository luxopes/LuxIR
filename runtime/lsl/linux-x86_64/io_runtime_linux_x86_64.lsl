    call assembler.emit(output, x86_64.load_memory(2, 1, 8))
    call assembler.relative(output, [232], "runtime_write_all")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "appendfile_failed")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "appendfile_failed")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "appendfile_failed")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "appendfile_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "appendfile_error_data")
    message = "FileError: cannot append file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_writebytes(output):
    call assembler.label(output, "runtime_writebytes_raw")
    call assembler.emit(output, x86_64.mov_imm64(2, 1))
    call assembler.relative(output, [233], "writebytes_entry")
    call assembler.label(output, "runtime_writebytes")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "writebytes_entry")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-80, 2))
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "writebytes_failed")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "writebytes_failed")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 132], "writebytes_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 2))
    call assembler.relative(output, [15, 133], "writebytes_failed")
    call assembler.label(output, "writebytes_type_valid")
    call assembler.emit(output, x86_64.load_memory(1, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 140], "writebytes_failed")
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 1073741824))
    call assembler.relative(output, [15, 143], "writebytes_failed")
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "writebytes_list")
    call assembler.emit(output, x86_64.load_memory(0, 6, 24))
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.relative(output, [233], "writebytes_open")
    call assembler.label(output, "writebytes_list")
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 1))
    call assembler.relative(output, [232], "runtime_alloc_raw")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(8, 6, 24))
    call assembler.emit(output, x86_64.store_stack(-48, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-56, 2))
    call assembler.label(output, "writebytes_copy")
    call assembler.emit(output, x86_64.load_stack(2, -56))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "writebytes_open")
    call assembler.emit(output, x86_64.load_stack(8, -48))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 2, 3))
    call assembler.emit(output, x86_64.store_stack(-64, 7))
    call assembler.emit(output, x86_64.load_stack(0, -80))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "writebytes_list_value_raw")
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "writebytes_list_value_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 133], "writebytes_failed")
    call assembler.label(output, "writebytes_list_value_valid")
    call assembler.emit(output, x86_64.load_stack(7, -64))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.relative(output, [233], "writebytes_list_value_ready")
    call assembler.label(output, "writebytes_list_value_raw")
    call assembler.emit(output, x86_64.load_stack(0, -64))
    call assembler.label(output, "writebytes_list_value_ready")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "writebytes_failed")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 255))
    call assembler.relative(output, [15, 143], "writebytes_failed")
    call assembler.emit(output, x86_64.load_stack(10, -32))
    call assembler.emit(output, x86_64.load_stack(2, -56))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 2, 0))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-56, 2))
    call assembler.relative(output, [233], "writebytes_copy")
    call assembler.label(output, "writebytes_open")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    # Binary output remains executable for compiler artifacts, but refuses a
    # final-component symlink and never leaks its descriptor through execve.
    call assembler.emit(output, x86_64.mov_imm64(6, 655937))
    call assembler.emit(output, x86_64.mov_imm64(2, 493))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_OPEN))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "writebytes_opened")
    call assembler.relative(output, [233], "writebytes_failed")
    call assembler.label(output, "writebytes_opened")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.relative(output, [232], "runtime_write_all")
    call assembler.emit(output, x86_64.store_stack(-64, 0))
    call assembler.emit(output, x86_64.load_stack(7, -40))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-72, 0))
    call assembler.emit(output, x86_64.load_stack(0, -64))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "writebytes_failed")
    call assembler.emit(output, x86_64.load_stack(0, -72))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "writebytes_failed")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "writebytes_failed")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "writebytes_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "writebytes_error_data")
    message = "FileError: cannot write file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

# Raw file-descriptor builtins for device I/O (framebuffer, /dev/input).
# They return the raw syscall result; the stdlib fd module turns negative
# values into catchable errors, so no error String is emitted here.
function emit_fd_io(output):
    # __lsl_fd_open: rdi String payload, rsi flags -> open(path,
    # flags|O_CLOEXEC, 0666). Runtime-owned descriptors never cross execve.
    call assembler.label(output, "runtime_fd_open")
    call assembler.emit(output, x86_64.push(6))
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.pop(6))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "fd_open_invalid")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(0, 524288))
    call assembler.emit(output, x86_64.or_reg_reg(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(2, 438))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_OPEN))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "fd_open_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, -22))
    call assembler.emit(output, x86_64.ret())

    # __lsl_fd_read: rdi fd, rsi ByteArray payload, rdx max. The count is
    # clamped to the payload length so the kernel cannot write past it.
    call assembler.label(output, "runtime_fd_read")
    # Přímé FD operace musí vidět logickou pozici po posledním input().
    call assembler.relative(output, [232], "stdin_release")
    call assembler.emit(output, x86_64.move_reg_reg(9, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 15))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "fd_read_invalid")
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "fd_read_invalid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 140], "fd_read_invalid")
    call assembler.emit(output, x86_64.load_memory(1, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 142], "fd_read_size_ok")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.label(output, "fd_read_size_ok")
    call assembler.emit(output, x86_64.load_memory(6, 6, 24))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_READ))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "fd_read_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, -22))
    call assembler.emit(output, x86_64.ret())

    # __lsl_fd_write: rdi fd, rsi ByteArray payload, rdx count. Loops until
    # every byte is sent, retries EINTR, and returns EAGAIN to the caller.
    # Busy-spinning forever on a full nonblocking descriptor was a CPU DoS.
    call assembler.label(output, "runtime_fd_write")
    # Přímé FD operace musí vidět logickou pozici po posledním input().
    call assembler.relative(output, [232], "stdin_release")
    call assembler.emit(output, x86_64.move_reg_reg(9, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 15))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "fd_write_invalid")
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "fd_write_invalid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 140], "fd_write_invalid")
    call assembler.emit(output, x86_64.load_memory(1, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 142], "fd_write_size_ok")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.label(output, "fd_write_size_ok")
    call assembler.emit(output, x86_64.load_memory(6, 6, 24))
    call assembler.label(output, "fd_write_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "fd_write_done")
    call assembler.emit(output, x86_64.push(7))
    call assembler.emit(output, x86_64.push(6))
    call assembler.emit(output, x86_64.push(2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_WRITE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.pop(2))
    call assembler.emit(output, x86_64.pop(6))
    call assembler.emit(output, x86_64.pop(7))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 143], "fd_write_advance")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, -4))
    call assembler.relative(output, [15, 132], "fd_write_loop")
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "fd_write_advance")
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 0))
    call assembler.relative(output, [233], "fd_write_loop")
    call assembler.label(output, "fd_write_done")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "fd_write_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, -22))
    call assembler.emit(output, x86_64.ret())

    # __lsl_fd_seek: rdi fd, rsi offset -> lseek(fd, offset, SEEK_SET).
    call assembler.label(output, "runtime_fd_seek")
    call assembler.relative(output, [232], "stdin_release")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_LSEEK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())

    # __lsl_fd_close: rdi fd.
    call assembler.label(output, "runtime_fd_close")
    call assembler.relative(output, [232], "stdin_release")
    # Deskriptor 0 nebo 1 může být příště otevřený jako jiný druh souboru.
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 1))
    call assembler.relative(output, [15, 135], "fd_close_ready")
    call assembler.relative(output, [232], "runtime_stdio_direct")
    call assembler.label(output, "fd_close_ready")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())

    # __lsl_fd_socket: rdi domain, rsi type -> socket(domain, type, 0).
    call assembler.label(output, "runtime_fd_socket")
    call assembler.emit(output, x86_64.mov_imm64(0, 524288))
    call assembler.emit(output, x86_64.or_reg_reg(6, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_SOCKET))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())

    # __lsl_fd_connect: rdi fd, rsi ByteArray sockaddr, rdx len clamped
    # to the payload length.
    call assembler.label(output, "runtime_fd_connect")
    call assembler.emit(output, x86_64.move_reg_reg(9, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 15))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "fd_connect_invalid")
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "fd_connect_invalid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 140], "fd_connect_invalid")
    call assembler.emit(output, x86_64.load_memory(1, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 142], "fd_connect_size_ok")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.label(output, "fd_connect_size_ok")
    call assembler.emit(output, x86_64.load_memory(6, 6, 24))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CONNECT))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "fd_connect_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, -22))
    call assembler.emit(output, x86_64.ret())
end

# Raster kernels: the per-pixel work of the gfx/display stdlib (surface
# fill, surface-to-surface copy, IntArray->BGRX packing) as native loops.
# All three clamp offsets/counts to the arrays' real lengths and verify the
# heap type codes, so a bad call is a no-op instead of heap corruption.
# They allocate nothing and call nothing, so they are GC-invisible leaves.
function emit_raster(output):
    # __lsl_raster_pack: rdi IntArray src, rsi ByteArray dst, rdx src_off
    # (pixels), rcx dst_off (bytes), r8 count (pixels). Packs 0xRRGGBB Ints
    # to little-endian BGRX dwords: one 32-bit store per pixel.
    call assembler.label(output, "runtime_raster_pack")
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 13))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "raster_pack_done")
    call assembler.emit(output, x86_64.move_reg_reg(9, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 15))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "raster_pack_done")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 133], "raster_pack_done")
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "raster_pack_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.load_memory(11, 6, 8))
    call assembler.emit(output, x86_64.load_memory(6, 6, 24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 142], "raster_pack_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 140], "raster_pack_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 140], "raster_pack_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "raster_pack_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 0))
    call assembler.relative(output, [15, 142], "raster_pack_src_ok")
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.label(output, "raster_pack_src_ok")
    call assembler.emit(output, x86_64.move_reg_reg(0, 11))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 1))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "raster_pack_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 0))
    call assembler.relative(output, [15, 142], "raster_pack_dst_ok")
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.label(output, "raster_pack_dst_ok")
    call assembler.emit(output, x86_64.lea_indexed(10, 10, 2, 3))
    call assembler.emit(output, x86_64.add_reg_reg(6, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "raster_pack_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 8))
    call assembler.relative(output, [15, 141], "raster_pack_done")
    call assembler.emit(output, x86_64.load_indexed(0, 10, 9, 3))
    call assembler.emit(output, x86_64.store_dword_indexed(6, 9, 2, 0))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "raster_pack_loop")
    call assembler.label(output, "raster_pack_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # __lsl_raster_copy: rdi IntArray dst, rsi IntArray src, rdx dst_off,
    # rcx src_off, r8 count (all in elements). Forward copy: overlapping
    # ranges within one array are only safe when dst_off <= src_off.
    call assembler.label(output, "runtime_raster_copy")
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 13))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "raster_copy_done")
    call assembler.emit(output, x86_64.move_reg_reg(9, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 13))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "raster_copy_done")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 133], "raster_copy_done")
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 133], "raster_copy_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.load_memory(11, 6, 8))
    call assembler.emit(output, x86_64.load_memory(6, 6, 24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 142], "raster_copy_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 140], "raster_copy_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 140], "raster_copy_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "raster_copy_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 0))
    call assembler.relative(output, [15, 142], "raster_copy_dst_ok")
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.label(output, "raster_copy_dst_ok")
    call assembler.emit(output, x86_64.move_reg_reg(0, 11))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "raster_copy_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 0))
    call assembler.relative(output, [15, 142], "raster_copy_src_ok")
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.label(output, "raster_copy_src_ok")
    call assembler.emit(output, x86_64.lea_indexed(10, 10, 2, 3))
    call assembler.emit(output, x86_64.lea_indexed(6, 6, 1, 3))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "raster_copy_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 8))
    call assembler.relative(output, [15, 141], "raster_copy_done")
    call assembler.emit(output, x86_64.load_indexed(0, 6, 9, 3))
    call assembler.emit(output, x86_64.store_indexed(10, 9, 3, 0))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "raster_copy_loop")
    call assembler.label(output, "raster_copy_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # __lsl_raster_fill: rdi IntArray, rsi offset, rdx count, rcx value.
    call assembler.label(output, "runtime_raster_fill")
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 13))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "raster_fill_done")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 133], "raster_fill_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "raster_fill_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "raster_fill_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 6))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "raster_fill_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 0))
    call assembler.relative(output, [15, 142], "raster_fill_count_ok")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.label(output, "raster_fill_count_ok")
    call assembler.emit(output, x86_64.lea_indexed(10, 10, 6, 3))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "raster_fill_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 2))
    call assembler.relative(output, [15, 141], "raster_fill_done")
    call assembler.emit(output, x86_64.store_indexed(10, 9, 3, 1))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "raster_fill_loop")
    call assembler.label(output, "raster_fill_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
end

# GPU/display plumbing: ioctl for DRM/KMS control, mmap for dumb-buffer
# access, and a pack-to-raw-memory kernel so a frame can be written straight
# into mapped video memory without an intermediate ByteArray + write().
function emit_gpu(output):
    # __lsl_fd_ioctl: rdi fd, rsi ByteArray payload, rdx request ->
    # ioctl(fd, request, payload_data). An empty payload passes NULL.
    call assembler.label(output, "runtime_fd_ioctl")
    call assembler.emit(output, x86_64.move_reg_reg(9, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 15))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "fd_ioctl_bad")
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "fd_ioctl_bad")
    call assembler.emit(output, x86_64.load_memory(9, 6, 8))
    call assembler.emit(output, x86_64.load_memory(10, 6, 24))
    call assembler.emit(output, x86_64.move_reg_reg(6, 2))
    call assembler.emit(output, x86_64.move_reg_reg(2, 10))
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 143], "fd_ioctl_go")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "fd_ioctl_go")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_IOCTL))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "fd_ioctl_bad")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.emit(output, x86_64.ret())

    # __lsl_data_address: rdi ByteArray -> address of its payload bytes.
    # Device ioctls that take pointers to caller buffers (DRM resource
    # arrays) need the real data address, not the object address: the
    # payload lives behind the pointer at offset 24, not inline.
    call assembler.label(output, "runtime_data_address")
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 15))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "data_address_bad")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "data_address_bad")
    call assembler.emit(output, x86_64.load_memory(0, 7, 24))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "data_address_bad")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # __lsl_fd_mmap: rdi fd, rsi length, rdx offset ->
    # mmap(NULL, length, PROT_READ|PROT_WRITE, MAP_SHARED, fd, offset).
    # Returns the address, or a negative errno.
    call assembler.label(output, "runtime_fd_mmap")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 142], "fd_mmap_invalid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 140], "fd_mmap_invalid")
    call assembler.emit(output, x86_64.move_reg_reg(8, 7))
    call assembler.emit(output, x86_64.move_reg_reg(9, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.emit(output, x86_64.mov_imm64(10, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MMAP))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "fd_mmap_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, -22))
    call assembler.emit(output, x86_64.ret())

    # __lsl_fd_snapshot(fd, offset, count): copy a bounded file range into a
    # fresh anonymous mapping and return its stable address. pread(2) turns a
    # maliciously truncated shared-memory file into an error instead of the
    # SIGBUS that direct access through a file mapping would cause.
    call assembler.label(output, "runtime_fd_snapshot")
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "fd_snapshot_invalid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "fd_snapshot_invalid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "fd_snapshot_invalid")
    call assembler.emit(output, x86_64.cmp_reg_imm32(2, 67108864))
    call assembler.relative(output, [15, 143], "fd_snapshot_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, 1099511627776))
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 0))
    call assembler.relative(output, [15, 143], "fd_snapshot_invalid")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.move_reg_reg(6, 2))
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.emit(output, x86_64.mov_imm64(10, platform.MAP_PRIVATE + platform.MAP_ANONYMOUS))
    call assembler.emit(output, x86_64.mov_imm64(8, -1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MMAP))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "fd_snapshot_return")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-40, 1))
    call assembler.label(output, "fd_snapshot_read")
    call assembler.emit(output, x86_64.load_stack(1, -40))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "fd_snapshot_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.emit(output, x86_64.add_reg_reg(6, 1))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 1))
    call assembler.emit(output, x86_64.load_stack(10, -16))
    call assembler.emit(output, x86_64.add_reg_reg(10, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_PREAD64))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 143], "fd_snapshot_advance")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, -4))
    call assembler.relative(output, [15, 132], "fd_snapshot_read")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "fd_snapshot_unmap")
    call assembler.emit(output, x86_64.mov_imm64(0, -5))
    call assembler.relative(output, [233], "fd_snapshot_unmap")
    call assembler.label(output, "fd_snapshot_advance")
    call assembler.emit(output, x86_64.load_stack(1, -40))
    call assembler.emit(output, x86_64.add_reg_reg(1, 0))
    call assembler.emit(output, x86_64.store_stack(-40, 1))
    call assembler.relative(output, [233], "fd_snapshot_read")
    call assembler.label(output, "fd_snapshot_done")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "fd_snapshot_unmap")
    call assembler.emit(output, x86_64.store_stack(-48, 0))
    call assembler.emit(output, x86_64.load_stack(7, -32))
    call assembler.emit(output, x86_64.load_stack(6, -24))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MUNMAP))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(0, -48))
    call assembler.label(output, "fd_snapshot_return")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "fd_snapshot_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, -22))
    call assembler.emit(output, x86_64.ret())

    # __lsl_syscall: rdi nr, rsi a, rdx b, rcx c, r8 d -> raw syscall
    # result (negative errno on failure). The one general kernel door the
    # Wayland server needs: sockets with SCM_RIGHTS fd passing, memfd,
    # ftruncate - msghdr/iovec structures are built in LSL ByteArrays and
    # passed by data address.
    call assembler.label(output, "runtime_syscall")
    call assembler.relative(output, [232], "runtime_stdio_direct")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.move_reg_reg(7, 6))
    call assembler.emit(output, x86_64.move_reg_reg(6, 2))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.move_reg_reg(10, 8))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())

    # __lsl_syscall6: rdi nr, rsi a, rdx b, rcx c, r8 d, r9 e,
    # stack[0] f -> raw six-argument Linux syscall. This is kept separate from
    # the historical four-argument door so existing generated code and its ABI
    # remain bit-for-bit stable unless a source explicitly needs arg5/arg6.
    call assembler.label(output, "runtime_syscall6")
    call assembler.relative(output, [232], "runtime_stdio_direct")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.move_reg_reg(7, 6))
    call assembler.emit(output, x86_64.move_reg_reg(6, 2))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.move_reg_reg(10, 8))
    call assembler.emit(output, x86_64.move_reg_reg(8, 9))
    call assembler.emit(output, x86_64.load_memory(9, 4, 8))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())

    # __lsl_mem_unpack: rdi IntArray dst, rsi dst_off (elements),
    # rdx raw source address, rcx count. Reads BGRX dwords out of mapped
    # memory (a client's shared buffer) into pixel words, the exact
    # inverse of mem_pack. Bounds-checks the destination array.
    call assembler.label(output, "runtime_mem_unpack")
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 13))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "mem_unpack_done")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 133], "mem_unpack_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "mem_unpack_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 142], "mem_unpack_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 132], "mem_unpack_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 6))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "mem_unpack_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 0))
    call assembler.relative(output, [15, 142], "mem_unpack_count_ok")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.label(output, "mem_unpack_count_ok")
    call assembler.emit(output, x86_64.lea_indexed(10, 10, 6, 3))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "mem_unpack_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 1))
    call assembler.relative(output, [15, 141], "mem_unpack_done")
    call assembler.emit(output, x86_64.load_dword_indexed(0, 2, 9, 2))
    call assembler.emit(output, x86_64.store_indexed(10, 9, 3, 0))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "mem_unpack_loop")
    call assembler.label(output, "mem_unpack_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # __lsl_text_byte: rdi String, rsi index -> rax byte value, or -1 when
    # out of range. The allocation-free character probe string scanning
    # needs: indexing a String otherwise materialises a one-character
    # String per position.
    call assembler.label(output, "runtime_text_byte")
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 1))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "text_byte_bad")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 133], "text_byte_bad")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "text_byte_bad")
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 9))
    call assembler.relative(output, [15, 141], "text_byte_bad")
    call assembler.emit(output, x86_64.lea_base(10, 7, 16))
    call assembler.emit(output, x86_64.load_byte_indexed(0, 10, 6))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "text_byte_bad")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(0, 0 - 1))
    call assembler.emit(output, x86_64.ret())

    # __lsl_byte_copy: rdi ByteArray dst, rsi ByteArray src, rdx dst_off,
    # rcx src_off, r8 count (bytes). Forward native copy with the same
    # clamp discipline as raster_copy; both ends are tag-checked. The
    # byte-at-a-time append staging in fd.read_all sat on every /proc
    # read at ~700 ns per byte.
    call assembler.label(output, "runtime_byte_copy")
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 15))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "byte_copy_done")
    call assembler.emit(output, x86_64.move_reg_reg(9, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 15))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "byte_copy_done")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "byte_copy_done")
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "byte_copy_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.load_memory(11, 6, 8))
    call assembler.emit(output, x86_64.load_memory(6, 6, 24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 142], "byte_copy_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 140], "byte_copy_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 140], "byte_copy_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "byte_copy_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 0))
    call assembler.relative(output, [15, 142], "byte_copy_dst_ok")
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.label(output, "byte_copy_dst_ok")
    call assembler.emit(output, x86_64.move_reg_reg(0, 11))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "byte_copy_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 0))
    call assembler.relative(output, [15, 142], "byte_copy_src_ok")
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.label(output, "byte_copy_src_ok")
    call assembler.emit(output, x86_64.add_reg_reg(10, 2))
    call assembler.emit(output, x86_64.add_reg_reg(6, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "byte_copy_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 8))
    call assembler.relative(output, [15, 141], "byte_copy_done")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 6, 9))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 9, 0))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "byte_copy_loop")
    call assembler.label(output, "byte_copy_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # __lsl_text_from_bytes: rdi ByteArray, rsi start, rdx count -> String
    # built in one allocation and one byte copy. chr()-per-byte plus join
    # made reading a few kilobytes of /proc cost hundreds of milliseconds;
    # this is the linear-time path fd.read_text sits on. Out-of-range
    # inputs clamp; a non-ByteArray argument yields "".
    call assembler.label(output, "runtime_text_from_bytes")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 15))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "text_from_bytes_empty")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "text_from_bytes_empty")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "text_from_bytes_empty")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "text_from_bytes_empty")
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 6))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "text_from_bytes_empty")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 0))
    call assembler.relative(output, [15, 142], "text_from_bytes_count_ok")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.label(output, "text_from_bytes_count_ok")
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.add_reg_reg(10, 6))
    call assembler.emit(output, x86_64.store_stack(-8, 10))
    call assembler.emit(output, x86_64.store_stack(-16, 2))
    call assembler.emit(output, x86_64.lea_base(7, 2, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.load_stack(10, -8))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.store_memory(0, 8, 2))
    call assembler.emit(output, x86_64.lea_base(11, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "text_from_bytes_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 2))
    call assembler.relative(output, [15, 141], "text_from_bytes_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 10, 9))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 9, 8))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "text_from_bytes_loop")
    call assembler.label(output, "text_from_bytes_done")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 2, 8))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "text_from_bytes_empty")
    call assembler.emit(output, x86_64.mov_imm64(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.store_memory(0, 8, 9))
    call assembler.emit(output, x86_64.lea_base(11, 0, 16))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 9, 9))
    call assembler.emit(output, x86_64.function_epilogue())

    # __lsl_mem_pack: rdi raw destination address, rsi IntArray src,
    # rdx src_off (pixels), rcx dst_byte_off, r8 count (pixels). Same
    # 0xRRGGBB -> BGRX dword stores as raster_pack, but the destination is
    # mapped memory (a DRM dumb buffer). Bounds-checks the source array;
    # the caller owns the mapping bounds.
    call assembler.label(output, "runtime_mem_pack")
    call assembler.emit(output, x86_64.move_reg_reg(9, 6))
    call assembler.emit(output, x86_64.mov_imm64(10, 13))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "mem_pack_done")
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 133], "mem_pack_done")
    call assembler.emit(output, x86_64.load_memory(9, 6, 8))
    call assembler.emit(output, x86_64.load_memory(10, 6, 24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 142], "mem_pack_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 142], "mem_pack_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 140], "mem_pack_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 140], "mem_pack_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "mem_pack_done")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 0))
    call assembler.relative(output, [15, 142], "mem_pack_count_ok")
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.label(output, "mem_pack_count_ok")
    call assembler.emit(output, x86_64.lea_indexed(10, 10, 2, 3))
    call assembler.emit(output, x86_64.add_reg_reg(7, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "mem_pack_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 8))
    call assembler.relative(output, [15, 141], "mem_pack_done")
    call assembler.emit(output, x86_64.load_indexed(0, 10, 9, 3))
    call assembler.emit(output, x86_64.store_dword_indexed(7, 9, 2, 0))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "mem_pack_loop")
    call assembler.label(output, "mem_pack_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_paths(output):
    call assembler.label(output, "runtime_mkdir")
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "path_operation_invalid")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 493))
    call assembler.relative(output, [233], "mkdir_call")
    call assembler.label(output, "runtime_mkdir_private")
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "path_operation_invalid")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 448))
    call assembler.label(output, "mkdir_call")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MKDIR))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_unlink")
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "path_operation_invalid")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_UNLINK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "runtime_rmdir")
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "path_operation_invalid")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_RMDIR))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "path_operation_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, -22))
    call assembler.emit(output, x86_64.ret())
end

function emit_exists(output):
    call assembler.label(output, "runtime_exists")
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "exists_invalid")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_ACCESS))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.emit(output, x86_64.set_condition(148))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "exists_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_terminal_state(output):
    call assembler.label(output, "runtime_stdin_eof")
    call assembler.emit(output, x86_64.load_memory(0, 3, 88))
    call assembler.emit(output, x86_64.ret())

    call assembler.label(output, "runtime_isatty")
    call assembler.emit(output, x86_64.function_prologue(64))
    # ioctl(fd, TCGETS, &termios): success identifies a terminal without libc.
    call assembler.emit(output, x86_64.mov_imm64(6, 21505))
    call assembler.emit(output, x86_64.lea_base(2, 5, -64))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_IOCTL))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.emit(output, x86_64.set_condition(157))
    call assembler.emit(output, x86_64.function_epilogue())
end

# Barvy se vyhodnocují až na nezachycené chybové cestě, bez alokací a GC.
function emit_error_output(output):
    call assembler.label(output, "runtime_error_color")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.load_memory(9, 3, 120))
    call assembler.emit(output, x86_64.load_memory(8, 9, 0))
    call assembler.emit(output, x86_64.lea_indexed(9, 9, 8, 3))
    call assembler.emit(output, x86_64.add_reg_imm8(9, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.label(output, "error_color_environment")
    call assembler.emit(output, x86_64.load_memory(10, 9, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 0))
    call assembler.relative(output, [15, 132], "error_color_policy")
    for setting in ["NO_COLOR=", "FORCE_COLOR=", "TERM=dumb" + chr(0)]:
        next_setting = "error_color_next_" + String(len(setting))
        for index in rang(len(setting)):
            call assembler.emit(output, x86_64.load_byte_zero_extend(0, 10, index))
            call assembler.emit(output, x86_64.cmp_reg_imm32(0, ord(setting[index])))
            call assembler.relative(output, [15, 133], next_setting)
        end
        if setting == "NO_COLOR=":
            call assembler.relative(output, [233], "error_color_off")
        elif setting == "FORCE_COLOR=":
            call assembler.emit(output, x86_64.load_byte_zero_extend(0, 10, len(setting)))
            call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
            call assembler.relative(output, [15, 132], "error_color_next_entry")
            call assembler.emit(output, x86_64.cmp_reg_imm8(0, 48))
            call assembler.relative(output, [15, 133], "error_color_force")
            call assembler.emit(output, x86_64.load_byte_zero_extend(0, 10, len(setting) + 1))
            call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
            call assembler.relative(output, [15, 132], "error_color_off")
            call assembler.label(output, "error_color_force")
            call assembler.emit(output, x86_64.mov_imm64(0, 1))
            call assembler.emit(output, x86_64.or_reg_reg(8, 0))
        else:
            call assembler.emit(output, x86_64.mov_imm64(0, 2))
            call assembler.emit(output, x86_64.or_reg_reg(8, 0))
        end
        call assembler.relative(output, [233], "error_color_next_entry")
        call assembler.label(output, next_setting)
    end
    call assembler.label(output, "error_color_next_entry")
    call assembler.emit(output, x86_64.add_reg_imm8(9, 8))
    call assembler.relative(output, [233], "error_color_environment")
    call assembler.label(output, "error_color_policy")
    call assembler.emit(output, x86_64.move_reg_reg(0, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, 1))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "error_color_return")
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 133], "error_color_off")
    call assembler.emit(output, x86_64.mov_imm64(7, 2))
    call assembler.relative(output, [232], "runtime_isatty")
    call assembler.relative(output, [233], "error_color_return")
    call assembler.label(output, "error_color_off")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.label(output, "error_color_return")
    call assembler.emit(output, x86_64.function_epilogue())

    call emit_uncaught_report(output)
end

function emit_error_literal(output, label, message):
    call assembler.relative(output, x86_64.lea_rip_prefix(6), label)
    call assembler.emit(output, x86_64.mov_imm64(2, len(bytes.utf8(message))))
    call assembler.emit(output, x86_64.mov_imm64(7, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_WRITE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.relative(output, [233], label + "_end")
    call assembler.label(output, label)
    call assembler.emit(output, bytes.utf8(message))
    call assembler.label(output, label + "_end")
end

# Native String helpers behind __lsl_text_piece,
# __lsl_text_scan_digits, __lsl_text_digits and __lsl_text_split_byte.
# Emitted only when the program (through the dynamic stdlib) calls one.
function emit_text_helpers(output):
    # __lsl_text_piece: rdi String, rsi byte start, rdx byte count -> a new
    # String holding those bytes (clamped to the source; empty when the
    # range is out of bounds or the receiver is not a String). One native
    # copy replaces the byte-at-a-time staging that made split() the
    # slowest step of line-oriented programs.
    call assembler.label(output, "runtime_text_piece")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 1))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "text_piece_empty")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 133], "text_piece_empty")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "text_piece_empty")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "text_piece_empty")
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(0, 6))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "text_piece_empty")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 0))
    call assembler.relative(output, [15, 142], "text_piece_count_ok")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.label(output, "text_piece_count_ok")
    call assembler.emit(output, x86_64.lea_base(10, 7, 16))
    call assembler.emit(output, x86_64.add_reg_reg(10, 6))
    call assembler.emit(output, x86_64.store_stack(-8, 10))
    call assembler.emit(output, x86_64.store_stack(-16, 2))
    call assembler.emit(output, x86_64.lea_base(7, 2, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.load_stack(10, -8))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.store_memory(0, 8, 2))
    call assembler.emit(output, x86_64.lea_base(11, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "text_piece_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 2))
    call assembler.relative(output, [15, 141], "text_piece_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 10, 9))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 9, 8))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "text_piece_loop")
    call assembler.label(output, "text_piece_done")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 2, 8))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "text_piece_empty")
    call assembler.emit(output, x86_64.mov_imm64(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.store_memory(0, 8, 9))
    call assembler.emit(output, x86_64.lea_base(11, 0, 16))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 9, 9))
    call assembler.emit(output, x86_64.function_epilogue())

    # __lsl_text_scan_digits: rdi String, rsi byte start -> the first index
    # >= start whose byte is not an ASCII digit (the byte length when every
    # remaining byte is a digit), or -1 when rdi is not a String or start is
    # out of range. One call validates a whole number for Int(String).
    call assembler.label(output, "runtime_text_scan_digits")
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 1))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "text_scan_digits_invalid")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 133], "text_scan_digits_invalid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "text_scan_digits_invalid")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 9))
    call assembler.relative(output, [15, 143], "text_scan_digits_invalid")
    call assembler.emit(output, x86_64.lea_base(10, 7, 16))
    call assembler.label(output, "text_scan_digits_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 9))
    call assembler.relative(output, [15, 141], "text_scan_digits_stop")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 10, 6))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 48))
    call assembler.relative(output, [15, 140], "text_scan_digits_stop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 57))
    call assembler.relative(output, [15, 143], "text_scan_digits_stop")
    call assembler.emit(output, x86_64.increment(6))
    call assembler.relative(output, [233], "text_scan_digits_loop")
    call assembler.label(output, "text_scan_digits_stop")
    call assembler.emit(output, x86_64.move_reg_reg(0, 6))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "text_scan_digits_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, 0 - 1))
    call assembler.emit(output, x86_64.ret())

    # __lsl_text_digits: rdi String, rsi byte start, rdx byte stop -> the
    # decimal value of the digit bytes in [start, stop), accumulated with
    # the same wrapping value * 10 + digit arithmetic the LSL parser used.
    # The caller validates the range with runtime_text_scan_digits first;
    # anything out of range yields 0.
    call assembler.label(output, "runtime_text_digits")
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 1))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "text_digits_zero")
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 133], "text_digits_zero")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "text_digits_zero")
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 9))
    call assembler.relative(output, [15, 143], "text_digits_zero")
    call assembler.emit(output, x86_64.lea_base(10, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.mov_imm64(9, 10))
    call assembler.label(output, "text_digits_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 2))
    call assembler.relative(output, [15, 141], "text_digits_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 10, 6))
    call assembler.emit(output, x86_64.sub_reg_imm(8, 48))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 9))
    call assembler.emit(output, x86_64.add_reg_reg(0, 8))
    call assembler.emit(output, x86_64.increment(6))
    call assembler.relative(output, [233], "text_digits_loop")
    call assembler.label(output, "text_digits_done")
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "text_digits_zero")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # __lsl_text_split_byte: rdi String, rsi separator byte -> a List of the
    # byte pieces between separators (the whole String when the separator
    # is absent, an empty List when rdi is not a String). Native split for
    # the common one-byte separator: no per-byte calls, one allocation per
    # piece. Pointers live in the frame, so a collection inside an
    # allocation still sees them as roots.
    call assembler.label(output, "runtime_text_split_byte")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.mov_imm64(7, 0))
    call assembler.emit(output, x86_64.mov_imm64(6, 0))
    call assembler.relative(output, [232], "runtime_list_new")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.move_reg_reg(9, 7))
    call assembler.emit(output, x86_64.mov_imm64(10, 1))
    call assembler.relative(output, [232], "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "text_split_byte_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 133], "text_split_byte_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.label(output, "text_split_byte_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 8))
    call assembler.emit(output, x86_64.load_stack(2, -40))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 9))
    call assembler.relative(output, [15, 141], "text_split_byte_tail")
    call assembler.emit(output, x86_64.lea_base(10, 7, 16))
    call assembler.emit(output, x86_64.load_byte_indexed(8, 10, 2))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 1))
    call assembler.relative(output, [15, 133], "text_split_byte_next")
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 6))
    call assembler.relative(output, [232], "runtime_text_piece")
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.relative(output, [232], "runtime_list_append")
    call assembler.emit(output, x86_64.load_stack(2, -40))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.label(output, "text_split_byte_next")
    call assembler.emit(output, x86_64.load_stack(2, -40))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-40, 2))
    call assembler.relative(output, [233], "text_split_byte_loop")
    call assembler.label(output, "text_split_byte_tail")
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.emit(output, x86_64.move_reg_reg(2, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 6))
    call assembler.relative(output, [232], "runtime_text_piece")
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.relative(output, [232], "runtime_list_append")
    call assembler.label(output, "text_split_byte_done")
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())

end

# Runtime parts emitted after the program, when it needs them: the String
# helpers above, and input() with its buffered stdin. A program without
# input() gets a stub stdin_release that only flushes stdout, so the exit
# and fork sites stay identical.
function emit_lazy(output, text_used, input_used):
    if text_used:
        call emit_text_helpers(output)
    end
    if input_used:
        call emit_input(output)
        call emit_stdin_buffer(output)
    else:
        call assembler.label(output, "stdin_release")
        call assembler.relative(output, [232], "runtime_stdout_flush")
        call assembler.emit(output, x86_64.ret())
    end
end

function emit_all(output):
    call emit_heap_type_validation(output)
    call emit_path_validation(output)
    call emit_string_validation(output)
    call emit_cstring(output)
    call emit_stdout_buffer(output)
    call emit_readfile(output)
    call emit_readbytes(output)
    call emit_write_all(output)
    call emit_writefile(output)
    call emit_appendfile(output)
    call emit_writebytes(output)
    call emit_fd_io(output)
    call emit_gpu(output)
    call emit_raster(output)
    call emit_paths(output)
    call emit_exists(output)
    call emit_terminal_state(output)
    call emit_error_output(output)
end

# Nezachycená chyba ve formátu diagnostiky LSL, celá v nativním runtime:
#   error[Druh]: zpráva / --> cesta:řádek:sloupec / zdrojový řádek se šipkou
#   / help. Nic se nealokuje a program kvůli tomu nepřekládá žádné LSL
#   funkce navíc. Zdrojový řádek se čte jen ze souborů .lsl (chyba může
#   ukazovat do .env s tajnými hodnotami).
UE_COLOR = -8
UE_PTR = -16
UE_LEN = -24
UE_KIND = -32
UE_TSTART = -40
UE_TEND = -48
UE_PSTART = -56
UE_PEND = -64
UE_LSTART = -72
UE_LEND = -80
UE_COL = -88
UE_LINE = -96
UE_FD = -104
UE_CUR = -112
UE_LLEN = -120
UE_I = -128
UE_J = -136
UE_TMP = -144
UE_PATH = -4400
UE_READ = -8600
UE_LINEBUF = -12800
UE_FRAME = 12816
UE_LABELS = IntArray()
UE_LABELS.append(0)

function ue_label(prefix):
    UE_LABELS[0] += 1
    return "ue_" + prefix + "_" + String(UE_LABELS[0])
end

function ue_load(output, register, slot):
    call assembler.emit(output, x86_64.load_stack(register, slot))
end

function ue_store(output, slot, register):
    call assembler.emit(output, x86_64.store_stack(slot, register))
end

function ue_set(output, slot, value):
    call assembler.emit(output, x86_64.mov_imm64(0, value))
    call assembler.emit(output, x86_64.store_stack(slot, 0))
end

function ue_text(output, text):
    call emit_error_literal(output, ue_label("text"), text)
end

function ue_data(output, label, text):
    call assembler.relative(output, [233], label + "_end")
    call assembler.label(output, label)
    call assembler.emit(output, bytes.utf8(text))
    call assembler.label(output, label + "_end")
end

# Zapíše bajty zprávy [slot_start, slot_end).
function ue_range(output, start_slot, end_slot):
    call ue_load(output, 6, UE_PTR)
    call ue_load(output, 0, start_slot)
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call ue_load(output, 2, end_slot)
    call assembler.emit(output, x86_64.sub_reg_reg(2, 0))
    call assembler.relative(output, [232], "ue_write")
end

# r10 = bajt na [base + index]; skok na fail, když není číslice.
function ue_digit_or(output, base, index, fail):
    call assembler.emit(output, x86_64.load_byte_indexed(10, base, index))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 48))
    call assembler.relative(output, [15, 140], fail)
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 57))
    call assembler.relative(output, [15, 143], fail)
end

function emit_uncaught_report(output):
    call assembler.label(output, "runtime_uncaught_error")
    call assembler.relative(output, [232], "runtime_stdout_flush")
    call assembler.emit(output, x86_64.function_prologue(UE_FRAME))
    call assembler.relative(output, [232], "runtime_error_color")
    call ue_store(output, UE_COLOR, 0)
    call assembler.emit(output, x86_64.load_fs(0, abi_x86_64.TLS_ERROR))
    call assembler.emit(output, x86_64.load_memory(2, 0, 8))
    call ue_store(output, UE_LEN, 2)
    call assembler.emit(output, x86_64.lea_base(0, 0, 16))
    call ue_store(output, UE_PTR, 0)

    # Druh chyby: text před první ": ", pokud před ním není mezera.
    call ue_set(output, UE_KIND, -1)
    call ue_load(output, 6, UE_PTR)
    call ue_load(output, 2, UE_LEN)
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.label(output, "ue_kind_loop")
    call assembler.emit(output, x86_64.lea_base(9, 8, 1))
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 2))
    call assembler.relative(output, [15, 141], "ue_kind_done")
    call assembler.emit(output, x86_64.load_byte_indexed(10, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 32))
    call assembler.relative(output, [15, 132], "ue_kind_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 58))
    call assembler.relative(output, [15, 133], "ue_kind_next")
    call assembler.emit(output, x86_64.load_byte_indexed(10, 6, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 32))
    call assembler.relative(output, [15, 133], "ue_kind_next")
    call ue_store(output, UE_KIND, 8)
    call assembler.relative(output, [233], "ue_kind_done")
    call assembler.label(output, "ue_kind_next")
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "ue_kind_loop")
    call assembler.label(output, "ue_kind_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call ue_load(output, 1, UE_KIND)
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 142], "ue_text_start")
    call assembler.emit(output, x86_64.lea_base(0, 1, 2))
    call assembler.label(output, "ue_text_start")
    call ue_store(output, UE_TSTART, 0)
    call ue_load(output, 0, UE_LEN)
    call ue_store(output, UE_TEND, 0)
    call ue_set(output, UE_PSTART, -1)
    call ue_set(output, UE_COL, 0)

    # Pozice: poslední " at CESTA:ŘÁDEK[:SLOUPEC]" na konci zprávy.
    call ue_load(output, 6, UE_PTR)
    call ue_load(output, 2, UE_LEN)
    call assembler.emit(output, x86_64.move_reg_reg(8, 2))
    call assembler.emit(output, x86_64.add_reg_imm8(8, -4))
    call assembler.label(output, "ue_at_loop")
    call ue_load(output, 0, UE_TSTART)
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 0))
    call assembler.relative(output, [15, 140], "ue_loc_done")
    call assembler.emit(output, x86_64.lea_indexed(11, 6, 8, 0))
    for item in [[0, 32], [1, 97], [2, 116], [3, 32]]:
        call assembler.emit(output, x86_64.load_byte_zero_extend(10, 11, item[0]))
        call assembler.emit(output, x86_64.cmp_reg_imm8(10, item[1]))
        call assembler.relative(output, [15, 133], "ue_at_next")
    end
    call assembler.relative(output, [233], "ue_at_found")
    call assembler.label(output, "ue_at_next")
    call assembler.emit(output, x86_64.decrement(8))
    call assembler.relative(output, [233], "ue_at_loop")
    call assembler.label(output, "ue_at_found")
    call ue_store(output, UE_I, 8)
    call assembler.emit(output, x86_64.lea_base(11, 8, 4))
    call assembler.emit(output, x86_64.lea_base(9, 2, -1))
    call assembler.label(output, "ue_last_digits")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 11))
    call assembler.relative(output, [15, 142], "ue_last_end")
    call ue_digit_or(output, 6, 9, "ue_last_end")
    call assembler.emit(output, x86_64.decrement(9))
    call assembler.relative(output, [233], "ue_last_digits")
    call assembler.label(output, "ue_last_end")
    call assembler.emit(output, x86_64.lea_base(0, 9, 1))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 2))
    call assembler.relative(output, [15, 141], "ue_loc_done")
    call assembler.emit(output, x86_64.load_byte_indexed(10, 6, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 58))
    call assembler.relative(output, [15, 133], "ue_loc_done")
    call ue_store(output, UE_J, 9)
    call assembler.emit(output, x86_64.lea_base(1, 9, -1))
    call assembler.label(output, "ue_mid_digits")
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 11))
    call assembler.relative(output, [15, 142], "ue_mid_end")
    call ue_digit_or(output, 6, 1, "ue_mid_end")
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.relative(output, [233], "ue_mid_digits")
    call assembler.label(output, "ue_mid_end")
    call assembler.emit(output, x86_64.lea_base(0, 9, -1))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 0))
    call assembler.relative(output, [15, 141], "ue_one_number")
    call assembler.emit(output, x86_64.load_byte_indexed(10, 6, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 58))
    call assembler.relative(output, [15, 133], "ue_one_number")
    # cesta:řádek:sloupec
    call ue_store(output, UE_PEND, 1)
    call assembler.emit(output, x86_64.lea_base(0, 1, 1))
    call ue_store(output, UE_LSTART, 0)
    call ue_store(output, UE_LEND, 9)
    call assembler.emit(output, x86_64.lea_base(8, 9, 1))
    call ue_load(output, 9, UE_LEN)
    call assembler.relative(output, [232], "ue_number")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "ue_column_ok")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.label(output, "ue_column_ok")
    call ue_store(output, UE_COL, 0)
    call assembler.relative(output, [233], "ue_loc_check")
    call assembler.label(output, "ue_one_number")
    call ue_load(output, 9, UE_J)
    call ue_store(output, UE_PEND, 9)
    call assembler.emit(output, x86_64.lea_base(0, 9, 1))
    call ue_store(output, UE_LSTART, 0)
    call ue_load(output, 0, UE_LEN)
    call ue_store(output, UE_LEND, 0)
    call assembler.label(output, "ue_loc_check")
    call ue_load(output, 0, UE_PEND)
    call ue_load(output, 8, UE_I)
    call assembler.emit(output, x86_64.lea_base(1, 8, 4))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 142], "ue_loc_done")
    call ue_store(output, UE_PSTART, 1)
    call ue_store(output, UE_TEND, 8)
    call assembler.label(output, "ue_loc_done")

    # error[Druh]: zpráva
    call assembler.relative(output, [232], "ue_red")
    call ue_text(output, "error[")
    call ue_load(output, 1, UE_KIND)
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 143], "ue_kind_print")
    call ue_text(output, "Error")
    call assembler.relative(output, [233], "ue_kind_printed")
    call assembler.label(output, "ue_kind_print")
    call ue_load(output, 6, UE_PTR)
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.relative(output, [232], "ue_write")
    call assembler.label(output, "ue_kind_printed")
    call ue_text(output, "]: ")
    call ue_range(output, UE_TSTART, UE_TEND)
    call assembler.relative(output, [232], "ue_reset")
    call ue_text(output, chr(10))

    call ue_load(output, 0, UE_PSTART)
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "ue_help")
    call assembler.relative(output, [232], "ue_blue")
    call ue_text(output, " --> ")
    call ue_range(output, UE_PSTART, UE_LEN)
    call assembler.relative(output, [232], "ue_reset")
    call ue_text(output, chr(10))

    # Zdrojový řádek jen ze souboru .lsl s rozumně dlouhou cestou.
    call ue_load(output, 8, UE_PSTART)
    call ue_load(output, 9, UE_PEND)
    call assembler.emit(output, x86_64.move_reg_reg(1, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(1, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 4))
    call assembler.relative(output, [15, 142], "ue_help")
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 4000))
    call assembler.relative(output, [15, 141], "ue_help")
    call ue_load(output, 6, UE_PTR)
    call assembler.emit(output, x86_64.lea_indexed(11, 6, 9, 0))
    for item in [[-4, 46], [-3, 108], [-2, 115], [-1, 108]]:
        call assembler.emit(output, x86_64.load_byte_zero_extend(10, 11, item[0]))
        call assembler.emit(output, x86_64.cmp_reg_imm8(10, item[1]))
        call assembler.relative(output, [15, 133], "ue_help")
    end
    call assembler.emit(output, x86_64.lea_indexed(11, 6, 8, 0))
    call assembler.emit(output, x86_64.lea_base(7, 5, UE_PATH))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "ue_path_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 1))
    call assembler.relative(output, [15, 141], "ue_path_copied")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 10))
    call assembler.emit(output, x86_64.store_byte_indexed(7, 10, 0))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.relative(output, [233], "ue_path_copy")
    call assembler.label(output, "ue_path_copied")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_byte_indexed(7, 1, 0))
    call ue_load(output, 8, UE_LSTART)
    call ue_load(output, 9, UE_LEND)
    call assembler.relative(output, [232], "ue_number")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 140], "ue_help")
    call ue_store(output, UE_LINE, 0)
    call assembler.emit(output, x86_64.lea_base(7, 5, UE_PATH))
    call assembler.emit(output, x86_64.mov_imm64(6, platform.O_RDONLY + platform.O_CLOEXEC))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_OPEN))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "ue_help")
    call ue_store(output, UE_FD, 0)
    call ue_set(output, UE_CUR, 1)
    call ue_set(output, UE_LLEN, 0)
    call assembler.label(output, "ue_read")
    call ue_load(output, 7, UE_FD)
    call assembler.emit(output, x86_64.lea_base(6, 5, UE_READ))
    call assembler.emit(output, x86_64.mov_imm64(2, 4096))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_READ))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, -4))
    call assembler.relative(output, [15, 132], "ue_read")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "ue_read_done")
    call assembler.emit(output, x86_64.move_reg_reg(9, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.lea_base(6, 5, UE_READ))
    call assembler.emit(output, x86_64.lea_base(7, 5, UE_LINEBUF))
    call assembler.label(output, "ue_scan")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 141], "ue_read")
    call assembler.emit(output, x86_64.load_byte_indexed(10, 6, 8))
    call ue_load(output, 0, UE_CUR)
    call ue_load(output, 1, UE_LINE)
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 133], "ue_scan_other")
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 10))
    call assembler.relative(output, [15, 132], "ue_read_done")
    call ue_load(output, 11, UE_LLEN)
    call assembler.emit(output, x86_64.cmp_reg_imm32(11, 4096))
    call assembler.relative(output, [15, 141], "ue_scan_next")
    call assembler.emit(output, x86_64.store_byte_indexed(7, 11, 10))
    call assembler.emit(output, x86_64.increment(11))
    call ue_store(output, UE_LLEN, 11)
    call assembler.relative(output, [233], "ue_scan_next")
    call assembler.label(output, "ue_scan_other")
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 10))
    call assembler.relative(output, [15, 133], "ue_scan_next")
    call assembler.emit(output, x86_64.increment(0))
    call ue_store(output, UE_CUR, 0)
    call assembler.label(output, "ue_scan_next")
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "ue_scan")
    call assembler.label(output, "ue_read_done")
    call ue_load(output, 7, UE_FD)
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call ue_load(output, 0, UE_CUR)
    call ue_load(output, 1, UE_LINE)
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 133], "ue_help")
    call ue_load(output, 0, UE_LLEN)
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "ue_help")
    # Okraj se šířkou čísla řádku.
    call assembler.relative(output, [232], "ue_gutter")
    call ue_text(output, "|")
    call assembler.relative(output, [232], "ue_reset")
    call ue_text(output, chr(10))
    call assembler.relative(output, [232], "ue_blue")
    call ue_range(output, UE_LSTART, UE_LEND)
    call ue_text(output, " | ")
    call assembler.relative(output, [232], "ue_reset")
    call assembler.emit(output, x86_64.lea_base(6, 5, UE_LINEBUF))
    call ue_load(output, 2, UE_LLEN)
    call assembler.relative(output, [232], "ue_write")
    call ue_text(output, chr(10))
    # Šipka jen při známém sloupci.
    call ue_load(output, 0, UE_COL)
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "ue_help")
    call assembler.relative(output, [232], "ue_gutter")
    call ue_text(output, "| ")
    call assembler.relative(output, [232], "ue_reset")
    call ue_load(output, 0, UE_COL)
    call assembler.emit(output, x86_64.decrement(0))
    call ue_load(output, 1, UE_LLEN)
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 142], "ue_caret_pad")
    call assembler.emit(output, x86_64.move_reg_reg(0, 1))
    call assembler.label(output, "ue_caret_pad")
    call ue_store(output, UE_TMP, 0)
    call assembler.relative(output, [232], "ue_spaces")
    call assembler.relative(output, [232], "ue_red")
    call ue_text(output, "^")
    call ue_load(output, 0, UE_COL)
    call ue_store(output, UE_J, 0)
    call assembler.label(output, "ue_tilde")
    call ue_load(output, 8, UE_J)
    call ue_load(output, 9, UE_LLEN)
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 141], "ue_tilde_done")
    call assembler.emit(output, x86_64.lea_base(7, 5, UE_LINEBUF))
    call assembler.emit(output, x86_64.load_byte_indexed(10, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, 95))
    call assembler.relative(output, [15, 132], "ue_tilde_put")
    for bounds in [[48, 57], [65, 90], [97, 122]]:
        skip = ue_label("tilde_range")
        call assembler.emit(output, x86_64.cmp_reg_imm8(10, bounds[0]))
        call assembler.relative(output, [15, 140], skip)
        call assembler.emit(output, x86_64.cmp_reg_imm8(10, bounds[1]))
        call assembler.relative(output, [15, 142], "ue_tilde_put")
        call assembler.label(output, skip)
    end
    call assembler.relative(output, [233], "ue_tilde_done")
    call assembler.label(output, "ue_tilde_put")
    call ue_text(output, "~")
    call ue_load(output, 8, UE_J)
    call assembler.emit(output, x86_64.increment(8))
    call ue_store(output, UE_J, 8)
    call assembler.relative(output, [233], "ue_tilde")
    call assembler.label(output, "ue_tilde_done")
    call assembler.relative(output, [232], "ue_reset")
    call ue_text(output, chr(10))

    # help: podle textu nebo druhu chyby.
    call assembler.label(output, "ue_help")
    call assembler.relative(output, [232], "ue_cyan")
    call ue_text(output, " help: ")
    helps = [["text", "sequence index must be Int", "convert the index with Int(...)"], ["text", "index must be Int", "convert the index with Int(...)"], ["kind", "TypeError", "check the types of the values; convert explicitly, for example with Int(value) or String(value)"], ["kind", "ValueError", "check that the value has the expected range, length or format"], ["kind", "IndexError", "check the index against len(...) before using it"], ["kind", "KeyError", "check that the key exists, for example with key in dictionary or dictionary.get(key, default)"], ["kind", "ZeroDivisionError", "check that the divisor is not zero before dividing"], ["kind", "NameError", "assign the variable or define the function before using it"], ["kind", "AttributeError", "check the method or field name for this type of value"], ["kind", "FileError", "check the path, permissions and available resources"], ["kind", "OSError", "check the path, permissions and available resources"], ["kind", "MemoryError", "reduce the amount of data kept in memory"]]
    for help in helps:
        key_label = ue_label("help_key")
        text_label = ue_label("help_text")
        call ue_data(output, key_label, help[1])
        call ue_data(output, text_label, help[2])
        call ue_load(output, 6, UE_PTR)
        if help[0] == "text":
            call ue_load(output, 0, UE_TSTART)
            call assembler.emit(output, x86_64.add_reg_reg(6, 0))
            call ue_load(output, 2, UE_TEND)
            call assembler.emit(output, x86_64.sub_reg_reg(2, 0))
        else:
            call ue_load(output, 2, UE_KIND)
        end
        call assembler.relative(output, x86_64.lea_rip_prefix(7), key_label)
        call assembler.emit(output, x86_64.mov_imm64(1, len(bytes.utf8(help[1]))))
        if help[0] == "text":
            # Text chyby může pokračovat upřesněním (", got String").
            call assembler.relative(output, [232], "ue_prefix")
        else:
            call assembler.relative(output, [232], "ue_equal")
        end
        call assembler.emit(output, x86_64.test_reg_reg(0, 0))
        next_help = ue_label("help_next")
        call assembler.relative(output, [15, 132], next_help)
        call assembler.relative(output, x86_64.lea_rip_prefix(6), text_label)
        call assembler.emit(output, x86_64.mov_imm64(2, len(bytes.utf8(help[2]))))
        call assembler.relative(output, [232], "ue_write")
        call assembler.relative(output, [233], "ue_help_done")
        call assembler.label(output, next_help)
    end
    call ue_text(output, "handle expected errors with try: ... else: ... end or safe: ... end")
    call assembler.label(output, "ue_help_done")
    call assembler.relative(output, [232], "ue_reset")
    call ue_text(output, chr(10))
    call assembler.relative(output, [232], "stdin_release")
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_EXIT_GROUP))
    call assembler.emit(output, x86_64.syscall())

    # Podprogramy: používají rámec volajícího přes rbp.
    call assembler.label(output, "ue_write")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "ue_write_return")
    call assembler.emit(output, x86_64.mov_imm64(7, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_WRITE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "ue_write_return")
    call assembler.emit(output, x86_64.ret())
    for color in [["ue_red", chr(27) + "[1;31m"], ["ue_blue", chr(27) + "[1;34m"], ["ue_cyan", chr(27) + "[36m"], ["ue_reset", chr(27) + "[0m"]]:
        call assembler.label(output, color[0])
        call ue_load(output, 0, UE_COLOR)
        call assembler.emit(output, x86_64.test_reg_reg(0, 0))
        call assembler.relative(output, [15, 132], color[0] + "_return")
        call ue_text(output, color[1])
        call assembler.label(output, color[0] + "_return")
        call assembler.emit(output, x86_64.ret())
    end
    # UE_TMP mezer.
    call assembler.label(output, "ue_spaces")
    call ue_load(output, 0, UE_TMP)
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "ue_spaces_return")
    call assembler.emit(output, x86_64.decrement(0))
    call ue_store(output, UE_TMP, 0)
    call ue_text(output, " ")
    call assembler.relative(output, [233], "ue_spaces")
    call assembler.label(output, "ue_spaces_return")
    call assembler.emit(output, x86_64.ret())
    # Modře okraj široký jako číslo řádku + 1.
    call assembler.label(output, "ue_gutter")
    call assembler.relative(output, [232], "ue_blue")
    call ue_load(output, 0, UE_LEND)
    call ue_load(output, 1, UE_LSTART)
    call assembler.emit(output, x86_64.sub_reg_reg(0, 1))
    call assembler.emit(output, x86_64.increment(0))
    call ue_store(output, UE_TMP, 0)
    call assembler.relative(output, [232], "ue_spaces")
    call assembler.emit(output, x86_64.ret())
    # rax = číslo z bajtů zprávy [r8, r9), -1 pokud nejde o číslo.
    call assembler.label(output, "ue_number")
    call assembler.emit(output, x86_64.move_reg_reg(1, 9))
    call assembler.emit(output, x86_64.sub_reg_reg(1, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 142], "ue_number_fail")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
    call assembler.relative(output, [15, 143], "ue_number_fail")
    call ue_load(output, 11, UE_PTR)
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.label(output, "ue_number_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 141], "ue_number_return")
    call ue_digit_or(output, 11, 8, "ue_number_fail")
    call assembler.emit(output, x86_64.imul_reg_imm(0, 0, 10))
    call assembler.emit(output, x86_64.add_reg_imm8(10, -48))
    call assembler.emit(output, x86_64.add_reg_reg(0, 10))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "ue_number_loop")
    call assembler.label(output, "ue_number_fail")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.label(output, "ue_number_return")
    call assembler.emit(output, x86_64.ret())
    # rax = 1, když [rsi, rsi+rdx) začíná bajty [rdi, rdi+rcx).
    call assembler.label(output, "ue_prefix")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 140], "ue_equal_return")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    # rax = 1, když bajty [rsi, rsi+rdx) jsou rovny [rdi, rdi+rcx).
    call assembler.label(output, "ue_equal")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 133], "ue_equal_return")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.label(output, "ue_equal_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 1))
    call assembler.relative(output, [15, 141], "ue_equal_yes")
    call assembler.emit(output, x86_64.load_byte_indexed(9, 6, 8))
    call assembler.emit(output, x86_64.load_byte_indexed(10, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 10))
    call assembler.relative(output, [15, 133], "ue_equal_return")
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "ue_equal_loop")
    call assembler.label(output, "ue_equal_yes")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.label(output, "ue_equal_return")
    call assembler.emit(output, x86_64.ret())
end
