# lsl: internal-abi
# Linux x86_64 syscall boundary for the pure runtime.

load runtime_abi_linux_x86_64 as abi_x86_64
load _platform_linux_x86_64 as platform
load assembler_x86_64 as assembler
load bytes
load x86_64

function emit_heap_type_validation(output):
    # r9 = candidate object, r10 = expected heap tag -> rax Bool. Preserve all
    # five language argument registers so raw I/O helpers can validate objects
    # before dereferencing them without changing their syscall arguments.
    call assembler.label(output, "runtime_heap_type_valid")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.emit(output, x86_64.store_stack(-40, 8))
    call assembler.emit(output, x86_64.store_stack(-48, 9))
    call assembler.emit(output, x86_64.store_stack(-56, 10))
    call assembler.emit(output, x86_64.move_reg_reg(7, 9))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "heap_type_invalid")
    call assembler.emit(output, x86_64.load_stack(7, -48))
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.load_stack(1, -56))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.emit(output, x86_64.set_condition(148))
    call assembler.relative(output, [233], "heap_type_restore")
    call assembler.label(output, "heap_type_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.label(output, "heap_type_restore")
    call assembler.emit(output, x86_64.load_stack(8, -40))
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_path_validation(output):
    # Validate the actual C-string boundary used by Linux syscalls. Embedded NUL
    # must never silently redirect an operation to a path prefix.
    call assembler.label(output, "runtime_path_valid")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "path_invalid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 1))
    call assembler.relative(output, [15, 133], "path_invalid")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 142], "path_invalid")
    call assembler.emit(output, x86_64.cmp_reg_imm32(8, 4095))
    call assembler.relative(output, [15, 143], "path_invalid")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "path_scan")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "path_valid")
    call assembler.emit(output, x86_64.load_byte_indexed(1, 7, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "path_invalid")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "path_scan")
    call assembler.label(output, "path_valid")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "path_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_string_validation(output):
    # rdi=dynamic value. Accept a live String of at most one GiB. Unlike path
    # validation, empty strings and embedded NUL bytes are valid file content.
    call assembler.label(output, "runtime_string_valid")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "string_invalid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 1))
    call assembler.relative(output, [15, 133], "string_invalid")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm32(8, 1073741824))
    call assembler.relative(output, [15, 143], "string_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "string_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_cstring(output):
    call assembler.label(output, "runtime_from_cstring")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "cstring_length")
    call assembler.emit(output, x86_64.load_byte_indexed(2, 7, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 132], "cstring_allocate")
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "cstring_length")
    call assembler.label(output, "cstring_allocate")
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(6, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "cstring_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "cstring_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "cstring_copy")
    call assembler.label(output, "cstring_done")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 1, 8))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())
end

# Buffered stdin for input(). State slots: +1280 mode (0 unknown, 1 buffered
# regular file, 2 unbuffered), +1288 buffer (64 KiB mmap; word 0 = filled
# bytes, word 1 = read position, data from byte 16). Only regular files are
# buffered: their unread bytes are handed back with lseek before a child
# inherits stdin and at exit, so programs and shells sharing the file see
# exactly what byte reads gave them. Pipes and terminals keep the one-byte
# read, which never over-reads.
function emit_stdin_buffer(output):
    call assembler.label(output, "stdin_read_one")
    call assembler.emit(output, x86_64.function_prologue(240))
    call assembler.emit(output, x86_64.store_stack(-8, 6))
    call assembler.emit(output, x86_64.store_stack(-16, 7))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.emit(output, x86_64.store_stack(-40, 11))
    call assembler.emit(output, x86_64.store_stack(-48, 8))
    call assembler.emit(output, x86_64.store_stack(-56, 9))
    call assembler.emit(output, x86_64.store_stack(-64, 10))
    call assembler.emit(output, x86_64.cmp_memory_imm8(3, 1280, 0))
    call assembler.relative(output, [15, 133], "stdin_mode_known")
    # Detect once: fstat(0) into the frame; S_IFREG (mode >> 12 == 8) buffers.
    call assembler.emit(output, x86_64.store_memory_imm32(3, 1280, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_FSTAT))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.lea_base(6, 5, -224))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "stdin_mode_known")
    call assembler.emit(output, x86_64.lea_base(1, 5, -224))
    call assembler.emit(output, x86_64.load_memory(0, 1, platform.STAT_MODE))
    call assembler.emit(output, x86_64.shift_right_logical_imm(0, 12))
    call assembler.emit(output, x86_64.and_reg_imm8(0, 15))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 8))
    call assembler.relative(output, [15, 133], "stdin_mode_known")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MMAP))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.mov_imm64(6, 65536))
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.emit(output, x86_64.mov_imm64(10, platform.MAP_PRIVATE + platform.MAP_ANONYMOUS))
    call assembler.emit(output, x86_64.mov_imm64(8, -1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "stdin_mode_known")
    call assembler.emit(output, x86_64.store_memory(3, 1288, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(3, 1280, 1))
    call assembler.label(output, "stdin_mode_known")
    call assembler.emit(output, x86_64.cmp_memory_imm8(3, 1280, 1))
    call assembler.relative(output, [15, 133], "stdin_plain_read")
    call assembler.emit(output, x86_64.load_memory(7, 3, 1288))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 130], "stdin_have_byte")
    call assembler.label(output, "stdin_refill")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_READ))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.load_memory(6, 3, 1288))
    call assembler.emit(output, x86_64.add_reg_imm8(6, 16))
    call assembler.emit(output, x86_64.mov_imm64(2, 65520))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, -4))
    call assembler.relative(output, [15, 132], "stdin_refill")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "stdin_done")
    call assembler.emit(output, x86_64.load_memory(7, 3, 1288))
    call assembler.emit(output, x86_64.store_memory(7, 0, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.label(output, "stdin_have_byte")
    call assembler.emit(output, x86_64.lea_base(1, 7, 16))
    call assembler.emit(output, x86_64.load_byte_indexed(8, 1, 0))
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.store_memory(7, 8, 0))
    call assembler.emit(output, x86_64.load_stack(6, -8))
    call assembler.emit(output, x86_64.store_byte_reg(6, 8))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.relative(output, [233], "stdin_done")
    call assembler.label(output, "stdin_plain_read")
    call assembler.emit(output, x86_64.load_stack(6, -8))
    call assembler.emit(output, x86_64.mov_imm64(2, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_READ))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "stdin_done")
    call assembler.emit(output, x86_64.load_stack(6, -8))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.load_stack(11, -40))
    call assembler.emit(output, x86_64.load_stack(8, -48))
    call assembler.emit(output, x86_64.load_stack(9, -56))
    call assembler.emit(output, x86_64.load_stack(10, -64))
    call assembler.emit(output, x86_64.function_epilogue())

    # Hand unread buffered bytes back to the file offset (lseek SEEK_CUR by
    # -unread) so a child process or a later reader continues where input()
    # logically stopped. Preserves every register; no-op unless buffered.
    call assembler.label(output, "stdin_release")
    call assembler.relative(output, [232], "runtime_stdout_flush")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 7))
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.emit(output, x86_64.store_stack(-40, 1))
    call assembler.emit(output, x86_64.store_stack(-48, 11))
    call assembler.emit(output, x86_64.cmp_memory_imm8(3, 1280, 1))
    call assembler.relative(output, [15, 133], "stdin_release_done")
    call assembler.emit(output, x86_64.load_memory(7, 3, 1288))
    call assembler.emit(output, x86_64.load_memory(6, 7, 8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 1))
    call assembler.relative(output, [15, 131], "stdin_release_done")
    call assembler.emit(output, x86_64.sub_reg_reg(6, 1))
    call assembler.emit(output, x86_64.store_memory(7, 8, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_LSEEK))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.mov_imm64(2, 1))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "stdin_release_done")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.load_stack(1, -40))
    call assembler.emit(output, x86_64.load_stack(11, -48))
    call assembler.emit(output, x86_64.function_epilogue())
end

# Buffered stdout for print. State slots: +1312 mode (0 unknown, 1
# buffered, 2 direct), +1320 buffer (64 KiB mmap; word 0 = bytes pending,
# data from byte 16). Regular files, pipes and non-terminal character
# devices such as /dev/null are buffered; a terminal keeps direct writes so
# interactive programs stay responsive. Every blocking or ordering-sensitive
# runtime door (input, fd reads and writes, raw syscalls, sleep, fork,
# threads, native calls, stderr diagnostics, exit) flushes first, and the
# buffer is bypassed once a second thread exists.
function emit_stdout_buffer(output):
    # Přímé syscally, nativní kód a další vlákna mohou číst nebo přesměrovat
    # standardní deskriptory. Vrátíme předčtená data a nadále čteme přímo;
    # stejně vypneme stdout buffer, jehož původní druh deskriptoru už neplatí.
    call assembler.label(output, "runtime_stdio_direct")
    call assembler.relative(output, [232], "stdin_release")
    call assembler.emit(output, x86_64.store_memory_imm32(3, 1280, 2))
    call assembler.emit(output, x86_64.store_memory_imm32(3, 1312, 2))
    call assembler.emit(output, x86_64.ret())

    # Clobbers rax, rcx, rdx, rsi, rdi and r11 exactly like the write
    # syscall it replaces; r8-r10 are preserved for the generated code.
    call assembler.label(output, "runtime_stdout_write")
    call assembler.emit(output, x86_64.function_prologue(240))
    call assembler.emit(output, x86_64.store_stack(-8, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.store_stack(-32, 8))
    call assembler.emit(output, x86_64.store_stack(-40, 9))
    call assembler.emit(output, x86_64.store_stack(-48, 10))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "stdout_write_done")
    call assembler.emit(output, x86_64.cmp_memory_imm8(3, 136, 0))
    call assembler.relative(output, [15, 133], "stdout_write_direct_flush")
    call assembler.emit(output, x86_64.cmp_memory_imm8(3, 1312, 0))
    call assembler.relative(output, [15, 133], "stdout_mode_known")
    # Detect once: fstat(1); S_IFREG (8) and S_IFIFO (1) buffer, S_IFCHR (2)
    # buffers only when ioctl(TCGETS) fails, so no terminal is ever buffered.
    call assembler.emit(output, x86_64.store_memory_imm32(3, 1312, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_FSTAT))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.lea_base(6, 5, -224))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "stdout_mode_known")
    call assembler.emit(output, x86_64.lea_base(1, 5, -224))
    call assembler.emit(output, x86_64.load_memory(0, 1, platform.STAT_MODE))
    call assembler.emit(output, x86_64.shift_right_logical_imm(0, 12))
    call assembler.emit(output, x86_64.and_reg_imm8(0, 15))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 8))
    call assembler.relative(output, [15, 132], "stdout_buffered_kind")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 132], "stdout_buffered_kind")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 2))
    call assembler.relative(output, [15, 133], "stdout_mode_known")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_IOCTL))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.mov_imm64(6, 21505))
    call assembler.emit(output, x86_64.lea_base(2, 5, -224))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "stdout_mode_known")
    call assembler.label(output, "stdout_buffered_kind")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MMAP))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.mov_imm64(6, 65536))
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.emit(output, x86_64.mov_imm64(10, platform.MAP_PRIVATE + platform.MAP_ANONYMOUS))
    call assembler.emit(output, x86_64.mov_imm64(8, -1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "stdout_mode_known")
    call assembler.emit(output, x86_64.store_memory(3, 1320, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(3, 1312, 1))
    call assembler.label(output, "stdout_mode_known")
    call assembler.emit(output, x86_64.cmp_memory_imm8(3, 1312, 1))
    call assembler.relative(output, [15, 133], "stdout_write_direct")
    call assembler.emit(output, x86_64.load_memory(7, 3, 1320))
    call assembler.emit(output, x86_64.load_memory(0, 7, 0))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.add_reg_reg(1, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 65520))
    call assembler.relative(output, [15, 142], "stdout_append")
    call assembler.relative(output, [232], "runtime_stdout_flush")
    call assembler.emit(output, x86_64.cmp_reg_imm32(2, 65520))
    call assembler.relative(output, [15, 143], "stdout_write_direct")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.label(output, "stdout_append")
    call assembler.emit(output, x86_64.lea_base(8, 7, 16))
    call assembler.emit(output, x86_64.add_reg_reg(8, 0))
    call assembler.emit(output, x86_64.load_stack(9, -8))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "stdout_copy_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 2))
    call assembler.relative(output, [15, 141], "stdout_copy_done")
    call assembler.emit(output, x86_64.load_byte_indexed(11, 9, 10))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 10, 11))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.relative(output, [233], "stdout_copy_loop")
    call assembler.label(output, "stdout_copy_done")
    call assembler.emit(output, x86_64.add_reg_reg(0, 2))
    call assembler.emit(output, x86_64.store_memory(7, 0, 0))
    call assembler.relative(output, [233], "stdout_write_done")
    call assembler.label(output, "stdout_write_direct_flush")
    call assembler.relative(output, [232], "runtime_stdout_flush")
    call assembler.label(output, "stdout_write_direct")
    call assembler.emit(output, x86_64.load_stack(6, -8))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_WRITE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "stdout_write_done")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.load_stack(10, -48))
    call assembler.emit(output, x86_64.function_epilogue())

    # Write every pending byte (partial writes and EINTR retried; any other
    # error drops the rest, as a direct write would have). Preserves all
    # registers so it can be called from any runtime door.
    call assembler.label(output, "runtime_stdout_flush")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 7))
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.emit(output, x86_64.store_stack(-40, 1))
    call assembler.emit(output, x86_64.store_stack(-48, 11))
    call assembler.emit(output, x86_64.store_stack(-56, 8))
    call assembler.emit(output, x86_64.cmp_memory_imm8(3, 1312, 1))
    call assembler.relative(output, [15, 133], "stdout_flush_done")
    call assembler.emit(output, x86_64.load_memory(8, 3, 1320))
    call assembler.emit(output, x86_64.load_memory(2, 8, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "stdout_flush_done")
    call assembler.emit(output, x86_64.lea_base(6, 8, 16))
    call assembler.label(output, "stdout_flush_loop")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_WRITE))
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, -4))
    call assembler.relative(output, [15, 132], "stdout_flush_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "stdout_flush_reset")
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 143], "stdout_flush_loop")
    call assembler.label(output, "stdout_flush_reset")
    call assembler.emit(output, x86_64.load_memory(8, 3, 1320))
    call assembler.emit(output, x86_64.store_memory_imm32(8, 0, 0))
    call assembler.label(output, "stdout_flush_done")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.load_stack(1, -40))
    call assembler.emit(output, x86_64.load_stack(11, -48))
    call assembler.emit(output, x86_64.load_stack(8, -56))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_input(output):
    call assembler.label(output, "runtime_input")
    call assembler.emit(output, x86_64.function_prologue(80))
    # State+88 is an internal EOF marker used by the stdin source frontend.
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_memory(3, 88, 1))
    call assembler.relative(output, [232], "runtime_print_string")
    call assembler.relative(output, [232], "runtime_stdout_flush")
    call assembler.emit(output, x86_64.mov_imm64(7, 273))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, 0))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, 256))
    call assembler.emit(output, x86_64.store_stack(-24, 1))

    call assembler.label(output, "input_read_loop")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 133], "input_read_byte")
    # Grow the payload 2x and copy the bytes collected so far.
    call assembler.emit(output, x86_64.cmp_reg_imm32(2, 1048576))
    call assembler.relative(output, [15, 141], "input_read_error")
    call assembler.emit(output, x86_64.shift_left_imm(2, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.move_reg_reg(7, 2))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.lea_base(6, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "input_grow_copy")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "input_grow_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "input_grow_copy")
    call assembler.label(output, "input_grow_done")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.store_stack(-8, 0))

    call assembler.label(output, "input_read_byte")
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.add_reg_reg(6, 2))
    # One byte into [rsi]; rax follows read(2): 1, 0 at EOF, -errno. A regular
    # file is served from a 64 KiB buffer, pipes and terminals byte by byte.
    call assembler.relative(output, [232], "stdin_read_one")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "input_read_error")
    call assembler.relative(output, [15, 132], "input_eof")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.load_byte_zero_extend(8, 6, 0))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 10))
    call assembler.relative(output, [15, 133], "input_read_loop")
    call assembler.relative(output, [233], "input_finish")

    call assembler.label(output, "input_eof")
    call assembler.emit(output, x86_64.mov_imm64(1, 1))
    call assembler.emit(output, x86_64.store_memory(3, 88, 1))
    call assembler.label(output, "input_finish")
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    # Strip LF and then CR, preserving EOF without a line terminator.
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "input_store")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.load_byte_indexed(8, 6, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 10))
    call assembler.relative(output, [15, 133], "input_check_cr")
    call assembler.emit(output, x86_64.decrement(0))
    call assembler.label(output, "input_check_cr")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "input_store")
    call assembler.emit(output, x86_64.move_reg_reg(2, 0))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.load_byte_indexed(8, 6, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 13))
    call assembler.relative(output, [15, 133], "input_store")
    call assembler.emit(output, x86_64.decrement(0))
    call assembler.label(output, "input_store")
    call assembler.emit(output, x86_64.store_memory(1, 8, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 0, 2))
    call assembler.emit(output, x86_64.move_reg_reg(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "input_read_error")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "input_read_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "input_read_error_data")
    message = "FileError: cannot read stdin"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_readfile(output):
    call assembler.label(output, "runtime_readfile")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "readfile_open_failed")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 524288))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_OPEN))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "readfile_opened")
    call assembler.label(output, "readfile_open_failed")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "readfile_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "readfile_opened")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    # Determine exact size with lseek(fd, 0, SEEK_END), then rewind.
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.mov_imm64(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_LSEEK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "readfile_read_error")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    # The convenient whole-file API is intentionally bounded. Streaming or
    # explicitly larger reads use stdlib/fd.read_all_limit instead.
    call assembler.emit(output, x86_64.mov_imm64(1, 67108864))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 143], "readfile_read_error")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(2, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_LSEEK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "readfile_read_error")
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.label(output, "readfile_read_loop")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 2))
    call assembler.relative(output, [15, 141], "readfile_read_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.lea_base(6, 6, 16))
    call assembler.emit(output, x86_64.lea_indexed(6, 6, 8, 0))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_READ))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "readfile_read_error")
    call assembler.relative(output, [15, 132], "readfile_read_done")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.add_reg_reg(8, 0))
    call assembler.emit(output, x86_64.store_stack(-32, 8))
    call assembler.relative(output, [233], "readfile_read_loop")
    call assembler.label(output, "readfile_read_done")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.store_memory(1, 8, 0))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 0, 2))
    # close(fd)
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "readfile_read_error")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "readfile_read_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "readfile_error_data")
    message = "FileError: cannot open file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
    call assembler.label(output, "readfile_read_error_data")
    message = "FileError: cannot read file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_readbytes(output):
    call assembler.label(output, "runtime_readbytes")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "readbytes_open_failed")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(6, 524288))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_OPEN))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "readbytes_opened")
    call assembler.label(output, "readbytes_open_failed")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "readbytes_open_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "readbytes_opened")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.emit(output, x86_64.mov_imm64(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_LSEEK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "readbytes_error")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.mov_imm64(1, 67108864))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 143], "readbytes_error")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_LSEEK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "readbytes_error")
    call assembler.relative(output, [232], "runtime_byte_array_new")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.mov_imm64(2, 64))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 142], "readbytes_buffer_ready")
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.relative(output, [232], "runtime_alloc_raw")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.store_memory(1, 24, 0))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.store_memory(1, 16, 2))
    call assembler.label(output, "readbytes_buffer_ready")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.label(output, "readbytes_loop")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 2))
    call assembler.relative(output, [15, 141], "readbytes_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -24))
    call assembler.emit(output, x86_64.load_memory(6, 6, 24))
    call assembler.emit(output, x86_64.lea_indexed(6, 6, 8, 0))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "readbytes_error")
    call assembler.relative(output, [15, 132], "readbytes_done")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.add_reg_reg(8, 0))
    call assembler.emit(output, x86_64.store_stack(-32, 8))
    call assembler.relative(output, [233], "readbytes_loop")
    call assembler.label(output, "readbytes_done")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.store_memory(1, 8, 2))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "readbytes_error")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "readbytes_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "readbytes_open_error_data")
    message = "FileError: cannot open file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
    call assembler.label(output, "readbytes_error_data")
    message = "FileError: cannot read file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_write_all(output):
    # Loop write(2) until every byte is sent. rdi=fd, rsi=buf, rdx=count.
    # syscall preserves rdi/rsi/rdx; returns 0 on success, -1 on write error.
    call assembler.label(output, "runtime_write_all")
    call assembler.label(output, "write_all_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "write_all_done")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_WRITE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 143], "write_all_advance")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, -4))
    call assembler.relative(output, [15, 132], "write_all_loop")
    call assembler.relative(output, [233], "write_all_error")
    call assembler.label(output, "write_all_advance")
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 0))
    call assembler.relative(output, [233], "write_all_loop")
    call assembler.label(output, "write_all_error")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "write_all_done")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_writefile(output):
    call assembler.label(output, "runtime_writefile")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-40, 7))
    call assembler.emit(output, x86_64.store_stack(-8, 6))
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "writefile_failed")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_string_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "writefile_failed")
    call assembler.emit(output, x86_64.load_stack(7, -40))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    # O_WRONLY|O_CREAT|O_TRUNC|O_NOFOLLOW|O_CLOEXEC. Text files are data,
    # not executables; the caller's umask may restrict 0644 further.
    call assembler.emit(output, x86_64.mov_imm64(6, 655937))
    call assembler.emit(output, x86_64.mov_imm64(2, 420))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_OPEN))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "writefile_opened")
    call assembler.relative(output, [233], "writefile_failed")
    call assembler.label(output, "writefile_opened")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    call assembler.emit(output, x86_64.load_memory(2, 1, 8))
    call assembler.relative(output, [232], "runtime_write_all")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "writefile_failed")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "writefile_failed")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "writefile_failed")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "writefile_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "writefile_error_data")
    message = "FileError: cannot write file"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_appendfile(output):
    call assembler.label(output, "runtime_appendfile")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-40, 7))
    call assembler.emit(output, x86_64.store_stack(-8, 6))
