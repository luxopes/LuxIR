# lsl: internal-abi
# Restricted self-contained ELF ET_DYN loader for the public CPU native ABI.
# No relocations or external symbols: mapped file offsets must equal st_value.

load runtime_abi_linux_x86_64 as abi_x86_64
load _platform_linux_x86_64 as platform
load assembler_x86_64 as assembler
load bytes
load x86_64

function emit_validation(output):
    # Validate opaque native handles through the live-object registry before
    # dereferencing them. Public wrappers already check types, but the compiler
    # builtins are callable directly and must fail closed instead of turning a
    # bad dynamic value into an arbitrary memory access.
    call assembler.label(output, "runtime_native_library_valid")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_library_invalid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 11))
    call assembler.relative(output, [15, 133], "native_library_invalid")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "native_library_invalid")
    call assembler.emit(output, x86_64.load_memory(1, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 64))
    call assembler.relative(output, [15, 140], "native_library_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_library_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_native_string_valid")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_string_invalid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 133], "native_string_invalid")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm32(1, 255))
    call assembler.relative(output, [15, 143], "native_string_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_string_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_native_function_valid")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_target_invalid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 12))
    call assembler.relative(output, [15, 133], "native_target_invalid")
    call assembler.emit(output, x86_64.load_memory(7, 7, 16))
    call assembler.relative(output, [232], "runtime_native_library_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_target_invalid")
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.load_memory(1, 8, 8))
    call assembler.emit(output, x86_64.load_memory(7, 8, 16))
    call assembler.emit(output, x86_64.load_memory(2, 7, 8))
    call assembler.emit(output, x86_64.load_memory(6, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 130], "native_target_invalid")
    call assembler.emit(output, x86_64.add_reg_reg(2, 6))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 131], "native_target_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_target_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_native_arguments_valid")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_arguments_invalid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 2))
    call assembler.relative(output, [15, 133], "native_arguments_invalid")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 6))
    call assembler.relative(output, [15, 133], "native_arguments_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.label(output, "native_arguments_loop")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 6))
    call assembler.relative(output, [15, 141], "native_arguments_ok")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 1, 3))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_arguments_invalid")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
    call assembler.relative(output, [15, 133], "native_arguments_invalid")
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.relative(output, [233], "native_arguments_loop")
    call assembler.label(output, "native_arguments_ok")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_arguments_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_open(output):
    call assembler.label(output, "runtime_native_open")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.relative(output, [232], "runtime_path_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_open_fail")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    # O_RDONLY|O_CLOEXEC|O_NOFOLLOW. The final path component must not be
    # replaceable through a symlink between policy and loading.
    call assembler.emit(output, x86_64.mov_imm64(6, 655360))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_OPEN))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "native_open_fail")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.emit(output, x86_64.mov_imm64(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_LSEEK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 64))
    call assembler.relative(output, [15, 140], "native_open_close_fail")
    # A native image is copied into a bounded anonymous mapping. This both
    # caps resource use and prevents later file modifications from changing
    # code that has already passed ELF validation.
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 268435456))
    call assembler.relative(output, [15, 143], "native_open_close_fail")
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.mov_imm64(2, 3))
    call assembler.emit(output, x86_64.mov_imm64(10, platform.MAP_PRIVATE + platform.MAP_ANONYMOUS))
    call assembler.emit(output, x86_64.mov_imm64(8, -1))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MMAP))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "native_open_close_fail")

    # Rewind and copy the complete descriptor, retrying only EINTR. A short
    # read or a concurrently truncated file is rejected.
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_LSEEK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "native_open_unmap_close_fail")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.label(output, "native_copy_loop")
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 2))
    call assembler.relative(output, [15, 141], "native_copy_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -24))
    call assembler.emit(output, x86_64.add_reg_reg(6, 1))
    call assembler.emit(output, x86_64.sub_reg_reg(2, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 143], "native_copy_advance")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, -4))
    call assembler.relative(output, [15, 132], "native_copy_loop")
    call assembler.relative(output, [233], "native_open_unmap_close_fail")
    call assembler.label(output, "native_copy_advance")
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.add_reg_reg(1, 0))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.relative(output, [233], "native_copy_loop")
    call assembler.label(output, "native_copy_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())

    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.mov_imm64(2, 1179403647))
    call assembler.emit(output, x86_64.move_reg_reg(8, 1))
    call assembler.emit(output, x86_64.mov_imm64(9, 4294967295))
    call assembler.emit(output, x86_64.and_reg_reg(8, 9))
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 2))
    call assembler.relative(output, [15, 133], "native_open_unmap_fail")
    call assembler.emit(output, x86_64.load_memory(1, 7, 16))
    call assembler.emit(output, x86_64.mov_imm64(9, 65535))
    call assembler.emit(output, x86_64.move_reg_reg(8, 1))
    call assembler.emit(output, x86_64.and_reg_reg(8, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 3))
    call assembler.relative(output, [15, 133], "native_open_unmap_fail")
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(1, 16))
    call assembler.emit(output, x86_64.and_reg_reg(1, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 62))
    call assembler.relative(output, [15, 133], "native_open_unmap_fail")

    # Enforce W^X: bytes are writable only while copied, then executable and
    # read-only for the entire lifetime of the handle.
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.mov_imm64(2, 5))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MPROTECT))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "native_open_unmap_fail")
    call assembler.emit(output, x86_64.mov_imm64(7, 24))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 11))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.store_memory(0, 16, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_open_unmap_fail")
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MUNMAP))
    call assembler.emit(output, x86_64.syscall())
    call assembler.relative(output, [233], "native_open_fail")
    call assembler.label(output, "native_open_unmap_close_fail")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MUNMAP))
    call assembler.emit(output, x86_64.syscall())
    call assembler.relative(output, [233], "native_open_fail")
    call assembler.label(output, "native_open_close_fail")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "native_open_fail")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_access(output):
    call assembler.label(output, "runtime_native_size")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_native_lock")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_native_library_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_size_closed")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "native_size_closed")
    call assembler.emit(output, x86_64.load_memory(0, 7, 16))
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.relative(output, [233], "native_size_return")
    call assembler.label(output, "native_size_closed")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.label(output, "native_size_return")
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_native_u64")
    # Reject negative and truncated reads before touching the file mapping.
    # A malformed section table must produce NativeError in stdlib instead of
    # a SIGBUS/SIGSEGV in the loader process.
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.relative(output, [232], "runtime_native_lock")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_native_library_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_u64_invalid")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "native_u64_invalid")
    call assembler.emit(output, x86_64.load_memory(8, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 8))
    call assembler.relative(output, [15, 140], "native_u64_invalid")
    call assembler.emit(output, x86_64.add_reg_imm8(8, -8))
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 8))
    call assembler.relative(output, [15, 143], "native_u64_invalid")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "native_u64_invalid")
    call assembler.emit(output, x86_64.load_indexed(0, 7, 6, 0))
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.relative(output, [233], "native_u64_return")
    call assembler.label(output, "native_u64_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.label(output, "native_u64_return")
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_native_name_equal")
    # Require the requested name plus its terminating NUL to fit in the
    # mapped file before comparing any bytes.
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.relative(output, [232], "runtime_native_lock")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_native_library_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_name_false")
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.relative(output, [232], "runtime_native_string_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_name_false")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "native_name_false")
    call assembler.emit(output, x86_64.load_memory(10, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 10))
    call assembler.relative(output, [15, 141], "native_name_false")
    call assembler.emit(output, x86_64.sub_reg_reg(10, 6))
    call assembler.emit(output, x86_64.load_memory(1, 2, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 10))
    call assembler.relative(output, [15, 141], "native_name_false")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "native_name_false")
    call assembler.emit(output, x86_64.lea_indexed(7, 7, 6, 0))
    call assembler.emit(output, x86_64.lea_base(2, 2, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.label(output, "native_name_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 1))
    call assembler.relative(output, [15, 141], "native_name_end")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 7, 8))
    call assembler.emit(output, x86_64.load_byte_indexed(6, 2, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 6))
    call assembler.relative(output, [15, 133], "native_name_false")
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "native_name_loop")
    call assembler.label(output, "native_name_end")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "native_name_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.relative(output, [233], "native_name_return")
    call assembler.label(output, "native_name_false")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.label(output, "native_name_return")
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "runtime_native_function")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.relative(output, [232], "runtime_native_lock")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_native_library_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_function_invalid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "native_function_invalid")
    call assembler.emit(output, x86_64.load_memory(8, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 8))
    call assembler.relative(output, [15, 141], "native_function_invalid")
    call assembler.emit(output, x86_64.store_stack(-32, 7))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "native_function_invalid")
    call assembler.emit(output, x86_64.add_reg_reg(1, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.emit(output, x86_64.mov_imm64(7, 24))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 12))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.store_memory(0, 16, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_function_invalid")
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_call_close(output):
    call assembler.label(output, "runtime_native_call")
    call assembler.relative(output, [232], "runtime_stdio_direct")
    call assembler.emit(output, x86_64.function_prologue(128))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    # Serialize mapping inspection with native_close. A close racing validation
    # previously could unmap code between the bounds check and fork/call.
    call assembler.relative(output, [232], "runtime_native_lock")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_native_function_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_call_locked_closed")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_native_arguments_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_call_locked_invalid_arguments")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))

    # Execute native machine code in a short-lived process. The parent only
    # receives one Int result, so memory corruption, SIGSEGV and infinite loops
    # cannot damage or wedge the LSL process that loaded the image.
    call assembler.emit(output, x86_64.lea_base(7, 5, -96))
    call assembler.emit(output, x86_64.mov_imm64(6, 524288))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_PIPE2))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "native_call_locked_sandbox_error")
    call assembler.emit(output, x86_64.lea_base(7, 5, -96))
    call assembler.emit(output, x86_64.load_memory(8, 7, 0))
    call assembler.emit(output, x86_64.move_reg_reg(9, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, 4294967295))
    call assembler.emit(output, x86_64.and_reg_reg(9, 1))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(8, 32))
    call assembler.emit(output, x86_64.store_stack(-40, 9))
    call assembler.emit(output, x86_64.store_stack(-48, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_stack(-72, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_FORK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "native_call_fork_error")
    call assembler.relative(output, [15, 132], "native_call_child")

    # Parent: close the writer, read the fixed eight-byte result and reap the
    # child. The child's alarm guarantees EOF within two seconds. fork gave the
    # child a private copy of the executable mapping, so parent close may now
    # proceed without invalidating its call target.
    call assembler.emit(output, x86_64.store_stack(-56, 0))
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.emit(output, x86_64.load_stack(7, -48))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "native_call_parent_read")
    call assembler.emit(output, x86_64.load_stack(7, -40))
    call assembler.emit(output, x86_64.lea_base(6, 5, -64))
    call assembler.emit(output, x86_64.mov_imm64(2, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, -4))
    call assembler.relative(output, [15, 132], "native_call_parent_read")
    call assembler.emit(output, x86_64.store_stack(-80, 0))
    call assembler.emit(output, x86_64.load_stack(7, -40))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "native_call_parent_wait")
    call assembler.emit(output, x86_64.load_stack(7, -56))
    call assembler.emit(output, x86_64.lea_base(6, 5, -72))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_WAIT4))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, -4))
    call assembler.relative(output, [15, 132], "native_call_parent_wait")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "native_call_sandbox_error")
    call assembler.emit(output, x86_64.load_stack(0, -80))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 8))
    call assembler.relative(output, [15, 133], "native_call_sandbox_error")
    call assembler.emit(output, x86_64.load_stack(0, -72))
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 127))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 133], "native_call_sandbox_error")
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, 255))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "native_call_sandbox_error")
    call assembler.emit(output, x86_64.load_stack(0, -64))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "native_call_fork_error")
    call assembler.emit(output, x86_64.load_stack(7, -48))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(7, -40))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.relative(output, [233], "native_call_sandbox_error")

    # Child: retain only fd 3, arm an alarm, then enter strict seccomp mode.
    # The native function can compute and return, but cannot open files,
    # allocate mappings, fork, signal another process or make network calls.
    call assembler.label(output, "native_call_child")
    call assembler.emit(output, x86_64.load_stack(7, -40))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(7, -48))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 3))
    call assembler.relative(output, [15, 132], "native_call_child_fd_ready")
    call assembler.emit(output, x86_64.mov_imm64(6, 3))
    call assembler.emit(output, x86_64.mov_imm64(2, 524288))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_DUP3))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "native_call_child_fail")
    call assembler.emit(output, x86_64.load_stack(7, -48))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "native_call_child_fd_ready")
    call assembler.emit(output, x86_64.mov_imm64(7, 4))
    call assembler.emit(output, x86_64.mov_imm64(6, 4294967295))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE_RANGE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "native_call_child_fail")
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(7, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(7, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_ALARM))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(7, 38))
    call assembler.emit(output, x86_64.mov_imm64(6, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_PRCTL))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "native_call_child_fail")
    call assembler.emit(output, x86_64.mov_imm64(7, 22))
    call assembler.emit(output, x86_64.mov_imm64(6, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_PRCTL))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "native_call_child_fail")

    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(11, 7, 8))
    call assembler.emit(output, x86_64.load_memory(10, 6, 24))
    # Slots are tagged Ints. Load payloads in reverse so base pointer may use r10.
    call assembler.emit(output, x86_64.load_memory(9, 10, 40))
    call assembler.emit(output, x86_64.load_memory(9, 9, 8))
    call assembler.emit(output, x86_64.load_memory(8, 10, 32))
    call assembler.emit(output, x86_64.load_memory(8, 8, 8))
    call assembler.emit(output, x86_64.load_memory(1, 10, 24))
    call assembler.emit(output, x86_64.load_memory(1, 1, 8))
    call assembler.emit(output, x86_64.load_memory(2, 10, 16))
    call assembler.emit(output, x86_64.load_memory(2, 2, 8))
    call assembler.emit(output, x86_64.load_memory(7, 10, 0))
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.load_memory(6, 10, 8))
    call assembler.emit(output, x86_64.load_memory(6, 6, 8))
    call assembler.emit(output, x86_64.call_reg(11))
    call assembler.emit(output, x86_64.store_stack(-64, 0))
    call assembler.label(output, "native_call_child_write")
    call assembler.emit(output, x86_64.mov_imm64(7, 3))
    call assembler.emit(output, x86_64.lea_base(6, 5, -64))
    call assembler.emit(output, x86_64.mov_imm64(2, 8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_WRITE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, -4))
    call assembler.relative(output, [15, 132], "native_call_child_write")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 8))
    call assembler.relative(output, [15, 133], "native_call_child_fail")
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_EXIT))
    call assembler.emit(output, x86_64.syscall())

    call assembler.label(output, "native_call_child_fail")
    call assembler.emit(output, x86_64.mov_imm64(7, 126))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_EXIT))
    call assembler.emit(output, x86_64.syscall())

    call assembler.label(output, "native_call_locked_invalid_arguments")
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.relative(output, [233], "native_call_invalid_arguments")
    call assembler.label(output, "native_call_locked_sandbox_error")
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.relative(output, [233], "native_call_sandbox_error")
    call assembler.label(output, "native_call_locked_closed")
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.relative(output, [233], "native_call_closed")
    call assembler.label(output, "native_call_invalid_arguments")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "native_call_arguments_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_call_sandbox_error")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "native_call_sandbox_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_call_closed")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "native_call_closed_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "native_call_closed_data")
    message = "NativeError: native library is closed"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
    call assembler.label(output, "native_call_sandbox_data")
    message = "NativeError: isolated native call failed or timed out"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
    call assembler.label(output, "native_call_arguments_data")
    message = "NativeError: native call requires exactly six Int arguments"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
    call assembler.label(output, "runtime_native_close")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_native_lock")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_native_library_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "native_close_invalid")
    call assembler.emit(output, x86_64.move_reg_reg(8, 7))
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "native_close_invalid")
    call assembler.emit(output, x86_64.load_memory(6, 8, 16))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MUNMAP))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "native_close_return")
    call assembler.emit(output, x86_64.store_memory_imm32(8, 8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(8, 16, 0))
    call assembler.relative(output, [233], "native_close_return")
    call assembler.label(output, "native_close_invalid")
    call assembler.emit(output, x86_64.mov_imm64(0, -22))
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.label(output, "native_close_return")
    call assembler.relative(output, [232], "runtime_native_unlock")
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_all(output):
    call emit_validation(output)
    call emit_open(output)
    call emit_access(output)
    call emit_call_close(output)
end
