    call assembler.relative(output, [15, 130], "get_string_seek_one")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 224))
    call assembler.relative(output, [15, 130], "get_string_seek_two")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 240))
