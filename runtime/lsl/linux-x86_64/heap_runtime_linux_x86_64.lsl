function emit_length(output):
    call assembler.label(output, "runtime_length")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "length_string")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "length_string")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.lea_base(11, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "length_string_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 8))
    call assembler.relative(output, [15, 141], "length_string_done")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 11, 9))
    call assembler.emit(output, x86_64.and_reg_imm8(0, 192))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 132], "length_string_continue")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.label(output, "length_string_continue")
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "length_string_loop")
    call assembler.label(output, "length_string_done")
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.ret())
end

function emit_get(output):
    call assembler.label(output, "runtime_get")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "runtime_get_string")
