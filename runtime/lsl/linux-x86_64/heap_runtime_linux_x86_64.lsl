# Checked collection entry points for the public Any ABI. The self-host
# compiler deliberately keeps its compact raw internal ABI and continues to
# use runtime_get/runtime_set/runtime_length directly. User programs use these
# dispatchers whenever the receiver's static type is Any, so an invalid value
# becomes a catchable LSL error before any object field is dereferenced.
function emit_dynamic_collections(output):
    call assembler.label(output, "runtime_dynamic_length")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 132], "dynamic_length_string")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 2))
    call assembler.relative(output, [15, 132], "dynamic_length_collection")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 3))
    call assembler.relative(output, [15, 132], "dynamic_length_collection")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 7))
    call assembler.relative(output, [15, 132], "dynamic_length_collection")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 8))
    call assembler.relative(output, [15, 132], "dynamic_length_collection")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 132], "dynamic_length_collection")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 14))
    call assembler.relative(output, [15, 132], "dynamic_length_collection")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 16))
    call assembler.relative(output, [15, 132], "dynamic_length_collection")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "dynamic_length_type_error")
    call assembler.label(output, "dynamic_length_collection")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dynamic_length_string")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_length")
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "dynamic_length_type_error", "dynamic_length_error_data", "TypeError: object has no length")

    # Iteration/private helpers may read Set slots, public indexing may not.
    # The loop bounds (or checked Set helper) establish the index invariant.
    call assembler.label(output, "runtime_iter_get")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 16))
    call assembler.relative(output, [15, 133], "iter_get_other")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_list_get")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "iter_get_other")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, [201])
    call assembler.relative(output, [233], "runtime_dynamic_get")

    call assembler.label(output, "runtime_dynamic_get")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 3))
    call assembler.relative(output, [15, 132], "dynamic_get_dict")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 132], "dynamic_get_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 2))
    call assembler.relative(output, [15, 132], "dynamic_get_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 7))
    call assembler.relative(output, [15, 132], "dynamic_get_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 8))
    call assembler.relative(output, [15, 132], "dynamic_get_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 132], "dynamic_get_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 14))
    call assembler.relative(output, [15, 132], "dynamic_get_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "dynamic_get_type_error")
    call assembler.label(output, "dynamic_get_index")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "dynamic_get_index_unbox")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 133], "dynamic_get_index_type_error")
    call assembler.label(output, "dynamic_get_index_unbox")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(6, 6, 8))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 133], "dynamic_get_length_field")
    call assembler.relative(output, [232], "runtime_length")
    call assembler.relative(output, [233], "dynamic_get_length_ready")
    call assembler.label(output, "dynamic_get_length_field")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.label(output, "dynamic_get_length_ready")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 141], "dynamic_get_nonnegative")
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call assembler.label(output, "dynamic_get_nonnegative")
    call assembler.emit(output, x86_64.store_stack(-16, 6))
