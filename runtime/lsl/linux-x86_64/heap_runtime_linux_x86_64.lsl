    call assembler.relative(output, [15, 141], "dynamic_get_bounds_error")
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 132], "dynamic_get_string")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 132], "dynamic_get_byte")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 132], "dynamic_get_int_array")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 14))
    call assembler.relative(output, [15, 132], "dynamic_get_float_array")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_list_get")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dynamic_get_string")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_get")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dynamic_get_byte")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_byte_array_get")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dynamic_get_int_array")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(7, 7, 24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_indexed(7, 7, 6, 3))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dynamic_get_float_array")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(7, 7, 24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_indexed(7, 7, 6, 3))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dynamic_get_dict")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_dict_get")
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_typed_error_return(output, "dynamic_get_type_error", "dynamic_get_type_error_data", "TypeError: object is not indexable", -8)
    call emit_typed_error_return(output, "dynamic_get_index_type_error", "dynamic_get_index_type_error_data", "TypeError: sequence index must be Int", -16)
    call emit_pending_error_return(output, "dynamic_get_bounds_error", "dynamic_get_bounds_error_data", "IndexError: index out of range")

    call assembler.label(output, "runtime_dynamic_set")
    call assembler.emit(output, x86_64.function_prologue(96))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 3))
    call assembler.relative(output, [15, 132], "dynamic_set_dict")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 2))
    call assembler.relative(output, [15, 132], "dynamic_set_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 8))
    call assembler.relative(output, [15, 132], "dynamic_set_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 13))
    call assembler.relative(output, [15, 132], "dynamic_set_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 14))
    call assembler.relative(output, [15, 132], "dynamic_set_index")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 15))
    call assembler.relative(output, [15, 133], "dynamic_set_type_error")
    call assembler.label(output, "dynamic_set_index")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "dynamic_set_index_unbox")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 133], "dynamic_set_index_type_error")
    call assembler.label(output, "dynamic_set_index_unbox")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(6, 6, 8))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 141], "dynamic_set_nonnegative")
    call assembler.emit(output, x86_64.add_reg_reg(6, 0))
    call assembler.label(output, "dynamic_set_nonnegative")
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "dynamic_set_bounds_error")
    call assembler.emit(output, x86_64.cmp_reg_reg(6, 0))
    call assembler.relative(output, [15, 141], "dynamic_set_bounds_error")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 2))
    call assembler.relative(output, [15, 132], "dynamic_set_list")
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 8))
    call assembler.relative(output, [15, 132], "dynamic_set_real_value")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 13))
    call assembler.relative(output, [15, 132], "dynamic_set_int_value")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 14))
    call assembler.relative(output, [15, 132], "dynamic_set_float_value")
    call assembler.relative(output, [233], "dynamic_set_byte_value")
    call assembler.label(output, "dynamic_set_real_value")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "dynamic_set_list")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 6))
    call assembler.relative(output, [15, 133], "dynamic_set_real_type_error")
    call assembler.relative(output, [233], "dynamic_set_list")
    call assembler.label(output, "dynamic_set_int_value")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 133], "dynamic_set_int_type_error")
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.load_memory(2, 2, 8))
    call assembler.relative(output, [233], "dynamic_set_list_raw")
