function emit_is_float(output):
    # reg7 = value -> reg0 = 1 if boxed Float (type 6), else 0.
    call assembler.label(output, "runtime_is_float")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "is_float_no")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 6))
    call assembler.relative(output, [15, 133], "is_float_no")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "is_float_no")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
end

function emit_coerce_float(output):
    # reg7 = value -> reg0 = boxed Float. Raw Int plus boxed Int/Bool are
    # promoted; an existing boxed Float is returned as-is. Public call sites
    # validate the tag before entering this low-level conversion helper.
    call assembler.label(output, "runtime_coerce_float")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "coerce_from_int")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
    call assembler.relative(output, [15, 132], "coerce_boxed_integer")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 4))
    call assembler.relative(output, [15, 133], "coerce_existing_float")
    call assembler.label(output, "coerce_boxed_integer")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.label(output, "coerce_from_int")
    call assembler.relative(output, [233], "runtime_float_from_int")
    call assembler.label(output, "coerce_existing_float")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.ret())
end

function emit_numeric_value_guard(output):
    call assembler.label(output, "runtime_require_numeric_value")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "numeric_value_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 132], "numeric_value_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "numeric_value_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 6))
    call assembler.relative(output, [15, 133], "numeric_value_maybe_zero")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 132], "numeric_value_valid")
    call assembler.relative(output, [233], "numeric_value_type_error")
    call assembler.label(output, "numeric_value_maybe_zero")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 5))
    call assembler.relative(output, [15, 133], "numeric_value_type_error")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "numeric_value_type_error")
    call assembler.label(output, "numeric_value_valid")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "numeric_value_type_error", "numeric_value_type_error_data", "TypeError: numeric operand required")
end

function emit_checked_index(output):
    # Public Any index -> raw signed Int. Bool follows the language's 0/1 index
    # convention; every other heap tag is rejected before bounds arithmetic.
    call assembler.label(output, "runtime_checked_index")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "checked_index_unbox")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 132], "checked_index_unbox")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "checked_index_raw")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 5))
    call assembler.relative(output, [15, 133], "checked_index_type_error")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "checked_index_done")
    call assembler.relative(output, [233], "checked_index_type_error")
    call assembler.label(output, "checked_index_unbox")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.relative(output, [233], "checked_index_done")
    call assembler.label(output, "checked_index_raw")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.label(output, "checked_index_done")
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_typed_error_return(output, "checked_index_type_error", "checked_index_type_error_data", "TypeError: sequence index must be Int", -8)
end

function emit_numeric_pair_guard(output):
    call assembler.label(output, "runtime_require_numeric_pair")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_type_code")
    call assembler.emit(output, x86_64.store_stack(-40, 0))

    # Mode 1 permits exactly String + String. Every mixed String/numeric pair
    # falls through to the numeric checks and is rejected.
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 1))
    call assembler.relative(output, [15, 133], "numeric_pair_check_left")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 133], "numeric_pair_check_left")
    call assembler.emit(output, x86_64.load_stack(0, -40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 1))
    call assembler.relative(output, [15, 132], "numeric_pair_valid")
    call assembler.relative(output, [233], "numeric_pair_type_error")

    call assembler.label(output, "numeric_pair_check_left")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "numeric_pair_check_right")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 132], "numeric_pair_check_right")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "numeric_pair_check_right")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 6))
    call assembler.relative(output, [15, 132], "numeric_pair_check_right")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 5))
    call assembler.relative(output, [15, 133], "numeric_pair_type_error")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "numeric_pair_type_error")

    call assembler.label(output, "numeric_pair_check_right")
    call assembler.emit(output, x86_64.load_stack(0, -40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 9))
    call assembler.relative(output, [15, 132], "numeric_pair_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 4))
    call assembler.relative(output, [15, 132], "numeric_pair_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "numeric_pair_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 6))
    call assembler.relative(output, [15, 133], "numeric_pair_right_maybe_zero")
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 2))
    call assembler.relative(output, [15, 133], "numeric_pair_valid")
    call assembler.relative(output, [233], "numeric_pair_type_error")
    call assembler.label(output, "numeric_pair_right_maybe_zero")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 5))
    call assembler.relative(output, [15, 133], "numeric_pair_type_error")
    call assembler.emit(output, x86_64.load_stack(0, -16))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "numeric_pair_type_error")

    call assembler.label(output, "numeric_pair_valid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "numeric_pair_type_error", "numeric_pair_type_error_data", "TypeError: numeric operands required")
end

function emit_abs_any(output):
    # reg7 = value -> reg0 = abs. Boxed Float clears the sign bit and reboxes;
    # raw Int negates when negative.
    call assembler.label(output, "runtime_abs_any")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "abs_any_int")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, 9223372036854775807))
    call assembler.emit(output, x86_64.and_reg_reg(7, 1))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "abs_any_int")
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 141], "abs_any_done")
    call assembler.emit(output, x86_64.neg_reg(0))
    call assembler.label(output, "abs_any_done")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_compare_any(output):
    # reg7=left, reg6=right -> reg0 = -1/0/1 (left <=> right). If either is a
    # boxed Float, both are coerced to double and compared; else signed Int.
    call assembler.label(output, "runtime_compare_any")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "compare_any_int")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.load_memory(0, 0, 8))
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.load_memory(1, 0, 8))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.compare_double(0, 1))
    call assembler.relative(output, [15, 130], "compare_any_less")
    call assembler.relative(output, [15, 132], "compare_any_equal")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "compare_any_less")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "compare_any_equal")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "compare_any_int")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 1))
    call assembler.relative(output, [15, 140], "compare_any_less")
    call assembler.relative(output, [15, 132], "compare_any_equal")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_neg_any(output):
    # reg7 = value -> reg0 = negation. Boxed Float flips its sign bit and
    # reboxes; raw Int negates.
    call assembler.label(output, "runtime_neg_any")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "neg_any_int")
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, -9223372036854775808))
    call assembler.emit(output, x86_64.add_reg_reg(7, 1))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "neg_any_int")
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.neg_reg(0))
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_pow_any(output):
    # reg7=base, reg6=Int exponent -> reg0. Boxed Float base uses float_power;
    # raw Int base uses int_power. Dynamic Int bases enforce the same negative
    # exponent error as statically typed Int expressions.
    call assembler.label(output, "runtime_pow_any")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.store_stack(-8, 6))
    call assembler.emit(output, x86_64.store_stack(-16, 7))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "pow_any_int")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_float_power")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "pow_any_int")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "pow_any_negative_int")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_int_power")
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "pow_any_negative_int")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "pow_any_negative_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "pow_any_negative_error_data")
    message = "ValueError: negative Int exponent"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_num_any(output, name, float_routine, is_add):
    # reg7,reg6 = operands. If either is a boxed Float, promote both to Float
    # and use float_routine (fixes mixed raw-Int + boxed-Float). Otherwise
    # raw Int op, or (add only) String concat when both are Strings.
    scalar_label = name + "_scalar"
    int_label = name + "_int"
    call assembler.label(output, name)
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_is_float")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.or_reg_reg(0, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], scalar_label)
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_coerce_float")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.relative(output, [232], float_routine)
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, scalar_label)
    if is_add:
        call assembler.emit(output, x86_64.load_stack(7, -8))
        call assembler.relative(output, [232], "runtime_is_heap_object")
        call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -8))
        call assembler.emit(output, x86_64.load_memory(1, 7, 0))
        call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -16))
        call assembler.relative(output, [232], "runtime_is_heap_object")
        call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -16))
        call assembler.emit(output, x86_64.load_memory(1, 7, 0))
        call assembler.emit(output, x86_64.cmp_reg_imm8(1, 9))
        call assembler.relative(output, [15, 132], int_label)
        call assembler.emit(output, x86_64.load_stack(7, -8))
        call assembler.emit(output, x86_64.load_stack(6, -16))
        call assembler.relative(output, [232], "runtime_string_concat")
        call assembler.emit(output, x86_64.function_epilogue())
    end
    call assembler.label(output, int_label)
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.load_stack(0, -24))
    if name == "runtime_add_any":
        call assembler.emit(output, x86_64.add_reg_reg(0, 1))
    elif name == "runtime_sub_any":
        call assembler.emit(output, x86_64.sub_reg_reg(0, 1))
    else:
        call assembler.emit(output, x86_64.imul_reg_reg(0, 1))
    end
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_box_int")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dynamic_raw_wrapper(output, name):
    call assembler.label(output, name + "_raw")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.relative(output, [232], name)
    call assembler.emit(output, x86_64.move_reg_reg(7, 0))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_int")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_contains(output):
    call assembler.label(output, "runtime_contains")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 132], "contains_string")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 3))
    call assembler.relative(output, [15, 132], "contains_dict")
    call assembler.emit(output, x86_64.load_memory(8, 7, 24))
    call assembler.relative(output, [233], "contains_ready")
    call assembler.label(output, "contains_string")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, [201])
    call assembler.relative(output, [233], "runtime_string_contains")
    call assembler.label(output, "contains_dict")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_dict_probe")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "contains_false")
    call assembler.relative(output, [233], "contains_true")
    call assembler.label(output, "contains_ready")
    call assembler.emit(output, x86_64.store_stack(-24, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.label(output, "contains_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "contains_false")
    call assembler.emit(output, x86_64.load_stack(8, -24))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 2, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "contains_true")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.relative(output, [233], "contains_loop")
    call assembler.label(output, "contains_false")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "contains_true")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

# Dictionary hash index: parallel keys@24/values@32 arrays stay in insertion
# order; index@40 is an open-addressed table of pos+1 slots (0 = empty),
# index_cap@48 slots (power of two, always >= 2*capacity). Hashes are seeded
# from the ASLR-randomized initial process stack so remote inputs cannot
# precompute a collision set and turn Dictionary/JSON insertion into quadratic
# work.
function emit_dict_hash(output):
    call assembler.label(output, "runtime_string_hash")
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.lea_base(8, 7, 16))
    call assembler.emit(output, x86_64.load_memory(0, 3, 120))
    call assembler.emit(output, x86_64.mov_imm64(10, 1099511628211))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "string_hash_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 1))
    call assembler.relative(output, [15, 141], "string_hash_done")
    call assembler.emit(output, x86_64.load_byte_indexed(2, 8, 9))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 2))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 10))
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "string_hash_loop")
    call assembler.label(output, "string_hash_done")
    call assembler.relative(output, [233], "runtime_hash_mix")
    # SplitMix64 finalizer. Besides distributing low Int bits over the
    # power-of-two table it prevents a chosen scalar collision set without the
    # per-process state address used as the key below.
    call assembler.label(output, "runtime_hash_mix")
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.shift_right_logical_imm(1, 30))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, -4658895280553007687))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 1))
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.shift_right_logical_imm(1, 27))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(1, -7723592293110705685))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 1))
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.shift_right_logical_imm(1, 31))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.emit(output, x86_64.ret())
    # Hashable dict key -> hash consistent with runtime_equal_any. Raw scalars
    # (Int/Bool/None/Function) and boxed scalar payloads are mixed with the
    # per-process seed; String bytes use seeded FNV-1a before the same mixer.
    # Navíc r11 = 1, když je klíč String (index slovníku podle toho porovnává
    # řetězce přímo); runtime_string_hash ani runtime_hash_mix r11 nemění.
    call assembler.label(output, "runtime_key_hash")
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.xor_reg_reg(11, 11))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "key_hash_heap")
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.load_memory(1, 3, 120))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.relative(output, [233], "runtime_hash_mix")
    call assembler.label(output, "key_hash_heap")
    call assembler.emit(output, x86_64.load_memory(1, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 133], "key_hash_heap_other")
    call assembler.emit(output, x86_64.mov_imm64(11, 1))
    call assembler.relative(output, [233], "runtime_string_hash")
    call assembler.label(output, "key_hash_heap_other")
    call assembler.emit(output, x86_64.load_memory(0, 7, 8))
    call assembler.emit(output, x86_64.load_memory(1, 3, 120))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 1))
    call assembler.relative(output, [233], "runtime_hash_mix")
end

# Položka indexu: bity 0-31 = pozice + 1 (0 = prázdný slot), bit 32 = klíč je
# String, bity 33-63 = horních 31 bitů hashe klíče. Slot se volí z týchž 31
# bitů. Sondování tak přeskočí kolize bez čtení klíčů a řetězce porovná přímo,
# bez dotazu do tabulky objektů (runtime_equal_any).
DICT_HASH = -40
DICT_STRING = -48

function emit_dict_entry_hash(output):
    # reg6 = klíč -> [rbp+DICT_HASH] = hash >> 33, [rbp+DICT_STRING] = příznak,
    # rax = počáteční slot (hash & maska), [rbp-24] = maska. reg7 = slovník
    # musí být uložený v [rbp-8].
    call assembler.emit(output, x86_64.move_reg_reg(7, 6))
    call assembler.relative(output, [232], "runtime_key_hash")
    call assembler.emit(output, x86_64.shift_right_logical_imm(0, 33))
    call assembler.emit(output, x86_64.store_stack(DICT_HASH, 0))
    call assembler.emit(output, x86_64.store_stack(DICT_STRING, 11))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 48))
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
end

function emit_dict_probe(output):
    # reg7=dict, reg6=key. Returns reg0=slot, reg1=pos+1 (0 if absent). When
    # absent with an index, reg0 is the empty slot for this key and reg2 the
    # entry without position (hash << 33 | String << 32) for runtime_dict_set.
    call assembler.label(output, "runtime_dict_probe")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "dict_probe_linear")
    call emit_dict_entry_hash(output)
    call assembler.label(output, "dict_probe_loop")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.test_reg_reg(1, 1))
    call assembler.relative(output, [15, 132], "dict_probe_empty")
    # Shoda 31 bitů hashe, jinak rovnou další slot.
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_right_logical_imm(2, 33))
    call assembler.emit(output, x86_64.load_stack(8, DICT_HASH))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 133], "dict_probe_next")
    # Kandidát: klíč na pozici (pos+1 v dolních 32 bitech).
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.shift_left_imm(2, 32))
    call assembler.emit(output, x86_64.shift_right_logical_imm(2, 32))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 2, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(7, 6))
    call assembler.relative(output, [15, 132], "dict_probe_found")
    # Příznaky String: oba -> přímé porovnání, různé -> nemůže se rovnat.
    call assembler.emit(output, x86_64.shift_right_logical_imm(1, 32))
    call assembler.emit(output, x86_64.logic_reg_imm(4, 1, 1))
    call assembler.emit(output, x86_64.load_stack(8, DICT_STRING))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 8))
    call assembler.relative(output, [15, 133], "dict_probe_next")
    call assembler.emit(output, x86_64.test_reg_reg(1, 1))
    call assembler.relative(output, [15, 132], "dict_probe_generic")
    call assembler.relative(output, [232], "runtime_string_equal")
    call assembler.relative(output, [233], "dict_probe_compared")
    call assembler.label(output, "dict_probe_generic")
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.label(output, "dict_probe_compared")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "dict_probe_found")
    call assembler.label(output, "dict_probe_next")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.relative(output, [233], "dict_probe_loop")
    call assembler.label(output, "dict_probe_found")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.shift_left_imm(1, 32))
    call assembler.emit(output, x86_64.shift_right_logical_imm(1, 32))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_probe_empty")
    call assembler.emit(output, x86_64.load_stack(2, DICT_HASH))
    call assembler.emit(output, x86_64.shift_left_imm(2, 33))
    call assembler.emit(output, x86_64.load_stack(1, DICT_STRING))
    call assembler.emit(output, x86_64.shift_left_imm(1, 32))
    call assembler.emit(output, x86_64.or_reg_reg(2, 1))
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    # No index yet (small dict): linear scan of insertion-order keys.
    call assembler.label(output, "dict_probe_linear")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "dict_probe_linear_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "dict_probe_linear_miss")
    call assembler.emit(output, x86_64.store_stack(-32, 2))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 2, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "dict_probe_linear_hit")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_probe_linear_loop")
    call assembler.label(output, "dict_probe_linear_hit")
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.emit(output, x86_64.move_reg_reg(1, 2))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_probe_linear_miss")
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_index_insert(output):
    # reg7=dict, reg6=key, reg2=pos. Stores the entry into the first empty slot.
    call assembler.label(output, "runtime_dict_index_insert")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-56, 2))
    call emit_dict_entry_hash(output)
    call assembler.label(output, "dict_insert_loop")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_indexed(1, 8, 0, 3))
    call assembler.emit(output, x86_64.test_reg_reg(1, 1))
    call assembler.relative(output, [15, 132], "dict_insert_store")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.increment(0))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.relative(output, [233], "dict_insert_loop")
    call assembler.label(output, "dict_insert_store")
    # entry = (hash >> 33) << 33 | příznak << 32 | (pos + 1)
    call assembler.emit(output, x86_64.load_stack(2, DICT_HASH))
    call assembler.emit(output, x86_64.shift_left_imm(2, 33))
    call assembler.emit(output, x86_64.load_stack(1, DICT_STRING))
    call assembler.emit(output, x86_64.shift_left_imm(1, 32))
    call assembler.emit(output, x86_64.or_reg_reg(2, 1))
    call assembler.emit(output, x86_64.load_stack(1, -56))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.or_reg_reg(2, 1))
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 2))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_reindex(output):
    # reg7=dict. Zero index_cap slots, then reinsert every key by position.
    call assembler.label(output, "runtime_dict_reindex")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.load_memory(9, 7, 48))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "dict_reindex_zero")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 9))
    call assembler.relative(output, [15, 141], "dict_reindex_zero_done")
    call assembler.emit(output, x86_64.store_indexed(8, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_reindex_zero")
    call assembler.label(output, "dict_reindex_zero_done")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-16, 2))
    call assembler.label(output, "dict_reindex_loop")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "dict_reindex_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(6, 9, 2, 3))
    call assembler.relative(output, [232], "runtime_dict_index_insert")
    call assembler.emit(output, x86_64.load_stack(2, -16))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.store_stack(-16, 2))
    call assembler.relative(output, [233], "dict_reindex_loop")
    call assembler.label(output, "dict_reindex_done")
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_new(output):
    call assembler.label(output, "runtime_dict_new")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.mov_imm64(7, 56))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, abi_x86_64.OBJECT_TAG, value_abi.TAG_DICTIONARY))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 16, 16))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 48, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 40, 0))
    call assembler.emit(output, x86_64.mov_imm64(7, 128))
    call assembler.relative(output, [232], "runtime_alloc_raw")
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(1, 24, 0))
    call assembler.emit(output, x86_64.mov_imm64(7, 128))
    call assembler.relative(output, [232], "runtime_alloc_raw")
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(1, 32, 0))
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_get(output):
    call assembler.label(output, "runtime_dict_get")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.relative(output, [232], "runtime_dict_probe")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "dict_get_missing")
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 32))
    call assembler.emit(output, x86_64.load_indexed(0, 8, 2, 3))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_get_missing")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "dict_get_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_get_error_data")
    message = "KeyError: key not found"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_dict_keys(output):
    call assembler.label(output, "runtime_dict_keys")
    call assembler.emit(output, x86_64.load_memory(6, 7, 24))
    call assembler.emit(output, x86_64.load_memory(7, 7, 8))
    call assembler.relative(output, [233], "runtime_list_new")
end

function emit_dict_delete(output):
    call assembler.label(output, "runtime_dict_delete")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "dict_delete_find")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 8))
    call assembler.relative(output, [15, 141], "dict_delete_missing")
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 9, 1, 3))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.relative(output, [232], "runtime_equal_any")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 133], "dict_delete_shift_start")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "dict_delete_find")
    call assembler.label(output, "dict_delete_shift_start")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.decrement(8))
    call assembler.emit(output, x86_64.store_memory(7, 8, 8))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.label(output, "dict_delete_shift")
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 8))
    call assembler.relative(output, [15, 141], "dict_delete_done")
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_memory(10, 7, 32))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.load_indexed(0, 9, 2, 3))
    call assembler.emit(output, x86_64.store_indexed(9, 1, 3, 0))
    call assembler.emit(output, x86_64.load_indexed(0, 10, 2, 3))
    call assembler.emit(output, x86_64.store_indexed(10, 1, 3, 0))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "dict_delete_shift")
    call assembler.label(output, "dict_delete_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "dict_delete_no_index")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_dict_reindex")
    call assembler.label(output, "dict_delete_no_index")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call emit_pending_error_return(output, "dict_delete_missing", "dict_delete_error_data", "KeyError: key not found")
end

function emit_dict_grow(output):
    call assembler.label(output, "runtime_dict_grow")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 16))
    call assembler.emit(output, x86_64.add_reg_reg(9, 9))
    call assembler.emit(output, x86_64.store_stack(-24, 9))
    call assembler.emit(output, x86_64.move_reg_reg(7, 9))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
    call assembler.relative(output, [232], "runtime_alloc_raw")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -24))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
    call assembler.relative(output, [232], "runtime_alloc_raw")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(10, 7, 24))
    call assembler.emit(output, x86_64.load_memory(11, 7, 32))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.label(output, "dict_grow_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "dict_grow_done")
    call assembler.emit(output, x86_64.load_indexed(0, 10, 2, 3))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.store_indexed(9, 2, 3, 0))
    call assembler.emit(output, x86_64.load_indexed(1, 11, 2, 3))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_indexed(9, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_grow_copy")
    call assembler.label(output, "dict_grow_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(9, -24))
    call assembler.emit(output, x86_64.store_memory(7, 16, 9))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.store_memory(7, 24, 9))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_memory(7, 32, 9))
    # Starý index a jeho velikost: položky nesou hash, takže se při růstu
    # přesunou bez čtení a hashování klíčů.
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 40))
    call assembler.emit(output, x86_64.store_stack(-48, 1))
    call assembler.emit(output, x86_64.load_memory(1, 7, 48))
    call assembler.emit(output, x86_64.store_stack(-56, 1))
    call assembler.emit(output, x86_64.load_stack(9, -24))
    call assembler.emit(output, x86_64.add_reg_reg(9, 9))
    call assembler.emit(output, x86_64.store_memory(7, 48, 9))
    call assembler.emit(output, x86_64.move_reg_reg(7, 9))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
    call assembler.relative(output, [232], "runtime_alloc_raw")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.store_memory(7, 40, 0))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.test_reg_reg(1, 1))
    call assembler.relative(output, [15, 133], "dict_grow_move")
    # První index (malý slovník bez indexu): klíče se zahashují.
    call assembler.relative(output, [232], "runtime_dict_reindex")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dict_grow_move")
    # r8 = nový index, r9 = maska, r10 = starý index, r11 = stará velikost.
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.emit(output, x86_64.load_memory(9, 7, 48))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "dict_grow_zero")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 9))
    call assembler.relative(output, [15, 141], "dict_grow_zero_done")
    call assembler.emit(output, x86_64.store_indexed(8, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_grow_zero")
    call assembler.label(output, "dict_grow_zero_done")
    call assembler.emit(output, x86_64.decrement(9))
    call assembler.emit(output, x86_64.load_stack(10, -48))
    call assembler.emit(output, x86_64.load_stack(11, -56))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "dict_grow_move_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 11))
    call assembler.relative(output, [15, 141], "dict_grow_move_done")
    call assembler.emit(output, x86_64.load_indexed(1, 10, 2, 3))
    call assembler.emit(output, x86_64.test_reg_reg(1, 1))
    call assembler.relative(output, [15, 132], "dict_grow_move_next")
    call assembler.emit(output, x86_64.move_reg_reg(0, 1))
    call assembler.emit(output, x86_64.shift_right_logical_imm(0, 33))
    call assembler.label(output, "dict_grow_move_probe")
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.emit(output, x86_64.load_indexed(7, 8, 0, 3))
    call assembler.emit(output, x86_64.test_reg_reg(7, 7))
    call assembler.relative(output, [15, 132], "dict_grow_move_store")
    call assembler.emit(output, x86_64.increment(0))
    call assembler.relative(output, [233], "dict_grow_move_probe")
    call assembler.label(output, "dict_grow_move_store")
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 1))
    call assembler.label(output, "dict_grow_move_next")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "dict_grow_move_loop")
    call assembler.label(output, "dict_grow_move_done")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_dict_set(output):
    call assembler.label(output, "runtime_dict_set")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.relative(output, [232], "runtime_dict_probe")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "dict_set_new")
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.relative(output, [233], "dict_set_store")
    call assembler.label(output, "dict_set_new")
    # Prázdný slot a hash z probe platí, dokud slovník neroste.
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.store_stack(-48, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_stack(-56, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 16))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 8))
    call assembler.relative(output, [15, 140], "dict_set_capacity_ready")
    call assembler.relative(output, [232], "runtime_dict_grow")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.store_stack(-56, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.label(output, "dict_set_capacity_ready")
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.store_indexed(9, 1, 3, 6))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 40))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 132], "dict_set_no_index")
    call assembler.emit(output, x86_64.load_stack(0, -56))
    call assembler.emit(output, x86_64.test_reg_reg(0, 0))
    call assembler.relative(output, [15, 133], "dict_set_reinsert")
    # Bez růstu: položka = hash a příznak z probe | pozice + 1, do prázdného slotu.
    call assembler.emit(output, x86_64.load_stack(2, -48))
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.or_reg_reg(2, 1))
    call assembler.emit(output, x86_64.load_stack(0, -40))
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 2))
    call assembler.relative(output, [233], "dict_set_no_index")
    call assembler.label(output, "dict_set_reinsert")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_stack(2, -32))
    call assembler.relative(output, [232], "runtime_dict_index_insert")
    call assembler.label(output, "dict_set_no_index")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_memory(7, 8, 1))
    call assembler.label(output, "dict_set_store")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 32))
    call assembler.emit(output, x86_64.load_stack(1, -32))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.store_indexed(9, 1, 3, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_string_chars(output):
    # String -> List of one-code-point Strings in a single O(n) pass, so the
    # lexer can index a List (O(1)) instead of re-scanning UTF-8 per access.
    # A per-call 128-slot cache interns ASCII chars: source is ~99% ASCII, so
    # this turns ~60k allocations into ~80 and lets equal strings share a
    # pointer (string_equal has a pointer-equality fast path).
    call assembler.label(output, "runtime_string_chars")
    call assembler.emit(output, x86_64.function_prologue(80))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(1, 7, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 1))
    call assembler.emit(output, x86_64.mov_imm64(7, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.relative(output, [232], "runtime_list_new")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.mov_imm64(7, 1024))
    call assembler.relative(output, [232], "runtime_alloc_raw")
    call assembler.emit(output, x86_64.store_stack(-56, 0))
    call assembler.emit(output, x86_64.move_reg_reg(8, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "chars_cache_zero")
    call assembler.emit(output, x86_64.cmp_reg_imm32(2, 128))
    call assembler.relative(output, [15, 141], "chars_cache_zeroed")
    call assembler.emit(output, x86_64.store_indexed(8, 2, 3, 9))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "chars_cache_zero")
    call assembler.label(output, "chars_cache_zeroed")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.label(output, "chars_loop")
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.load_stack(1, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "chars_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(8, 7, 16))
    call assembler.emit(output, x86_64.load_byte_indexed(0, 8, 2))
    call assembler.emit(output, x86_64.mov_imm64(1, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 128))
    call assembler.relative(output, [15, 130], "chars_width_ready")
    call assembler.emit(output, x86_64.mov_imm64(1, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 224))
    call assembler.relative(output, [15, 130], "chars_width_ready")
    call assembler.emit(output, x86_64.mov_imm64(1, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 240))
    call assembler.relative(output, [15, 130], "chars_width_ready")
    call assembler.emit(output, x86_64.mov_imm64(1, 4))
    call assembler.label(output, "chars_width_ready")
    call assembler.emit(output, x86_64.store_stack(-48, 1))
    call assembler.emit(output, x86_64.store_stack(-64, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 133], "chars_alloc")
    call assembler.emit(output, x86_64.load_stack(8, -56))
    call assembler.emit(output, x86_64.load_indexed(9, 8, 0, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 132], "chars_alloc")
    call assembler.emit(output, x86_64.store_stack(-40, 9))
    call assembler.relative(output, [233], "chars_append")
    call assembler.label(output, "chars_alloc")
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.move_reg_reg(7, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-40, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, abi_x86_64.OBJECT_TAG, value_abi.TAG_STRING))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.load_stack(6, -24))
    call assembler.emit(output, x86_64.lea_indexed(7, 7, 6, 0))
    call assembler.emit(output, x86_64.load_stack(10, -40))
    call assembler.emit(output, x86_64.lea_base(10, 10, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.label(output, "chars_copy")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "chars_copy_done")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "chars_copy")
    call assembler.label(output, "chars_copy_done")
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.store_byte_indexed(10, 1, 8))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 1))
    call assembler.relative(output, [15, 133], "chars_append")
    call assembler.emit(output, x86_64.load_stack(0, -64))
    call assembler.emit(output, x86_64.load_stack(8, -56))
    call assembler.emit(output, x86_64.load_stack(9, -40))
    call assembler.emit(output, x86_64.store_indexed(8, 0, 3, 9))
    call assembler.label(output, "chars_append")
    call assembler.emit(output, x86_64.load_stack(7, -32))
    call assembler.emit(output, x86_64.load_stack(6, -40))
    call assembler.relative(output, [232], "runtime_list_append")
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.emit(output, x86_64.load_stack(1, -48))
    call assembler.emit(output, x86_64.add_reg_reg(2, 1))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.relative(output, [233], "chars_loop")
    call assembler.label(output, "chars_done")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_float_array_kernels(output):
    # Contiguous Float64 kernels operate on raw backing bits and allocate only a
    # single boxed result (sum/dot), avoiding per-element language dispatch.
    # Binary CUDA transport helpers preserve all IEEE-754 bits and copy in O(n).
    call assembler.label(output, "runtime_float_array_bytes")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.store_stack(-8, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 9))
    call assembler.emit(output, x86_64.move_reg_reg(10, 8))
    call assembler.emit(output, x86_64.shift_left_imm(10, 3))
    call assembler.emit(output, x86_64.store_stack(-24, 10))
    call assembler.emit(output, x86_64.move_reg_reg(7, 10))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_memory_imm32(0, abi_x86_64.OBJECT_TAG, value_abi.TAG_STRING))
    call assembler.emit(output, x86_64.load_stack(10, -24))
    call assembler.emit(output, x86_64.store_memory(0, 8, 10))
    call assembler.emit(output, x86_64.load_stack(8, -8))
    call assembler.emit(output, x86_64.load_stack(9, -16))
    call assembler.emit(output, x86_64.lea_base(11, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "float_array_bytes_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "float_array_bytes_done")
    call assembler.emit(output, x86_64.load_indexed(1, 9, 2, 3))
    call assembler.emit(output, x86_64.store_indexed(11, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "float_array_bytes_loop")
    call assembler.label(output, "float_array_bytes_done")
    call assembler.emit(output, x86_64.load_stack(10, -24))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_byte_indexed(11, 10, 1))
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_float_array_from_bytes")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.shift_right_logical_imm(8, 3))
    call assembler.emit(output, x86_64.store_stack(-16, 8))
    call assembler.emit(output, x86_64.move_reg_reg(7, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.relative(output, [232], "runtime_list_new")
    call assembler.emit(output, x86_64.store_memory_imm32(0, abi_x86_64.OBJECT_TAG, value_abi.TAG_FLOAT_ARRAY))
    call assembler.emit(output, x86_64.store_stack(-24, 0))
    call assembler.emit(output, x86_64.load_stack(9, -8))
    call assembler.emit(output, x86_64.lea_base(9, 9, 16))
    call assembler.emit(output, x86_64.load_memory(10, 0, 24))
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "float_array_from_bytes_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "float_array_from_bytes_done")
    call assembler.emit(output, x86_64.load_indexed(1, 9, 2, 3))
    call assembler.emit(output, x86_64.store_indexed(10, 2, 3, 1))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "float_array_from_bytes_loop")
    call assembler.label(output, "float_array_from_bytes_done")
    call assembler.emit(output, x86_64.load_stack(0, -24))
    call assembler.emit(output, x86_64.function_epilogue())

    # FloatArray kernels use SSE2 two-lane packed doubles with a scalar tail.
    # float_sum/float_dot accumulate even and odd elements in separate lanes
    # and combine them at the end; float_axpy, float_fill and float_matmul
    # perform exactly the same per-element operations as a scalar loop.
    call assembler.label(output, "runtime_float_array_sum")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.unpack_low_packed(0, 0))
    call assembler.label(output, "float_array_sum_loop")
    call assembler.emit(output, x86_64.lea_base(0, 10, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 8))
    call assembler.relative(output, [15, 143], "float_array_sum_tail")
    call assembler.emit(output, x86_64.load_packed_indexed(1, 9, 10, 3))
    call assembler.emit(output, x86_64.add_packed(0, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(10, 2))
    call assembler.relative(output, [233], "float_array_sum_loop")
    call assembler.label(output, "float_array_sum_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 8))
    call assembler.relative(output, [15, 141], "float_array_sum_done")
    call assembler.emit(output, x86_64.load_indexed(1, 9, 10, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.add_double(0, 1))
    call assembler.label(output, "float_array_sum_done")
    call assembler.emit(output, x86_64.move_packed(1, 0))
    call assembler.emit(output, x86_64.unpack_high_packed(1, 1))
    call assembler.emit(output, x86_64.add_double(0, 1))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 0))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())

    call assembler.label(output, "runtime_float_array_dot")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.load_memory(10, 6, 24))
    call assembler.emit(output, x86_64.xor_reg_reg(11, 11))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(2, 0))
    call assembler.emit(output, x86_64.unpack_low_packed(2, 2))
    call assembler.label(output, "float_array_dot_loop")
    call assembler.emit(output, x86_64.lea_base(0, 11, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 8))
    call assembler.relative(output, [15, 143], "float_array_dot_tail")
    call assembler.emit(output, x86_64.load_packed_indexed(0, 9, 11, 3))
    call assembler.emit(output, x86_64.load_packed_indexed(1, 10, 11, 3))
    call assembler.emit(output, x86_64.mul_packed(0, 1))
    call assembler.emit(output, x86_64.add_packed(2, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(11, 2))
    call assembler.relative(output, [233], "float_array_dot_loop")
    call assembler.label(output, "float_array_dot_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(11, 8))
    call assembler.relative(output, [15, 141], "float_array_dot_done")
    call assembler.emit(output, x86_64.load_indexed(0, 9, 11, 3))
    call assembler.emit(output, x86_64.load_indexed(1, 10, 11, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.mul_double(0, 1))
    call assembler.emit(output, x86_64.add_double(2, 0))
    call assembler.label(output, "float_array_dot_done")
    call assembler.emit(output, x86_64.move_packed(1, 2))
    call assembler.emit(output, x86_64.unpack_high_packed(1, 1))
    call assembler.emit(output, x86_64.add_double(2, 1))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(7, 2))
    call assembler.relative(output, [232], "runtime_float_new")
    call assembler.emit(output, x86_64.function_epilogue())

    # r7=alpha bits, r6=x FloatArray, r2=y FloatArray; mutate y += alpha*x.
    call assembler.label(output, "runtime_float_array_axpy")
    call assembler.emit(output, x86_64.load_memory(8, 6, 8))
    call assembler.emit(output, x86_64.load_memory(9, 6, 24))
    call assembler.emit(output, x86_64.load_memory(10, 2, 24))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(2, 7))
    call assembler.emit(output, x86_64.unpack_low_packed(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(11, 11))
    call assembler.label(output, "float_array_axpy_loop")
    call assembler.emit(output, x86_64.lea_base(0, 11, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 8))
    call assembler.relative(output, [15, 143], "float_array_axpy_tail")
    call assembler.emit(output, x86_64.load_packed_indexed(0, 9, 11, 3))
    call assembler.emit(output, x86_64.mul_packed(0, 2))
    call assembler.emit(output, x86_64.load_packed_indexed(1, 10, 11, 3))
    call assembler.emit(output, x86_64.add_packed(1, 0))
    call assembler.emit(output, x86_64.store_packed_indexed(10, 11, 3, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(11, 2))
    call assembler.relative(output, [233], "float_array_axpy_loop")
    call assembler.label(output, "float_array_axpy_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(11, 8))
    call assembler.relative(output, [15, 141], "float_array_axpy_done")
    call assembler.emit(output, x86_64.load_indexed(0, 9, 11, 3))
    call assembler.emit(output, x86_64.load_indexed(1, 10, 11, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 1))
    call assembler.emit(output, x86_64.mul_double(0, 2))
    call assembler.emit(output, x86_64.add_double(1, 0))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(0, 1))
    call assembler.emit(output, x86_64.store_indexed(10, 11, 3, 0))
    call assembler.label(output, "float_array_axpy_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # r7=FloatArray, r6=raw Float64 bits.
    call assembler.label(output, "runtime_float_array_fill")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.load_memory(9, 7, 24))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 6))
    call assembler.emit(output, x86_64.unpack_low_packed(0, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "float_array_fill_loop")
    call assembler.emit(output, x86_64.lea_base(0, 10, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 8))
    call assembler.relative(output, [15, 143], "float_array_fill_tail")
    call assembler.emit(output, x86_64.store_packed_indexed(9, 10, 3, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(10, 2))
    call assembler.relative(output, [233], "float_array_fill_loop")
    call assembler.label(output, "float_array_fill_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 8))
    call assembler.relative(output, [15, 141], "float_array_fill_done")
    call assembler.emit(output, x86_64.store_indexed(9, 10, 3, 6))
    call assembler.label(output, "float_array_fill_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())

    # r7=a, r6=b, r2=m, r1=k, r8=n; return C[m,n] = A[m,k] * B[k,n].
    # Loop order i-k-j: each C row accumulates a[i,k] * B[k, j..j+1] with
    # packed doubles, in the same k order as the scalar inner product, so the
    # rounding of every element is identical to the sequential kernel.
    call assembler.label(output, "runtime_float_array_matmul")
    call assembler.emit(output, x86_64.function_prologue(96))
    call assembler.emit(output, x86_64.load_memory(0, 7, 24))
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.load_memory(0, 6, 24))
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.store_stack(-32, 1))
    call assembler.emit(output, x86_64.store_stack(-40, 8))
    call assembler.emit(output, x86_64.move_reg_reg(7, 2))
    call assembler.emit(output, x86_64.imul_reg_reg(7, 8))
    call assembler.emit(output, x86_64.store_stack(-64, 7))
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.relative(output, [232], "runtime_list_new")
    call assembler.emit(output, x86_64.store_memory_imm32(0, abi_x86_64.OBJECT_TAG, value_abi.TAG_FLOAT_ARRAY))
    call assembler.emit(output, x86_64.store_stack(-48, 0))
    call assembler.emit(output, x86_64.load_memory(1, 0, 24))
    call assembler.emit(output, x86_64.store_stack(-56, 1))
    # Zero the m*n result before accumulating.
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.load_stack(9, -64))
    call assembler.emit(output, x86_64.load_stack(7, -56))
    call assembler.label(output, "float_matmul_zero_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(8, 9))
    call assembler.relative(output, [15, 141], "float_matmul_zero_done")
    call assembler.emit(output, x86_64.store_indexed(7, 8, 3, 0))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "float_matmul_zero_loop")
    call assembler.label(output, "float_matmul_zero_done")
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.label(output, "float_matmul_i_loop")
    call assembler.emit(output, x86_64.load_stack(8, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(10, 8))
    call assembler.relative(output, [15, 141], "float_matmul_done")
    call assembler.emit(output, x86_64.xor_reg_reg(9, 9))
    call assembler.label(output, "float_matmul_k_loop")
    call assembler.emit(output, x86_64.load_stack(8, -32))
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 8))
    call assembler.relative(output, [15, 141], "float_matmul_i_next")
    # xmm2 = broadcast a[i, k]
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 8))
    call assembler.emit(output, x86_64.add_reg_reg(0, 9))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_indexed(1, 7, 0, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(2, 1))
    call assembler.emit(output, x86_64.unpack_low_packed(2, 2))
    # r8 = &B[k, 0], rcx = &C[i, 0], rdx = n
    call assembler.emit(output, x86_64.load_stack(2, -40))
    call assembler.emit(output, x86_64.move_reg_reg(0, 9))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 2))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.lea_indexed(8, 7, 0, 3))
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.imul_reg_reg(0, 2))
    call assembler.emit(output, x86_64.load_stack(7, -56))
    call assembler.emit(output, x86_64.lea_indexed(1, 7, 0, 3))
    call assembler.emit(output, x86_64.xor_reg_reg(11, 11))
    call assembler.label(output, "float_matmul_j_loop")
    call assembler.emit(output, x86_64.lea_base(0, 11, 2))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 2))
    call assembler.relative(output, [15, 143], "float_matmul_j_tail")
    call assembler.emit(output, x86_64.load_packed_indexed(0, 8, 11, 3))
    call assembler.emit(output, x86_64.mul_packed(0, 2))
    call assembler.emit(output, x86_64.load_packed_indexed(1, 1, 11, 3))
    call assembler.emit(output, x86_64.add_packed(1, 0))
    call assembler.emit(output, x86_64.store_packed_indexed(1, 11, 3, 1))
    call assembler.emit(output, x86_64.add_reg_imm8(11, 2))
    call assembler.relative(output, [233], "float_matmul_j_loop")
    call assembler.label(output, "float_matmul_j_tail")
    call assembler.emit(output, x86_64.cmp_reg_reg(11, 2))
    call assembler.relative(output, [15, 141], "float_matmul_k_next")
    call assembler.emit(output, x86_64.load_indexed(0, 8, 11, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(0, 0))
    call assembler.emit(output, x86_64.mul_double(0, 2))
    call assembler.emit(output, x86_64.load_indexed(0, 1, 11, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 0))
    call assembler.emit(output, x86_64.add_double(1, 0))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(0, 1))
    call assembler.emit(output, x86_64.store_indexed(1, 11, 3, 0))
    call assembler.label(output, "float_matmul_k_next")
    call assembler.emit(output, x86_64.increment(9))
    call assembler.relative(output, [233], "float_matmul_k_loop")
    call assembler.label(output, "float_matmul_i_next")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.relative(output, [233], "float_matmul_i_loop")
    call assembler.label(output, "float_matmul_done")
    call assembler.emit(output, x86_64.load_stack(0, -48))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_all(output):
    call emit_allocator(output)
    call emit_string_chars(output)
    call emit_object_table_growth(output)
    call emit_object_checks(output)
    call emit_parse_literal_int(output)
    call emit_int_power(output)
    call emit_float_power(output)
    call emit_string_concat(output)
    call emit_intern_table_growth(output)
    call emit_string_clone(output)
    call emit_float_runtime(output)
    call emit_float_array_kernels(output)
    call emit_boxed_scalars(output)
    call emit_gc(output)
    call emit_byte_array(output)
    call emit_list_new(output)
    call emit_list_append(output)
    call emit_list_pop_last(output)
    call emit_list_clear(output)
    call emit_set(output)
    call emit_list_set(output)
    call emit_list_get(output)
    call emit_length(output)
    call emit_get(output)
    call emit_dynamic_collections(output)
    call emit_string_byte_offset(output)
    call emit_slice(output)
    call emit_string_equal(output)
    call emit_string_contains(output)
    call emit_equal_any(output)
    call emit_is_float(output)
    call emit_coerce_float(output)
    call emit_numeric_value_guard(output)
    call emit_checked_index(output)
    call emit_numeric_pair_guard(output)
    call emit_abs_any(output)
    call emit_neg_any(output)
    call emit_compare_any(output)
    call emit_pow_any(output)
    call emit_num_any(output, "runtime_add_any", "runtime_float_add", True)
    call emit_num_any(output, "runtime_sub_any", "runtime_float_sub", False)
    call emit_num_any(output, "runtime_mul_any", "runtime_float_mul", False)
    call emit_dynamic_raw_wrapper(output, "runtime_abs_any")
    call emit_dynamic_raw_wrapper(output, "runtime_neg_any")
    call emit_dynamic_raw_wrapper(output, "runtime_pow_any")
    call emit_dynamic_raw_wrapper(output, "runtime_add_any")
    call emit_dynamic_raw_wrapper(output, "runtime_sub_any")
    call emit_dynamic_raw_wrapper(output, "runtime_mul_any")
    call emit_contains(output)
    call emit_dict_hash(output)
    call emit_dict_probe(output)
    call emit_dict_index_insert(output)
    call emit_dict_reindex(output)
    call emit_dict_new(output)
    call emit_dict_get(output)
    call emit_dict_keys(output)
    call emit_dict_delete(output)
    call emit_dict_grow(output)
    call emit_dict_set(output)
end

# Přesný převod w · 10^q (w bez znaménka, nejvýš 19 číslic) na bity binary64,
# zaokrouhleno na nejbližší (při shodě k sudé). rdi = w, rsi = q, rax = bity.
# Rychlá cesta (Clinger) pro w <= 2^53 a |q| <= 22, jinak Eisel-Lemire se
# 128bitovou tabulkou mocnin pěti (podle fast_float; pro binary64 a přesné w
# dokázaně postačuje). Nealokuje, mění jen volatilní registry.
function emit_decimal_bits(output):
    call assembler.label(output, "runtime_decimal_bits")
    call assembler.emit(output, x86_64.test_reg_reg(7, 7))
    call assembler.relative(output, [15, 132], "decimal_bits_zero")
    call assembler.emit(output, x86_64.cmp_reg_imm32(6, -342))
    call assembler.relative(output, [15, 140], "decimal_bits_zero")
    call assembler.emit(output, x86_64.cmp_reg_imm32(6, 308))
    call assembler.relative(output, [15, 143], "decimal_bits_infinity")
    # Clinger: přesné w a přesná mocnina deseti, jediné zaokrouhlení.
    call assembler.emit(output, x86_64.mov_imm64(0, 9007199254740992))
    call assembler.emit(output, x86_64.cmp_reg_reg(7, 0))
    call assembler.relative(output, [15, 135], "decimal_bits_lemire")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, -22))
    call assembler.relative(output, [15, 140], "decimal_bits_lemire")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 22))
    call assembler.relative(output, [15, 143], "decimal_bits_lemire")
    call assembler.emit(output, x86_64.int_to_double(0, 7))
    call assembler.emit(output, x86_64.move_reg_reg(8, 6))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 141], "decimal_bits_power_index")
    call assembler.emit(output, x86_64.neg_reg(8))
    call assembler.label(output, "decimal_bits_power_index")
    call assembler.relative(output, x86_64.lea_rip_prefix(9), "decimal_bits_powers_of_ten")
    call assembler.emit(output, x86_64.load_indexed(10, 9, 8, 3))
    call assembler.emit(output, x86_64.movq_xmm_from_reg(1, 10))
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 140], "decimal_bits_divide")
    call assembler.emit(output, x86_64.mul_double(0, 1))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "decimal_bits_divide")
    call assembler.emit(output, x86_64.div_double(0, 1))
    call assembler.emit(output, x86_64.movq_reg_from_xmm(0, 0))
    call assembler.emit(output, x86_64.ret())

    call assembler.label(output, "decimal_bits_lemire")
    # r8 = lz, rdi = w << lz
    call assembler.emit(output, x86_64.bit_scan_reverse(1, 7))
    call assembler.emit(output, x86_64.mov_imm64(8, 63))
    call assembler.emit(output, x86_64.sub_reg_reg(8, 1))
    call assembler.emit(output, x86_64.move_reg_reg(1, 8))
    call assembler.emit(output, x86_64.shift_left_cl(7))
    # r9 = &tabulka[q + 342]
    call assembler.relative(output, x86_64.lea_rip_prefix(9), "decimal_bits_table")
    call assembler.emit(output, x86_64.move_reg_reg(10, 6))
    call assembler.emit(output, x86_64.add_reg_imm32(10, 342))
    call assembler.emit(output, x86_64.shift_left_imm(10, 4))
    call assembler.emit(output, x86_64.add_reg_reg(9, 10))
    # První součin w · horní půlka: r10 = high, r11 = low.
    call assembler.emit(output, x86_64.load_memory(10, 9, 0))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.multiply_unsigned(10))
    call assembler.emit(output, x86_64.move_reg_reg(10, 2))
    call assembler.emit(output, x86_64.move_reg_reg(11, 0))
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.logic_reg_imm(4, 0, 511))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 511))
    call assembler.relative(output, [15, 133], "decimal_bits_product_ready")
    # Málo přesnosti: přičíst horní část součinu w · dolní půlka.
    call assembler.emit(output, x86_64.load_memory(2, 9, 8))
    call assembler.emit(output, x86_64.move_reg_reg(0, 7))
    call assembler.emit(output, x86_64.multiply_unsigned(2))
    call assembler.emit(output, x86_64.add_reg_reg(11, 2))
    call assembler.relative(output, [15, 131], "decimal_bits_product_ready")
    call assembler.emit(output, x86_64.increment(10))
    call assembler.label(output, "decimal_bits_product_ready")
    # rdx = upperbit, rax = mantissa = high >> (upperbit + 9)
    call assembler.emit(output, x86_64.move_reg_reg(2, 10))
    call assembler.emit(output, x86_64.shift_right_logical_imm(2, 63))
    call assembler.emit(output, x86_64.move_reg_reg(1, 2))
    call assembler.emit(output, x86_64.add_reg_imm8(1, 9))
    call assembler.emit(output, x86_64.move_reg_reg(0, 10))
    call assembler.emit(output, x86_64.shift_right_logical_cl(0))
    # r8 = power2 = ((217706 · q) >> 16) + 63 + upperbit - lz + 1023
    call assembler.emit(output, x86_64.imul_reg_imm(1, 6, 217706))
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(1, 16))
    call assembler.emit(output, x86_64.add_reg_imm32(1, 63 + 1023))
    call assembler.emit(output, x86_64.add_reg_reg(1, 2))
    call assembler.emit(output, x86_64.sub_reg_reg(1, 8))
    call assembler.emit(output, x86_64.move_reg_reg(8, 1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 0))
    call assembler.relative(output, [15, 143], "decimal_bits_normal")
    # Subnormální výsledek: posun o 1 - power2, zaokrouhlit, bity = mantisa.
    call assembler.emit(output, x86_64.mov_imm64(1, 1))
    call assembler.emit(output, x86_64.sub_reg_reg(1, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 64))
    call assembler.relative(output, [15, 141], "decimal_bits_zero")
    call assembler.emit(output, x86_64.shift_right_logical_cl(0))
    call assembler.emit(output, x86_64.move_reg_reg(9, 0))
    call assembler.emit(output, x86_64.logic_reg_imm(4, 9, 1))
    call assembler.emit(output, x86_64.add_reg_reg(0, 9))
    call assembler.emit(output, x86_64.shift_right_logical_imm(0, 1))
    call assembler.emit(output, x86_64.ret())

    call assembler.label(output, "decimal_bits_normal")
    # Přesná polovina: při low <= 1, q v [-4, 23] a mantisa & 3 == 1 rozhodne
    # shoda posunuté mantisy s horní částí součinu (zaokrouhlení k sudé).
    call assembler.emit(output, x86_64.cmp_reg_imm8(11, 1))
    call assembler.relative(output, [15, 135], "decimal_bits_round")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, -4))
    call assembler.relative(output, [15, 140], "decimal_bits_round")
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 23))
    call assembler.relative(output, [15, 143], "decimal_bits_round")
    call assembler.emit(output, x86_64.move_reg_reg(9, 0))
    call assembler.emit(output, x86_64.logic_reg_imm(4, 9, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 1))
    call assembler.relative(output, [15, 133], "decimal_bits_round")
    call assembler.emit(output, x86_64.move_reg_reg(9, 0))
    call assembler.emit(output, x86_64.move_reg_reg(1, 2))
    call assembler.emit(output, x86_64.add_reg_imm8(1, 9))
    call assembler.emit(output, x86_64.shift_left_cl(9))
    call assembler.emit(output, x86_64.cmp_reg_reg(9, 10))
    call assembler.relative(output, [15, 133], "decimal_bits_round")
    call assembler.emit(output, x86_64.logic_reg_imm(4, 0, -2))
    call assembler.label(output, "decimal_bits_round")
    call assembler.emit(output, x86_64.move_reg_reg(9, 0))
    call assembler.emit(output, x86_64.logic_reg_imm(4, 9, 1))
    call assembler.emit(output, x86_64.add_reg_reg(0, 9))
    call assembler.emit(output, x86_64.shift_right_logical_imm(0, 1))
    call assembler.emit(output, x86_64.mov_imm64(9, 9007199254740992))
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 9))
    call assembler.relative(output, [15, 130], "decimal_bits_pack")
    call assembler.emit(output, x86_64.mov_imm64(0, 4503599627370496))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.label(output, "decimal_bits_pack")
    call assembler.emit(output, x86_64.mov_imm64(9, 4503599627370495))
    call assembler.emit(output, x86_64.and_reg_reg(0, 9))
    call assembler.emit(output, x86_64.cmp_reg_imm32(8, 2047))
    call assembler.relative(output, [15, 141], "decimal_bits_infinity")
    call assembler.emit(output, x86_64.shift_left_imm(8, 52))
    call assembler.emit(output, x86_64.or_reg_reg(0, 8))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "decimal_bits_zero")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.ret())
    call assembler.label(output, "decimal_bits_infinity")
    call assembler.emit(output, x86_64.mov_imm64(0, 9218868437227405312))
    call assembler.emit(output, x86_64.ret())

    # Přesné mocniny deseti 10^0 až 10^22 jako binary64.
    call assembler.label(output, "decimal_bits_powers_of_ten")
    # Násobení ve Floatu je přesné až do 10^22 (Int by od 10^19 přetekl).
    power = 1.0
    for index in rang(23):
        data = []
        call bytes.append_little(data, __lsl_float_bits(power), 8)
        call assembler.emit(output, data)
        power *= 10.0
    end
    # Tabulka mocnin pěti: pro každé q horní a dolní 64 bitů (little-endian).
    call assembler.label(output, "decimal_bits_table")
    hex_digits = "0123456789abcdef"
    for entry in rang(decimal_powers.POWER_COUNT):
        for half in rang(2):
            start = entry * 32 + half * 16
            data = []
            for pair in rang(8):
                position = start + (7 - pair) * 2
                data.append(hex_digits.find(decimal_powers.POWERS_HEX[position]) * 16 + hex_digits.find(decimal_powers.POWERS_HEX[position + 1]))
            end
            call assembler.emit(output, data)
        end
    end
end

# Přesné porovnání desítkového a binárního zápisu: rax = znaménko (R - L),
#   L = left · 10^max(q,0) · 2^max(-e,0), R = right · 10^max(-q,0) · 2^max(e,0)
# runtime_decimal_compare: rdi = left, rsi = q, rdx = right, rcx = e
# (left, right < 2^63; formátovač). runtime_decimal_digits_compare:
# rdi = ByteArray číslic (hodnoty 0-9), rsi = jejich počet (nejvýš 801),
# rdx = q, rcx = right, r8 = e (přesné čtení dlouhých zápisů). Čísla jsou na
# zásobníku v 64bitových limbech (nejvýš DC_LIMBS), nic se nealokuje.
DC_POINTER = -8
DC_E = -16
DC_LEFT_LENGTH = -24
DC_RIGHT_LENGTH = -32
DC_COUNT = -40
DC_Q = -48
DC_LIMBS = 80
DC_LEFT = -696
DC_RIGHT = -1336
DC_FRAME = 1344

# buffer = buffer · faktor + r8: r9 = buffer, rsi = adresa délky, r11 =
# faktor, r8 = přičtená hodnota (bez znaménka). Přenos buffer prodlouží
# (nejvýš na DC_LIMBS). Mění rax, rcx, rdx, r8, r10.
function emit_decimal_multiply(output):
    call assembler.label(output, "runtime_decimal_multiply")
    call assembler.emit(output, x86_64.load_memory(10, 6, 0))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "dm_loop")
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 10))
    call assembler.relative(output, [15, 141], "dm_carry")
    call assembler.emit(output, x86_64.load_indexed(0, 9, 1, 3))
    call assembler.emit(output, x86_64.multiply_unsigned(11))
    call assembler.emit(output, x86_64.add_reg_reg(0, 8))
    call assembler.relative(output, [15, 131], "dm_no_overflow")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.label(output, "dm_no_overflow")
    call assembler.emit(output, x86_64.store_indexed(9, 1, 3, 0))
    call assembler.emit(output, x86_64.move_reg_reg(8, 2))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "dm_loop")
    call assembler.label(output, "dm_carry")
    call assembler.emit(output, x86_64.test_reg_reg(8, 8))
    call assembler.relative(output, [15, 132], "dm_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(10, DC_LIMBS))
    call assembler.relative(output, [15, 141], "dm_done")
    call assembler.emit(output, x86_64.store_indexed(9, 10, 3, 8))
    call assembler.emit(output, x86_64.increment(10))
    call assembler.emit(output, x86_64.store_memory(6, 0, 10))
    call assembler.label(output, "dm_done")
    call assembler.emit(output, x86_64.ret())
end

# buffer *= base^rdi po blocích (10^18 nebo 2^63), zbytek malou mocninou;
# r9 = buffer, rsi = adresa délky.
function emit_decimal_scale(output, base):
    name = "runtime_decimal_scale_" + String(base)
    block = 1000000000000000000
    block_count = 18
    if base == 2:
        block = -9223372036854775807 - 1
        block_count = 63
    end
    call assembler.label(output, name)
    call assembler.label(output, name + "_block")
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, block_count))
    call assembler.relative(output, [15, 140], name + "_rest")
    call assembler.emit(output, x86_64.add_reg_imm8(7, -block_count))
    call assembler.emit(output, x86_64.mov_imm64(11, block))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.relative(output, [232], "runtime_decimal_multiply")
    call assembler.relative(output, [233], name + "_block")
    call assembler.label(output, name + "_rest")
    call assembler.emit(output, x86_64.mov_imm64(11, 1))
    call assembler.label(output, name + "_power")
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 142], name + "_apply")
    call assembler.emit(output, x86_64.imul_reg_imm(11, 11, base))
    call assembler.emit(output, x86_64.decrement(7))
    call assembler.relative(output, [233], name + "_power")
    call assembler.label(output, name + "_apply")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.relative(output, [233], "runtime_decimal_multiply")
end

function emit_decimal_scale_call(output, buffer, length_slot, base):
    call assembler.emit(output, x86_64.lea_base(9, 5, buffer))
    call assembler.emit(output, x86_64.lea_base(6, 5, length_slot))
    call assembler.relative(output, [232], "runtime_decimal_scale_" + String(base))
end

function emit_decimal_compare(output):
    call emit_decimal_multiply(output)
    call emit_decimal_scale(output, 10)
    call emit_decimal_scale(output, 2)
    call assembler.label(output, "runtime_decimal_digits_compare")
    call assembler.emit(output, x86_64.function_prologue(DC_FRAME))
    # Obsah ByteArray leží za ukazatelem na offsetu 24.
    call assembler.emit(output, x86_64.load_memory(7, 7, 24))
    call assembler.emit(output, x86_64.store_stack(DC_POINTER, 7))
    call assembler.emit(output, x86_64.store_stack(DC_COUNT, 6))
    call assembler.emit(output, x86_64.store_stack(DC_Q, 2))
    call assembler.emit(output, x86_64.store_stack(DC_RIGHT, 1))
    call assembler.emit(output, x86_64.store_stack(DC_E, 8))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_stack(DC_LEFT, 0))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.store_stack(DC_LEFT_LENGTH, 0))
    call assembler.emit(output, x86_64.store_stack(DC_RIGHT_LENGTH, 0))
    # left = left · 10^k + blok až 18 číslic, dokud číslice zbývají.
    call assembler.label(output, "dc_digits_block")
    call assembler.emit(output, x86_64.load_stack(0, DC_COUNT))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "dc_scale_decimal")
    call assembler.emit(output, x86_64.load_stack(7, DC_POINTER))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.mov_imm64(11, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.label(output, "dc_digits_next")
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 18))
    call assembler.relative(output, [15, 141], "dc_digits_flush")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 142], "dc_digits_flush")
    call assembler.emit(output, x86_64.load_byte_zero_extend(2, 7, 0))
    call assembler.emit(output, x86_64.imul_reg_imm(8, 8, 10))
    call assembler.emit(output, x86_64.add_reg_reg(8, 2))
    call assembler.emit(output, x86_64.imul_reg_imm(11, 11, 10))
    call assembler.emit(output, x86_64.increment(7))
    call assembler.emit(output, x86_64.decrement(0))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.relative(output, [233], "dc_digits_next")
    call assembler.label(output, "dc_digits_flush")
    call assembler.emit(output, x86_64.store_stack(DC_COUNT, 0))
    call assembler.emit(output, x86_64.store_stack(DC_POINTER, 7))
    call assembler.emit(output, x86_64.lea_base(9, 5, DC_LEFT))
    call assembler.emit(output, x86_64.lea_base(6, 5, DC_LEFT_LENGTH))
    call assembler.relative(output, [232], "runtime_decimal_multiply")
    call assembler.relative(output, [233], "dc_digits_block")

    call assembler.label(output, "runtime_decimal_compare")
    call assembler.emit(output, x86_64.function_prologue(DC_FRAME))
    call assembler.emit(output, x86_64.store_stack(DC_Q, 6))
    call assembler.emit(output, x86_64.store_stack(DC_E, 1))
    call assembler.emit(output, x86_64.store_stack(DC_LEFT, 7))
    call assembler.emit(output, x86_64.store_stack(DC_RIGHT, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.store_stack(DC_LEFT_LENGTH, 0))
    call assembler.emit(output, x86_64.store_stack(DC_RIGHT_LENGTH, 0))
    # 10^|q| na stranu podle znaménka q.
    call assembler.label(output, "dc_scale_decimal")
    call assembler.emit(output, x86_64.load_stack(7, DC_Q))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "dc_decimal_right")
    call emit_decimal_scale_call(output, DC_LEFT, DC_LEFT_LENGTH, 10)
    call assembler.relative(output, [233], "dc_binary")
    call assembler.label(output, "dc_decimal_right")
    call assembler.emit(output, x86_64.neg_reg(7))
    call emit_decimal_scale_call(output, DC_RIGHT, DC_RIGHT_LENGTH, 10)
    call assembler.label(output, "dc_binary")
    call assembler.emit(output, x86_64.load_stack(7, DC_E))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "dc_binary_left")
    call emit_decimal_scale_call(output, DC_RIGHT, DC_RIGHT_LENGTH, 2)
    call assembler.relative(output, [233], "dc_compare")
    call assembler.label(output, "dc_binary_left")
    call assembler.emit(output, x86_64.neg_reg(7))
    call emit_decimal_scale_call(output, DC_LEFT, DC_LEFT_LENGTH, 2)
    # Porovnání od nejvyššího limbu (kratší číslo doplněné nulami).
    call assembler.label(output, "dc_compare")
    call assembler.emit(output, x86_64.load_stack(10, DC_LEFT_LENGTH))
    call assembler.emit(output, x86_64.load_stack(11, DC_RIGHT_LENGTH))
    call assembler.emit(output, x86_64.move_reg_reg(1, 10))
    call assembler.emit(output, x86_64.cmp_reg_reg(11, 1))
    call assembler.relative(output, [15, 142], "dc_length_ready")
    call assembler.emit(output, x86_64.move_reg_reg(1, 11))
    call assembler.label(output, "dc_length_ready")
    call assembler.emit(output, x86_64.lea_base(8, 5, DC_LEFT))
    call assembler.emit(output, x86_64.lea_base(9, 5, DC_RIGHT))
    call assembler.label(output, "dc_compare_loop")
    call assembler.emit(output, x86_64.decrement(1))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 140], "dc_equal")
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 10))
    call assembler.relative(output, [15, 141], "dc_left_limb_ready")
    call assembler.emit(output, x86_64.load_indexed(6, 8, 1, 3))
    call assembler.label(output, "dc_left_limb_ready")
    call assembler.emit(output, x86_64.xor_reg_reg(7, 7))
    call assembler.emit(output, x86_64.cmp_reg_reg(1, 11))
    call assembler.relative(output, [15, 141], "dc_right_limb_ready")
    call assembler.emit(output, x86_64.load_indexed(7, 9, 1, 3))
    call assembler.label(output, "dc_right_limb_ready")
    call assembler.emit(output, x86_64.cmp_reg_reg(7, 6))
    call assembler.relative(output, [15, 132], "dc_compare_loop")
    call assembler.relative(output, [15, 135], "dc_greater")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dc_greater")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "dc_equal")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

# Je skutečná hodnota bitů blíž vyššímu z kandidátů c a c + 1 (count číslic,
# exponent první číslice)? rdi = c, rsi = count, rdx = exponent, rcx = bity;
# rax = 1/0. Při přesné polovině vyhraje sudý kandidát (jako repr).
function emit_float_nearer_upper(output):
    call assembler.label(output, "runtime_float_nearer_upper")
    call assembler.emit(output, x86_64.function_prologue(16))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    # q = exponent - count + 1
    call assembler.emit(output, x86_64.sub_reg_reg(2, 6))
    call assembler.emit(output, x86_64.add_reg_imm8(2, 1))
    call assembler.emit(output, x86_64.move_reg_reg(6, 2))
    # mantisa a binární exponent z bitů
    call assembler.emit(output, x86_64.move_reg_reg(8, 1))
    call assembler.emit(output, x86_64.shift_right_logical_imm(8, 52))
    call assembler.emit(output, x86_64.logic_reg_imm(4, 8, 2047))
    call assembler.emit(output, x86_64.mov_imm64(9, 4503599627370495))
    call assembler.emit(output, x86_64.and_reg_reg(1, 9))
    call assembler.emit(output, x86_64.mov_imm64(10, -1074))
    call assembler.emit(output, x86_64.test_reg_reg(8, 8))
    call assembler.relative(output, [15, 132], "nearer_upper_subnormal")
    call assembler.emit(output, x86_64.mov_imm64(9, 4503599627370496))
    call assembler.emit(output, x86_64.add_reg_reg(1, 9))
    call assembler.emit(output, x86_64.move_reg_reg(10, 8))
    call assembler.emit(output, x86_64.add_reg_imm32(10, -1075))
    call assembler.label(output, "nearer_upper_subnormal")
    # left = 2c + 1, right = 2m, e = binární exponent
    call assembler.emit(output, x86_64.add_reg_reg(7, 7))
    call assembler.emit(output, x86_64.increment(7))
    call assembler.emit(output, x86_64.add_reg_reg(1, 1))
    call assembler.emit(output, x86_64.move_reg_reg(2, 1))
    call assembler.emit(output, x86_64.move_reg_reg(1, 10))
    call assembler.relative(output, [232], "runtime_decimal_compare")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 143], "nearer_upper_yes")
    call assembler.relative(output, [15, 140], "nearer_upper_no")
    call assembler.emit(output, x86_64.load_stack(0, -8))
    call assembler.emit(output, x86_64.logic_reg_imm(4, 0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "nearer_upper_yes")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "nearer_upper_no")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end
