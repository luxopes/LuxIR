    call assembler.emit(output, x86_64.store_stack(-136, 8))
    call assembler.relative(output, [233], "capture_stderr_read_loop")
    call assembler.label(output, "capture_stderr_limit")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "capture_limit_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.relative(output, [233], "capture_stderr_read_done")
    call assembler.label(output, "capture_stderr_read_error")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "capture_io_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.label(output, "capture_stderr_read_done")
    call assembler.emit(output, x86_64.load_stack(7, -120))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(0, -128))
    call assembler.emit(output, x86_64.load_stack(1, -136))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.lea_base(8, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 1, 2))
    call assembler.emit(output, x86_64.store_memory(3, 72, 0))
    call assembler.emit(output, x86_64.load_stack(0, -80))
    call assembler.emit(output, x86_64.load_stack(1, -88))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.lea_base(8, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(8, 1, 2))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "capture_argument_error")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "capture_argument_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "capture_setup_close_all")
    call assembler.emit(output, x86_64.load_stack(7, -184))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "capture_setup_input_closed")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "capture_setup_input_closed")
    call assembler.emit(output, x86_64.load_stack(7, -120))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "capture_setup_close_pipe")
    call assembler.emit(output, x86_64.load_stack(7, -64))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(7, -72))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "capture_setup_error")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "capture_setup_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "capture_child")
    # Close inherited parent-only pipe endpoints before dup2 can reuse the same
    # descriptor number (important when the caller entered with fd 0/1 closed).
    call assembler.emit(output, x86_64.load_stack(7, -64))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.load_stack(7, -184))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "capture_child_input_ready")
    call assembler.relative(output, [15, 132], "capture_child_input_ready")
    call assembler.emit(output, x86_64.xor_reg_reg(6, 6))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_DUP2))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "capture_child_setup_error")
    call assembler.emit(output, x86_64.load_stack(7, -184))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "capture_child_input_ready")
    call assembler.emit(output, x86_64.load_stack(7, -72))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 1))
    call assembler.relative(output, [15, 132], "capture_child_stdout_ready")
    call assembler.emit(output, x86_64.mov_imm64(6, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_DUP2))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "capture_child_setup_error")
    call assembler.emit(output, x86_64.load_stack(7, -72))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "capture_child_stdout_ready")
    call assembler.emit(output, x86_64.load_stack(7, -120))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 2))
    call assembler.relative(output, [15, 132], "capture_child_stderr_ready")
    call assembler.emit(output, x86_64.mov_imm64(6, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_DUP2))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "capture_child_setup_error")
    call assembler.emit(output, x86_64.load_stack(7, -120))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "capture_child_stderr_ready")
    # pipe2/memfd_create use CLOEXEC. Normally dup2 clears it on descriptors
    # 0..2, but when the caller entered with those descriptors closed a new
    # endpoint can already have the target number and dup2 is intentionally
    # skipped above. Clear CLOEXEC explicitly on every endpoint we installed.
    call assembler.emit(output, x86_64.load_stack(7, -184))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 140], "capture_child_stdout_flags")
    call emit_clear_capture_cloexec(output, 0)
    call assembler.label(output, "capture_child_stdout_flags")
    call emit_clear_capture_cloexec(output, 1)
    call emit_clear_capture_cloexec(output, 2)
    # Keep only stdin/stdout/stderr after the controlled dup2 operations.
    call assembler.emit(output, x86_64.mov_imm64(7, 3))
    call assembler.emit(output, x86_64.mov_imm64(6, 4294967295))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE_RANGE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "capture_child_setup_error")
    # Bound regular-file output (including the stderr memfd). Captured tools
    # may inherit a stricter updater/sandbox limit; never raise either limit.
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.lea_base(6, 5, -216))
    call assembler.emit(output, x86_64.mov_imm64(0, 97))  # Linux x86_64 getrlimit
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "capture_child_setup_error")
    call assembler.emit(output, x86_64.load_stack(0, -216))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 134217728))
    call assembler.relative(output, [15, 134], "capture_child_file_soft_ready")
    call assembler.emit(output, x86_64.mov_imm64(0, 134217728))
    call assembler.emit(output, x86_64.store_stack(-216, 0))
    call assembler.label(output, "capture_child_file_soft_ready")
    call assembler.emit(output, x86_64.load_stack(0, -208))
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 134217728))
    call assembler.relative(output, [15, 134], "capture_child_file_hard_ready")
    call assembler.emit(output, x86_64.mov_imm64(0, 134217728))
    call assembler.emit(output, x86_64.store_stack(-208, 0))
    call assembler.label(output, "capture_child_file_hard_ready")
    call assembler.emit(output, x86_64.mov_imm64(7, 1))
    call assembler.emit(output, x86_64.lea_base(6, 5, -216))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_SETRLIMIT))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "capture_child_setup_error")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_stack(-216, 0))
    call assembler.emit(output, x86_64.store_stack(-208, 0))
    call assembler.emit(output, x86_64.mov_imm64(7, 4))
    call assembler.emit(output, x86_64.lea_base(6, 5, -216))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_SETRLIMIT))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "capture_child_setup_error")
    call assembler.emit(output, x86_64.load_stack(0, -192))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "capture_child_privileges_ready")
    call assembler.emit(output, x86_64.mov_imm64(7, 38))
    call assembler.emit(output, x86_64.mov_imm64(6, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_PRCTL))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "capture_child_setup_error")
    call assembler.label(output, "capture_child_privileges_ready")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.emit(output, x86_64.load_stack(2, -192))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 133], "capture_child_clean_environment")
    # envp sits after argc and the NULL-terminated argv on the original
    # process stack (state+120).
    call assembler.emit(output, x86_64.load_memory(11, 3, 120))
    call assembler.emit(output, x86_64.load_memory(2, 11, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(2, 2))
    call assembler.emit(output, x86_64.shift_left_imm(2, 3))
    call assembler.emit(output, x86_64.add_reg_reg(2, 11))
    call assembler.relative(output, [233], "capture_child_environment_ready")
    call assembler.label(output, "capture_child_clean_environment")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "capture_child_environment_ready")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_EXECVE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.mov_imm64(7, 127))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_EXIT))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "capture_child_setup_error")
    call assembler.emit(output, x86_64.mov_imm64(7, 126))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_EXIT))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "capture_stderr_name")
    call assembler.emit(output, [108, 115, 108, 45, 115, 116, 100, 101, 114, 114, 0])
    call assembler.label(output, "capture_stdin_name")
    call assembler.emit(output, [108, 115, 108, 45, 115, 116, 100, 105, 110, 0])
    call emit_process_error_data(output, "capture_setup_error_data", "ProcessError: capture setup failed")
    call emit_process_error_data(output, "capture_argument_error_data", "ProcessError: invalid executable, argument or input")
    call emit_process_error_data(output, "capture_io_error_data", "ProcessError: capture I/O failed")
    call emit_process_error_data(output, "capture_limit_error_data", "ProcessError: captured process output exceeds the secure limit")
end

function emit_test_fd_fault(output):
    # Test-only deterministic fault injection: lower RLIMIT_NOFILE to 32,
    # exhaust it with memfd descriptors, then free `slots` highest descriptors.
    # slots=0 makes pipe fail; slots=2 lets pipe succeed and memfd fail.
    call assembler.label(output, "runtime_test_fd_fault")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.store_stack(-24, 7))
    call assembler.emit(output, x86_64.mov_imm64(0, 32))
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_stack(-16, 0))
    call assembler.emit(output, x86_64.mov_imm64(7, 7))
    call assembler.emit(output, x86_64.lea_base(6, 5, -16))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_SETRLIMIT))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "test_fd_fault_failed")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.mov_imm64(9, -1))
    call assembler.label(output, "test_fd_fault_open")
    call assembler.relative(output, x86_64.lea_rip_prefix(7), "test_fd_fault_name")
    call assembler.emit(output, x86_64.mov_imm64(6, 1))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_MEMFD_CREATE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "test_fd_fault_close")
    call assembler.emit(output, x86_64.move_reg_reg(9, 0))
    call assembler.emit(output, x86_64.increment(8))
    call assembler.relative(output, [233], "test_fd_fault_open")
    call assembler.label(output, "test_fd_fault_close")
    call assembler.emit(output, x86_64.store_stack(-32, 8))
    call assembler.emit(output, x86_64.load_stack(2, -24))
    call assembler.label(output, "test_fd_fault_close_loop")
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 142], "test_fd_fault_done")
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 3))
    call assembler.relative(output, [15, 140], "test_fd_fault_done")
    call assembler.emit(output, x86_64.move_reg_reg(7, 9))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.decrement(9))
    call assembler.emit(output, x86_64.decrement(2))
    call assembler.relative(output, [233], "test_fd_fault_close_loop")
    call assembler.label(output, "test_fd_fault_done")
    call assembler.emit(output, x86_64.load_stack(0, -32))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "test_fd_fault_failed")
    call assembler.emit(output, x86_64.mov_imm64(0, -1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "test_fd_fault_name")
    call assembler.emit(output, [108, 115, 108, 45, 102, 100, 45, 102, 97, 117, 108, 116, 0])
end

function emit_capture_status(output):
    call assembler.label(output, "runtime_capture_status")
    call assembler.emit(output, x86_64.load_memory(0, 3, 64))
    call assembler.emit(output, x86_64.ret())
end

function emit_capture_stderr(output):
    call assembler.label(output, "runtime_capture_stderr")
    call assembler.emit(output, x86_64.load_memory(0, 3, 72))
    call assembler.emit(output, x86_64.ret())
end

function emit_all(output):
    call emit_process_validation(output)
    call emit_run(output)
    call emit_executable_path(output)
    call emit_getenv(output)
    call emit_stream_callback(output)
    call emit_capture(output)
    call emit_test_fd_fault(output)
    call emit_capture_status(output)
    call emit_capture_stderr(output)
end
