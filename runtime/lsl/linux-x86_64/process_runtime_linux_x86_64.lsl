# lsl: internal-abi
# Linux x86_64 fork/execve/wait4 boundary for pure-LSL tools.

load runtime_abi_linux_x86_64 as abi_x86_64
load _platform_linux_x86_64 as platform
load assembler_x86_64 as assembler
load bytes
load x86_64

function emit_process_validation(output):
    # rdi=dynamic value. Accept only a live String without embedded NUL and
    # within Linux MAX_ARG_STRLEN (including the runtime's trailing NUL).
    call assembler.label(output, "runtime_process_string_valid")
    call assembler.emit(output, x86_64.function_prologue(32))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "process_string_invalid")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(8, 1))
    call assembler.relative(output, [15, 133], "process_string_invalid")
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm32(8, 131071))
    call assembler.relative(output, [15, 143], "process_string_invalid")
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "process_string_scan")
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "process_string_valid")
    call assembler.emit(output, x86_64.load_byte_indexed(1, 7, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "process_string_invalid")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "process_string_scan")
    call assembler.label(output, "process_string_valid")
    call assembler.emit(output, x86_64.mov_imm64(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "process_string_invalid")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_clear_capture_cloexec(output, descriptor):
    call assembler.emit(output, x86_64.mov_imm64(7, descriptor) + x86_64.mov_imm64(6, 2) + x86_64.xor_reg_reg(2, 2) + x86_64.mov_imm64(0, platform.SYS_FCNTL) + x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "capture_child_setup_error")
end

function emit_process_error_data(output, label, message):
    encoded = bytes.utf8(message)
    call assembler.label(output, label)
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(encoded), 8))
    call assembler.emit(output, encoded)
    call assembler.emit(output, [0])
end

function emit_run(output):
    call assembler.label(output, "runtime_run")
    call assembler.emit(output, x86_64.function_prologue(96))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    # r8 selects an empty environment for security-sensitive child processes.
    call assembler.emit(output, x86_64.store_stack(-48, 8))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_process_string_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "run_process_error")
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.relative(output, [232], "runtime_is_heap_object")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "run_process_error")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(0, 6, 0))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 2))
    call assembler.relative(output, [15, 133], "run_process_error")
    call assembler.emit(output, x86_64.load_memory(8, 6, 8))
    call assembler.emit(output, x86_64.cmp_reg_imm32(8, 4096))
    call assembler.relative(output, [15, 143], "run_process_error")
    call assembler.emit(output, x86_64.store_stack(-24, 8))
    call assembler.emit(output, x86_64.move_reg_reg(7, 8))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 2))
    call assembler.emit(output, x86_64.shift_left_imm(7, 3))
    call assembler.relative(output, [232], "runtime_alloc_raw")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.store_memory(9, 0, 7))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "run_argv_loop")
    call assembler.emit(output, x86_64.load_stack(8, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "run_argv_done")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(10, 6, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 10, 2, 3))
    call assembler.emit(output, x86_64.push(2))
    call assembler.relative(output, [232], "runtime_process_string_valid")
    call assembler.emit(output, x86_64.pop(2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "run_process_error")
    call assembler.emit(output, x86_64.load_stack(6, -16))
    call assembler.emit(output, x86_64.load_memory(10, 6, 24))
    call assembler.emit(output, x86_64.load_indexed(7, 10, 2, 3))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.move_reg_reg(1, 2))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.store_indexed(9, 1, 3, 7))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "run_argv_loop")
    call assembler.label(output, "run_argv_done")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.load_stack(9, -32))
    call assembler.emit(output, x86_64.store_indexed(9, 2, 3, 1))
    call assembler.relative(output, [232], "stdin_release")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_FORK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "run_child")
    call assembler.relative(output, [15, 140], "run_process_error")
    call assembler.emit(output, x86_64.store_stack(-72, 0))
    call assembler.label(output, "run_wait_retry")
    call assembler.emit(output, x86_64.load_stack(7, -72))
    call assembler.emit(output, x86_64.xor_reg_reg(1, 1))
    call assembler.emit(output, x86_64.store_stack(-40, 1))
    call assembler.emit(output, x86_64.lea_base(6, 5, -40))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_WAIT4))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, -4))
    call assembler.relative(output, [15, 132], "run_wait_retry")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "run_process_error")
    call assembler.emit(output, x86_64.load_stack(0, -40))
    call assembler.emit(output, x86_64.move_reg_reg(1, 0))
    call assembler.emit(output, x86_64.and_reg_imm8(1, 127))
    call assembler.emit(output, x86_64.cmp_reg_imm8(1, 0))
    call assembler.relative(output, [15, 132], "run_process_exited")
    call assembler.emit(output, x86_64.move_reg_reg(0, 1))
    call assembler.emit(output, x86_64.add_reg_imm32(0, 128))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "run_process_exited")
    call assembler.emit(output, x86_64.shift_right_arithmetic_imm(0, 8))
    call assembler.emit(output, x86_64.mov_imm64(1, 255))
    call assembler.emit(output, x86_64.and_reg_reg(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "run_process_error")
    call assembler.emit(output, x86_64.mov_imm64(0, 126))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "run_child")
    # Child processes must not inherit supervisor sockets, secret memfds or
    # other descriptors supplied to the LSL parent.
    call assembler.emit(output, x86_64.mov_imm64(7, 3))
    call assembler.emit(output, x86_64.mov_imm64(6, 4294967295))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_CLOSE_RANGE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "run_child_setup_error")
    # Disable core dumps before exec so argv/environment material cannot be
    # persisted by a crashing child.
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.store_stack(-64, 0))
    call assembler.emit(output, x86_64.store_stack(-56, 0))
    call assembler.emit(output, x86_64.mov_imm64(7, 4))
    call assembler.emit(output, x86_64.lea_base(6, 5, -64))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_SETRLIMIT))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "run_child_setup_error")
    call assembler.emit(output, x86_64.load_stack(0, -48))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "run_child_privileges_ready")
    call assembler.emit(output, x86_64.mov_imm64(7, 38))
    call assembler.emit(output, x86_64.mov_imm64(6, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.xor_reg_reg(10, 10))
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_PRCTL))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "run_child_setup_error")
    call assembler.label(output, "run_child_privileges_ready")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.load_stack(6, -32))
    call assembler.emit(output, x86_64.load_stack(2, -48))
    call assembler.emit(output, x86_64.cmp_reg_imm8(2, 0))
    call assembler.relative(output, [15, 133], "run_child_clean_environment")
    # envp sits after argc and the NULL-terminated argv on the original
    # process stack (state+120).
    call assembler.emit(output, x86_64.load_memory(11, 3, 120))
    call assembler.emit(output, x86_64.load_memory(2, 11, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(2, 2))
    call assembler.emit(output, x86_64.shift_left_imm(2, 3))
    call assembler.emit(output, x86_64.add_reg_reg(2, 11))
    call assembler.relative(output, [233], "run_child_environment_ready")
    call assembler.label(output, "run_child_clean_environment")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "run_child_environment_ready")
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_EXECVE))
    call assembler.emit(output, x86_64.syscall())
    call assembler.label(output, "run_child_setup_error")
    call assembler.emit(output, x86_64.mov_imm64(7, 127))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_EXIT))
    call assembler.emit(output, x86_64.syscall())
end

function emit_executable_path(output):
    call assembler.label(output, "runtime_executable_path")
    call assembler.emit(output, x86_64.function_prologue(48))
    call assembler.emit(output, x86_64.mov_imm64(7, 4113))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-8, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.relative(output, x86_64.lea_rip_prefix(7), "executable_path_name")
    call assembler.emit(output, x86_64.load_stack(6, -8))
    call assembler.emit(output, x86_64.lea_base(6, 6, 16))
    call assembler.emit(output, x86_64.mov_imm64(2, 4096))
    call assembler.emit(output, x86_64.mov_imm64(0, platform.SYS_READLINK))
    call assembler.emit(output, x86_64.syscall())
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 140], "executable_path_error")
    call assembler.emit(output, x86_64.cmp_reg_imm32(0, 4096))
    call assembler.relative(output, [15, 141], "executable_path_error")
    call assembler.emit(output, x86_64.load_stack(1, -8))
    call assembler.emit(output, x86_64.store_memory(1, 8, 0))
    call assembler.emit(output, x86_64.lea_base(6, 1, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 0, 2))
    call assembler.emit(output, x86_64.move_reg_reg(0, 1))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "executable_path_error")
    call assembler.relative(output, x86_64.lea_rip_prefix(11), "executable_path_error_data")
    call assembler.emit(output, x86_64.store_fs(abi_x86_64.TLS_ERROR, 11))
    call assembler.emit(output, x86_64.store_fs_imm32(abi_x86_64.TLS_ERROR_FLAG, 1))
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "executable_path_name")
    call assembler.emit(output, [47, 112, 114, 111, 99, 47, 115, 101, 108, 102, 47, 101, 120, 101, 0])
    call assembler.label(output, "executable_path_error_data")
    message = "FileError: cannot resolve executable path"
    call assembler.emit(output, bytes.little(1, 8))
    call assembler.emit(output, bytes.little(len(bytes.utf8(message)), 8))
    call assembler.emit(output, bytes.utf8(message))
    call assembler.emit(output, [0])
end

function emit_getenv(output):
    call assembler.label(output, "runtime_getenv")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.relative(output, [232], "runtime_process_string_valid")
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 0))
    call assembler.relative(output, [15, 132], "getenv_missing")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.load_memory(8, 7, 8))
    call assembler.emit(output, x86_64.store_stack(-16, 8))
    call assembler.emit(output, x86_64.load_memory(11, 3, 120))
    call assembler.emit(output, x86_64.load_memory(1, 11, 0))
    call assembler.emit(output, x86_64.add_reg_imm8(1, 2))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.label(output, "getenv_entry_loop")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.load_memory(11, 3, 120))
    call assembler.emit(output, x86_64.load_indexed(9, 11, 1, 3))
    call assembler.emit(output, x86_64.cmp_reg_imm8(9, 0))
    call assembler.relative(output, [15, 132], "getenv_missing")
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "getenv_name_loop")
    call assembler.emit(output, x86_64.load_stack(8, -16))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 8))
    call assembler.relative(output, [15, 141], "getenv_name_done")
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.emit(output, x86_64.lea_base(7, 7, 16))
    call assembler.emit(output, x86_64.load_byte_indexed(0, 7, 2))
    call assembler.emit(output, x86_64.load_byte_indexed(6, 9, 2))
    # A longer requested name must not read beyond the environment C string.
    call assembler.emit(output, x86_64.cmp_reg_imm8(6, 0))
    call assembler.relative(output, [15, 132], "getenv_next_entry")
    call assembler.emit(output, x86_64.cmp_reg_reg(0, 6))
    call assembler.relative(output, [15, 133], "getenv_next_entry")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "getenv_name_loop")
    call assembler.label(output, "getenv_name_done")
    call assembler.emit(output, x86_64.load_byte_indexed(0, 9, 2))
    call assembler.emit(output, x86_64.cmp_reg_imm8(0, 61))
    call assembler.relative(output, [15, 133], "getenv_next_entry")
    call assembler.emit(output, x86_64.increment(2))
    call assembler.emit(output, x86_64.lea_indexed(7, 9, 2, 0))
    call assembler.relative(output, [232], "runtime_from_cstring")
    call assembler.emit(output, x86_64.function_epilogue())
    call assembler.label(output, "getenv_next_entry")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.increment(1))
    call assembler.emit(output, x86_64.store_stack(-24, 1))
    call assembler.relative(output, [233], "getenv_entry_loop")
    call assembler.label(output, "getenv_missing")
    call assembler.emit(output, x86_64.mov_imm64(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_stream_callback(output):
    # rdi=tagged Function (or 0), rsi=byte pointer, rdx=length.
    call assembler.label(output, "runtime_capture_callback")
    call assembler.emit(output, x86_64.function_prologue(64))
    call assembler.emit(output, x86_64.cmp_reg_imm8(7, 0))
    call assembler.relative(output, [15, 132], "capture_callback_done")
    call assembler.emit(output, x86_64.cmp_fs_imm8(abi_x86_64.TLS_ERROR_FLAG, 0))
    call assembler.relative(output, [15, 133], "capture_callback_done")
    call assembler.emit(output, x86_64.store_stack(-8, 7))
    call assembler.emit(output, x86_64.store_stack(-16, 6))
    call assembler.emit(output, x86_64.store_stack(-24, 2))
    call assembler.emit(output, x86_64.move_reg_reg(7, 2))
    call assembler.emit(output, x86_64.add_reg_imm8(7, 17))
    call assembler.relative(output, [232], "runtime_alloc")
    call assembler.emit(output, x86_64.store_stack(-32, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(0, 0, 1))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.store_memory(0, 8, 1))
    call assembler.emit(output, x86_64.load_stack(7, -16))
    call assembler.emit(output, x86_64.lea_base(6, 0, 16))
    call assembler.emit(output, x86_64.xor_reg_reg(2, 2))
    call assembler.label(output, "capture_callback_copy")
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.cmp_reg_reg(2, 1))
    call assembler.relative(output, [15, 141], "capture_callback_ready")
    call assembler.emit(output, x86_64.load_byte_indexed(8, 7, 2))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 2, 8))
    call assembler.emit(output, x86_64.increment(2))
    call assembler.relative(output, [233], "capture_callback_copy")
    call assembler.label(output, "capture_callback_ready")
    call assembler.emit(output, x86_64.xor_reg_reg(8, 8))
    call assembler.emit(output, x86_64.load_stack(1, -24))
    call assembler.emit(output, x86_64.store_byte_indexed(6, 1, 8))
    call assembler.emit(output, x86_64.load_stack(7, -8))
    call assembler.relative(output, [232], "runtime_unbox_dynamic_function")
    call assembler.emit(output, x86_64.move_reg_reg(11, 0))
    call assembler.emit(output, x86_64.load_stack(7, -32))
    call assembler.emit(output, x86_64.call_reg(11))
    call assembler.label(output, "capture_callback_done")
    call assembler.emit(output, x86_64.xor_reg_reg(0, 0))
    call assembler.emit(output, x86_64.function_epilogue())
end

function emit_capture(output):
    call assembler.label(output, "runtime_capture")
    call assembler.emit(output, x86_64.function_prologue(256))
    # Error paths must not expose status/stderr from a previous capture.
    call assembler.emit(output, x86_64.mov_imm64(0, 126))
    call assembler.emit(output, x86_64.store_memory(3, 64, 0))
    call assembler.emit(output, x86_64.store_memory_imm32(3, 72, 0))
    call assembler.emit(output, x86_64.store_stack(-8, 7))
