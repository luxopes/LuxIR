    Int64(result) = call luxrt_syscall6(Int64(52), fd, address, length, Int64(0), Int64(0), Int64(0))
    return result
end

export function luxrt_os_setsockopt(Int64(fd), Int64(level), Int64(option), Ptr(value), Int64(length)) -> Int64:
    Int64(result) = call luxrt_syscall6(Int64(54), fd, level, option, value, length, Int64(0))
    return result
end

export function luxrt_os_getsockopt(Int64(fd), Int64(level), Int64(option), Ptr(value), Ptr(length)) -> Int64:
    Int64(result) = call luxrt_syscall6(Int64(55), fd, level, option, value, length, Int64(0))
    return result
end

export function luxrt_os_poll(Ptr(fds), Int64(count), Ptr(timeout)) -> Int64:
    Int64(result) = call luxrt_syscall6(Int64(271), fds, count, timeout, Int64(0), Int64(0), Int64(0))
    return result
end

export function luxrt_os_ioctl(Int64(fd), Int64(request), Ptr(argument)) -> Int64:
    Int64(result) = call luxrt_syscall6(Int64(16), fd, request, argument, Int64(0), Int64(0), Int64(0))
    return result
end

export function luxrt_os_futex(Ptr(address), Int64(operation), Int64(value), Ptr(timeout), Ptr(address2), Int64(value3)) -> Int64:
    Int64(result) = call luxrt_syscall6(Int64(202), address, operation, value, timeout, address2, value3)
    return result
end

export function luxrt_os_fork() -> Int64:
    Int64(result) = call luxrt_syscall6(Int64(57), Int64(0), Int64(0), Int64(0), Int64(0), Int64(0), Int64(0))
    return result
end
