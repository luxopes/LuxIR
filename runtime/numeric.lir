export function luxrt_string_to_int(Int64(.1), Int64(.3), Int64(.5)) -> Int32:
start.1:
    Int64(.2) = alloc8(8)
    store(.1, .2)
    Int64(.4) = alloc8(8)
    store(.3, .4)
    Int64(.6) = alloc8(8)
    store(.5, .6)
    Int64(.7) = alloc8(8)
    Int64(.8) = alloc8(8)
    Int64(.9) = alloc8(8)
    Int64(.10) = alloc8(8)
    Int64(.11) = alloc8(8)
    Int64(.12) = alloc4(4)
body.2:
    Int64(.13) = load(.4)
    Int32(.14) = call extern(luxrt_string_info)(Int64(.13), Int64(.7), Int64(.8), Int64(.10), Int64(.9))
    store(.14, .12)
    Int32(.15) = load_i32(.12)
    if .15 goto if_true.3 else if_false.4
if_true.3:
    Int32(.16) = load_i32(.12)
    return .16
if_false.4:
    Int64(.17) = load(.10)
    Int64(.18) = load(.7)
    Int32(.19) = call extern(luxrt_parse_i64)(Int64(.17), Int64(.18), Int64(.11))
    store(.19, .12)
    Int32(.20) = load_i32(.12)
    if .20 goto cond_true.5 else cond_false.6
cond_true.5:
    Int32(.21) = load_i32(.12)
    goto cond_join.7
cond_false.6:
    Int64(.22) = load(.2)
    Int64(.23) = load(.11)
    Int64(.24) = load(.6)
    Int32(.25) = call extern(luxrt_value_int)(Int64(.22), Int64(.23), Int64(.24))
cond_join.7:
    Int32(.26) = phi(cond_true.5: .21, cond_false.6: .25)
    return .26
end

