ir_version "1"
runtime_abi "none"
export function luxrt_read_full(Int64(fd), Ptr(buffer), Int64(size), Ptr(count)) -> Int64:
    store(Int64(0), count)
    Int32(too_big) = ugt(size, 9223372036854775807)
    if too_big goto range else loop
loop:
    Int64(total) = load(count)
    Int32(done) = eq(total, size)
    if done goto success else transfer
transfer:
    Ptr(at) = add(buffer, total)
    Int64(remaining) = sub(size, total)
    Int64(n) = call luxrt_os_read(fd, at, remaining)
    Int32(interrupted) = eq(n, -4)
    if interrupted goto loop else result
result:
    Int32(failed) = lt(n, 0)
    if failed goto error else progress
progress:
    Int32(zero) = eq(n, 0)
    if zero goto stalled else update
update:
    Int64(total) = add(total, n)
    store(total, count)
    goto loop
error:
    return n
range:
    return -34
stalled:
    return 0
success:
    return 0
end
export function luxrt_write_full(Int64(fd), Ptr(buffer), Int64(size), Ptr(count)) -> Int64:
    store(Int64(0), count)
    Int32(too_big) = ugt(size, 9223372036854775807)
    if too_big goto range else loop
loop:
    Int64(total) = load(count)
    Int32(done) = eq(total, size)
    if done goto success else transfer
transfer:
    Ptr(at) = add(buffer, total)
    Int64(remaining) = sub(size, total)
    Int64(n) = call luxrt_os_write(fd, at, remaining)
    Int32(interrupted) = eq(n, -4)
    if interrupted goto loop else result
result:
    Int32(failed) = lt(n, 0)
    if failed goto error else progress
progress:
    Int32(zero) = eq(n, 0)
    if zero goto stalled else update
update:
    Int64(total) = add(total, n)
    store(total, count)
    goto loop
error:
    return n
range:
    return -34
stalled:
    return -5
success:
    return 0
end
