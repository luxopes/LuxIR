q_string_2571 = mem.literal("/* LuxIR c32 */\n#include <stdint.h>\n_Static_assert(sizeof(void *) == 4, \"LuxIR c32 output needs a 32-bit target\");\n#define LUX_P(a) ((void *)(uintptr_t)(a))\nstatic inline uint32_t lux_ldw(uint64_t a) { uint32_t v; __builtin_memcpy(&v, LUX_P(a), 4); return v; }\nstatic inline uint64_t lux_ldl(uint64_t a) { uint64_t v; __builtin_memcpy(&v, LUX_P(a), 8); return v; }\nstatic inline float lux_lds(uint64_t a) { float v; __builtin_memcpy(&v, LUX_P(a), 4); return v; }\nstatic inline double lux_ldd(uint64_t a) { double v; __builtin_memcpy(&v, LUX_P(a), 8); return v; }\nstatic inline int8_t lux_ldsb(uint64_t a) { int8_t v; __builtin_memcpy(&v, LUX_P(a), 1); return v; }\nstatic inline uint8_t lux_ldub(uint64_t a) { uint8_t v; __builtin_memcpy(&v, LUX_P(a), 1); return v; }\nstatic inline int16_t lux_ldsh(uint64_t a) { int16_t v; __builtin_memcpy(&v, LUX_P(a), 2); return v; }\nstatic inline uint16_t lux_lduh(uint64_t a) { uint16_t v; __builtin_memcpy(&v, LUX_P(a), 2); return v; }\nstatic inline int32_t lux_ldsw(uint64_t a) { int32_t v; __builtin_memcpy(&v, LUX_P(a), 4); return v; }\nstatic inline uint32_t lux_lduw(uint64_t a) { uint32_t v; __builtin_memcpy(&v, LUX_P(a), 4); return v; }\nstatic inline void lux_stb(uint64_t a, uint32_t v) { uint8_t x = v; __builtin_memcpy(LUX_P(a), &x, 1); }\nstatic inline void lux_sth(uint64_t a, uint32_t v) { uint16_t x = v; __builtin_memcpy(LUX_P(a), &x, 2); }\nstatic inline void lux_stw(uint64_t a, uint32_t v) { __builtin_memcpy(LUX_P(a), &v, 4); }\nstatic inline void lux_stl(uint64_t a, uint64_t v) { __builtin_memcpy(LUX_P(a), &v, 8); }\nstatic inline void lux_sts(uint64_t a, float v) { __builtin_memcpy(LUX_P(a), &v, 4); }\nstatic inline void lux_std(uint64_t a, double v) { __builtin_memcpy(LUX_P(a), &v, 8); }\nstatic inline uint32_t lux_stow(float v) { uint32_t x; __builtin_memcpy(&x, &v, 4); return x; }\nstatic inline float lux_wtos(uint32_t v) { float x; __builtin_memcpy(&x, &v, 4); return x; }\nstatic inline uint64_t lux_dtol(double v) { uint64_t x; __builtin_memcpy(&x, &v, 8); return x; }\nstatic inline double lux_ltod(uint64_t v) { double x; __builtin_memcpy(&x, &v, 8); return x; }\nstatic inline uint32_t lux_divw(uint32_t a, uint32_t b) { int32_t x = a, y = b; if (!y) return UINT32_MAX; if (x == INT32_MIN && y == -1) return a; return (uint32_t)(x / y); }\nstatic inline uint64_t lux_divl(uint64_t a, uint64_t b) { int64_t x = a, y = b; if (!y) return UINT64_MAX; if (x == INT64_MIN && y == -1) return a; return (uint64_t)(x / y); }\nstatic inline uint32_t lux_remw(uint32_t a, uint32_t b) { int32_t x = a, y = b; if (!y) return a; if (y == -1) return 0; return (uint32_t)(x % y); }\nstatic inline uint64_t lux_reml(uint64_t a, uint64_t b) { int64_t x = a, y = b; if (!y) return a; if (y == -1) return 0; return (uint64_t)(x % y); }\nstatic inline uint32_t lux_udivw(uint32_t a, uint32_t b) { return b ? a / b : UINT32_MAX; }\nstatic inline uint64_t lux_udivl(uint64_t a, uint64_t b) { return b ? a / b : UINT64_MAX; }\nstatic inline uint32_t lux_uremw(uint32_t a, uint32_t b) { return b ? a % b : a; }\nstatic inline uint64_t lux_ureml(uint64_t a, uint64_t b) { return b ? a % b : a; }\nstatic inline uint32_t lux_dtosw(double v) { if (v != v) return 0; if (v <= -2147483648.0) return (uint32_t)INT32_MIN; if (v >= 2147483647.0) return INT32_MAX; return (uint32_t)(int32_t)v; }\nstatic inline uint64_t lux_dtosl(double v) { if (v != v) return 0; if (v <= -9223372036854775808.0) return (uint64_t)INT64_MIN; if (v >= 9223372036854775808.0) return INT64_MAX; return (uint64_t)(int64_t)v; }\nstatic inline uint32_t lux_dtouw(double v) { if (!(v > 0)) return 0; if (v >= 4294967295.0) return UINT32_MAX; return (uint32_t)v; }\nstatic inline uint64_t lux_dtoul(double v) { if (!(v > 0)) return 0; if (v >= 18446744073709551616.0) return UINT64_MAX; return (uint64_t)v; }\nstatic inline uint32_t lux_stosw(float v) { return lux_dtosw(v); }\nstatic inline uint64_t lux_stosl(float v) { return lux_dtosl(v); }\nstatic inline uint32_t lux_stouw(float v) { return lux_dtouw(v); }\nstatic inline uint64_t lux_stoul(float v) { return lux_dtoul(v); }\n")
